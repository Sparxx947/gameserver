[Unit]
Description=Spieleserver-Panel (Weboberflaeche)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=exec
User=panel
Group=panel
WorkingDirectory=/opt/panel
ExecStart=/opt/panel/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8099 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
# Haerten, aber nur mit Optionen, die NoNewPrivileges NICHT implizieren.
# ProtectKernelTunables und ProtectControlGroups tun das laut systemd-Doku, und
# mit gesetztem no-new-privileges kann sudo nicht mehr nach root wechseln
# ("The \"no new privileges\" flag is set"). Die App zeigte davon nichts, die
# Uebersicht blieb einfach leer — gefunden am 2026-09-06.
# NoNewPrivileges MUSS aus bleiben, sonst kann sudo nicht nach root wechseln.
# Achtung: LockPersonality, ProtectKernelTunables und ProtectControlGroups
# setzen es IMPLIZIT — sie duerfen hier nicht stehen (gemessen 2026-09-06).
NoNewPrivileges=no
PrivateTmp=yes
# "full" statt "strict": strict macht das GANZE Dateisystem schreibgeschuetzt,
# und dann kann borg seinen Cache nicht anlegen — die Archivliste blieb leer.
ProtectSystem=full
# Kein ProtectHome: panel-aktion liest /root/.borg-passphrase. Der Schutz kommt
# hier aus den Dateirechten (0600 root), nicht aus dem Namensraum — der Nutzer
# "panel" kaeme ohnehin nicht heran.
# ProtectSystem=full macht /etc schreibgeschuetzt — und sudo erbt den
# Namensraum des Dienstes. Jeder Schreibzugriff von panel-aktion auf /etc
# scheiterte deshalb mit "Errno 30 Read-only file system", OBWOHL es als root
# lief. Getroffen hat es genau eine Datei: die Ausschlussliste der Sicherung,
# die bei jeder Installation und Deinstallation fortgeschrieben wird. Die
# Deinstallation ueber die Oberflaeche brach dadurch mitten im Ablauf ab und
# liess Ausschlussblock, Titelbild und Zugangsdaten stehen (belegt am
# 2026-09-07 am Traceback der Necesse-Entfernung vom Vortag).
# NUR diese eine Datei freigeben — nicht /etc als Ganzes: der Spielekatalog
# daneben MUSS schreibgeschuetzt bleiben, er ist die Positivliste, aus der die
# Oberflaeche Images und Volumes bezieht.
# *ProtectSystem=full makes /etc read-only, and sudo inherits the service's
#  namespace — so panel-aktion's writes to /etc failed with Errno 30 even as
#  root. Exactly one file is affected: the backup exclusion list. Uninstalling
#  through the panel aborted mid-way because of it. Only this file is opened up,
#  never /etc as a whole: the catalogue next to it must stay read-only, being
#  the allow-list the panel draws images and volumes from.*
ReadWritePaths=/etc/borg-ausschluss.txt

[Install]
WantedBy=multi-user.target
