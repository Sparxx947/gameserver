# Cloudflare-Token fuer cf-dns. Nach /etc/cloudflare-gameserver.conf kopieren,
# Wert einsetzen, chmod 600.
#
# Berechtigung im Cloudflare-Dashboard:
#   Zone / DNS / Bearbeiten
#   Zonenressource: NUR die eigene Zone
#
# NIE der globale API-Schluessel: der darf alles im Konto, auch Zonen loeschen
# und Abrechnungsdaten lesen. Ein Token mit diesem Zuschnitt kann im
# schlimmsten Fall DNS-Eintraege einer Zone aendern - mehr nicht.
#
# *Scoped token for cf-dns: Zone / DNS / Edit, restricted to your own zone.
#  Never the global API key, which can do anything in the account. At worst this
#  token can change DNS records in one zone.*
CF_TOKEN=hier-den-token-einsetzen
