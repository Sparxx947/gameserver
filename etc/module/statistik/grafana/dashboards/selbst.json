    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Wozu diese Seite",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Ein Netz, das sich heil meldet und nichts fängt, ist schlimmer als keins. Hier steht, ob die Messung selbst noch arbeitet: welche Ziele antworten, wann der Sammler zuletzt lief, wie viel die Datenbank hält.\n\n*A safety net that reports itself intact while catching nothing is worse than none: this page shows whether the measurement itself still works.*"
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Ziele",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      }
    },
    {
      "id": 3,
      "title": "Antworten alle Ziele?",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "platzwart-prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "platzwart-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(up)",
          "legendFormat": "antworten",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "platzwart-prometheus"
          },
          "editorMode": "code",
          "expr": "count(up)",
          "legendFormat": "insgesamt",
          "refId": "B",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
