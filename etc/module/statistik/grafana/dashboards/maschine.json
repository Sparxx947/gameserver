{
  "uid": "platzwart-maschine",
  "title": "Maschine",
  "description": "Last, Speicher, Platte und Netz der Maschine. Quelle: node_exporter.",
  "tags": [
    "platzwart"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Prozessorlast (Durchschnitt 1 min)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "platzwart-prometheus"
      },
      "description": "Ueber der Kernzahl heisst: es warten Prozesse.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "platzwart-prometheus"
          },
          "editorMode": "code",
          "expr": "node_load1",
          "legendFormat": "Last",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
