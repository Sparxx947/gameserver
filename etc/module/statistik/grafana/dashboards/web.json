    {
      "id": 13,
      "title": "Laeuft ab in",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "platzwart-prometheus"
      },
      "description": "Caddy erneuert bei 30 Tagen Restlaufzeit. Faellt der Wert darunter und bleibt dort, erneuert es nicht mehr - und das faellt sonst erst auf, wenn das Zertifikat abgelaufen ist.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 14
              },
              {
                "color": "green",
                "value": 21
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "platzwart-prometheus"
          },
          "editorMode": "code",
          "expr": "(min(probe_ssl_earliest_cert_expiry) - time()) / 86400",
          "legendFormat": "Tage",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
