# Spieleserver-Panel. Caddy holt und erneuert das Zertifikat selbst.
#
# NUR HTTP/1.1: Das Webterminal braucht einen echten WebSocket-Upgrade.
# Ueber HTTP/2 gab Caddy darauf 404 zurueck (gemessen 2026-09-06), der Browser
# meldete "websocket connection closed with code: 1006"; ueber HTTP/1.1 kommt
# sauber "101 Switching Protocols". Fuer ein Panel mit zwei Nutzern ist der
# Verzicht auf h2/h3 belanglos.
{
	servers {
		protocols h1
	}
}

@@PANEL_DOMAIN@@ {
	encode zstd gzip

	# --- Webterminal -----------------------------------------------------
	# ttyd selbst hat KEINE eigene Anmeldung. Vor jedem Aufruf fragt Caddy
	# deshalb beim Panel nach (/auth-check): nur eine gueltige ADMIN-Sitzung
	# bekommt 204 zurueck, alles andere 401. So haengt das Terminal an
	# derselben Anmeldung wie der Rest der Oberflaeche.
	handle /terminal* {
		forward_auth 127.0.0.1:8099 {
			uri /auth-check
			copy_headers Cookie
			# Die Upgrade-Kopfzeilen duerfen NICHT in die Auth-Anfrage:
			# uvicorn sieht sonst einen WebSocket-Versuch auf einer normalen
			# HTTP-Route und antwortet 403 — der Terminal-Handshake scheiterte
			# dadurch, obwohl die Sitzung gueltig war (gemessen 2026-09-06).
			header_up -Upgrade
			header_up -Connection
			header_up -Sec-Websocket-Key
			header_up -Sec-Websocket-Version
			header_up -Sec-Websocket-Protocol
			header_up -Sec-Websocket-Extensions
		}
		# Eigene, notwendigerweise lockerere Kopfzeilen: ein Terminal braucht
		# JavaScript und WebSockets. Die strenge CSP des uebrigen Panels
		# ("default-src 'none'") wuerde ttyd komplett blockieren.
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss://@@PANEL_DOMAIN@@; base-uri 'none'; frame-ancestors 'none'"
			Cache-Control "no-store"
			-Server
		}
		reverse_proxy 127.0.0.1:7681
	}

	# --- Anmeldung und Konto: die einzigen Seiten mit JavaScript ----------
	#
	# WebAuthn (Passkeys) ist ausschliesslich ueber navigator.credentials
	# erreichbar - es gibt keinen Weg ohne JavaScript, und es wird auch keinen
	# geben: der W3C-Antrag dafuer (w3c/webauthn#1255) wurde im Februar 2025
	# ohne Ersatz geschlossen.
	#
	# Deshalb hier, und NUR hier, "script-src 'self'" statt "default-src 'none'".
	# Drei Dinge halten die Lockerung klein:
	#   * Sie gilt fuer drei Pfade, nicht fuer das Panel.
	#   * KEIN 'unsafe-inline' und kein 'unsafe-eval'. Das Skript liegt als
	#     eigene Datei unter /passkey.js; inline stuende es nicht.
	#   * 'self' laesst nur Dateien dieser Herkunft zu. Zusammen mit dem
	#     nosniff-Header oben kann kein ausgeliefertes Titelbild als Skript
	#     durchgehen.
	# connect-src braucht es fuer die fetch-Aufrufe an die eigenen Endpunkte.
	#
	# *WebAuthn is reachable only through navigator.credentials; the W3C request
	#  for a JS-free path was closed in February 2025 with no replacement. Hence
	#  script-src 'self' here and nowhere else - three paths, no unsafe-inline,
	#  no unsafe-eval, the script in its own file.*
	@passkey path /login /konto /passkey.js
	handle @passkey {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src 'self'; style-src 'unsafe-inline'; img-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
			Cache-Control "no-store, no-cache, must-revalidate"
			-Server
		}
		reverse_proxy 127.0.0.1:8099
	}

	# --- Panel -----------------------------------------------------------
	handle {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			# ACHTUNG: CSP-Schluesselwoerter MUESSEN einfach gequotet sein.
			# Ohne die Anfuehrungszeichen liest der Browser 'self' und 'none'
			# als HOSTNAMEN — am 2026-09-06 blockierte form-action dadurch das
			# Login-Formular, und im Protokoll kam nicht einmal ein POST an.
			Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
			# Nichts zwischenspeichern: die Seite zeigt Zugangsdaten, und ein
			# gecachter Stand haelt auch alte Sicherheitskopfzeilen am Leben.
			Cache-Control "no-store, no-cache, must-revalidate"
			-Server
		}
		reverse_proxy 127.0.0.1:8099
	}
}
