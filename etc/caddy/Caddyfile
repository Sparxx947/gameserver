# Spieleserver-Panel. Caddy holt und erneuert das Zertifikat selbst.
#
# NUR HTTP/1.1: Das Webterminal braucht einen echten WebSocket-Upgrade.
# Ueber HTTP/2 gab Caddy darauf 404 zurueck (gemessen 2026-09-06), der Browser
# meldete "websocket connection closed with code: 1006"; ueber HTTP/1.1 kommt
# sauber "101 Switching Protocols". Fuer ein Panel mit zwei Nutzern ist der
# Verzicht auf h2/h3 belanglos.
{
	servers {
		protocols h1
		# Ohne diese Zeile zaehlt Caddy keine Anfragen: Die
		# Verwaltungsschnittstelle liefert dann nur den Zustand des letzten
		# Neuladens und die Gesundheit der Upstreams - gemessen vier
		# Metrikfamilien, keine davon ueber Anfragen (#272). Der Preis sind
		# ein paar Zaehler je Handler; bei zwei Benutzern ist das nichts.
		# *Without this Caddy counts no requests: the admin endpoint then only
		#  reports the last reload and upstream health - measured four metric
		#  families, none about requests.*
		metrics
	}

	# Wie das Zertifikat geholt wird, steht NICHT hier, sondern in einer Datei,
	# die Stufe 40 aus ZERTIFIKAT_WEG erzeugt:
	#
	#   http-01   die Datei ist leer - Caddy macht, was es von sich aus tut
	#   dns-01    die Datei traegt "acme_dns <anbieter> {env.TOKEN}"
	#
	# Erzeugt und nicht eingesetzt, weil ihr Inhalt von einem Wert abhaengt und
	# nicht aus einer Vorlage kommt - wie /etc/gameserver-version. Fehlt sie,
	# bricht "caddy validate" ab ("File to import not found") und Stufe 40 haelt
	# an; ein stiller Rueckfall auf http-01 waere schlimmer, denn er faellt erst
	# auf, wenn das Zertifikat in 60 Tagen nicht erneuert wird.
	#
	# Der Token steht ABSICHTLICH nicht in dieser Datei: die Caddyfile liegt mit
	# 0644 auf der Maschine. {env.TOKEN} kommt aus /etc/dns-gameserver.conf
	# (0600 root), das die systemd-Einheit als EnvironmentFile liest - dieselbe
	# Datei, die dns-pflegen benutzt, kein zweites Exemplar des Geheimnisses.
	#
	# *How the certificate is obtained lives in a file stage 40 generates from
	#  ZERTIFIKAT_WEG: empty for http-01, an acme_dns line for dns-01. Generated
	#  rather than installed, because its content depends on a value. A missing
	#  file aborts validation on purpose - silently falling back to http-01
	#  would surface only when renewal fails 60 days later. The token stays out
	#  of this 0644 file and arrives through the unit's EnvironmentFile, from
	#  the same 0600 file dns-pflegen uses.*
	import /etc/caddy/zertifikat.conf
}

@@PANEL_DOMAIN@@ {
	encode zstd gzip

	# --- Webterminal -----------------------------------------------------
	# ttyd selbst hat KEINE eigene Anmeldung. Vor jedem Aufruf fragt Caddy
	# deshalb beim Panel nach (/auth-check): nur eine gueltige ADMIN-Sitzung
	# bekommt 204 zurueck, alles andere 401. So haengt das Terminal an
	# derselben Anmeldung wie der Rest der Oberflaeche.
	handle /terminal* {
		forward_auth 127.0.0.1:8099 {
			uri /auth-check
			copy_headers Cookie
			# Die Upgrade-Kopfzeilen duerfen NICHT in die Auth-Anfrage:
			# uvicorn sieht sonst einen WebSocket-Versuch auf einer normalen
			# HTTP-Route und antwortet 403 — der Terminal-Handshake scheiterte
			# dadurch, obwohl die Sitzung gueltig war (gemessen 2026-09-06).
			header_up -Upgrade
			header_up -Connection
			header_up -Sec-Websocket-Key
			header_up -Sec-Websocket-Version
			header_up -Sec-Websocket-Protocol
			header_up -Sec-Websocket-Extensions
		}
		# Eigene, notwendigerweise lockerere Kopfzeilen: ein Terminal braucht
		# JavaScript und WebSockets. Die strenge CSP des uebrigen Panels
		# ("default-src 'none'") wuerde ttyd komplett blockieren.
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss://@@PANEL_DOMAIN@@; base-uri 'none'; frame-ancestors 'none'"
			Cache-Control "no-store"
			-Server
		}
		reverse_proxy 127.0.0.1:7681
	}

	# --- Oeffentliche Statusseite ----------------------------------------
	# Steht VOR den anderen handle-Bloecken und liefert eine fertige Datei aus.
	# Sie erreicht das Panel nie: kein reverse_proxy, kein forward_auth, keine
	# Sitzung. Was hier ausgeliefert wird, hat platzwart-status geschrieben -
	# eine oeffentliche Route IM Panelprozess haette sich Vorlagen und
	# Kopfzeilen mit der Verwaltung geteilt, und ein vergessener Schalter in
	# einer gemeinsamen Darstellungsfunktion gibt dann alles preis.
	#
	# Die Kopfzeilen sind strenger als beim Panel, nicht lockerer: Die Seite
	# enthaelt kein JavaScript und kein einziges Bild, deshalb bleibt
	# default-src 'none' und nur style-src wird geoeffnet.
	#
	# Cache-Control mit 60 s: Die Seite wird jede Minute neu geschrieben,
	# laenger zwischenzuspeichern hiesse einen alten Stand als aktuellen
	# auszuliefern. "no-store" waere hier falsch - es gibt nichts zu schuetzen,
	# und ein bisschen Zwischenspeicher haelt Neugierige von der Platte fern.
	#
	# *Serves a finished file and never reaches the panel: no reverse_proxy, no
	#  forward_auth, no session. Headers are stricter than the panel's, not
	#  looser - the page carries no JavaScript and no images.*
	handle /status* {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			# "img-src data:" laesst KEINEN Wirt zu, nur was die Seite selbst
			# mitbringt - das Tab-Symbol steckt als data:-URI im Kopf. Ohne
			# diese eine Erlaubnis fehlt es stillschweigend: Der Browser faellt
			# auf /favicon.ico zurueck, das Panel liefert es mit 200 aus, und
			# die CSP dieser Seite verwirft es - ohne sichtbaren Fehler.
			# *No host, only what the page carries itself. Without it the icon
			#  is silently absent: the fallback is served with 200 and then
			#  discarded by this page's own policy.*
			Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			Cache-Control "public, max-age=60"
			-Server
		}
		root * /var/lib/platzwart-status
		# Der Praefix MUSS weg. Ohne strip_prefix sucht Caddy die Datei unter
		# <root>/status und liefert 404 - dabei sieht die Route korrekt aus und
		# die Datei liegt richtig da (gemessen 2026-09-10).
		# *Without strip_prefix Caddy looks for <root>/status and returns 404,
		#  while the route looks correct and the file is in place.*
		uri strip_prefix /status
		# Kein "browse": ein Verzeichnislisting waere genau das, was diese Route
		# nicht sein soll.
		file_server
	}

	# --- Zusatzmodule (#261) ---------------------------------------------
	# Erzeugt von modul-verwalten: je installiertem Modul ein handle-Block mit
	# forward_auth gegen das Panel. Ohne Modul ist die Datei leer.
	#
	# Sie steht VOR dem Auffangblock, denn der wuerde jeden Pfad schlucken -
	# handle-Bloecke greifen in der Reihenfolge, in der sie hier stehen.
	# Und sie wird unbedingt eingebunden: Fehlt sie, bricht "caddy validate"
	# ab, statt eine Route stillschweigend zu verlieren.
	#
	# *Generated by modul-verwalten: one handle block per installed module,
	#  empty without modules. It stands before the catch-all, which would
	#  otherwise swallow every path, and is imported unconditionally so a
	#  missing file aborts validation instead of silently dropping a route.*
	import /etc/caddy/module.conf

	# --- Anmeldung und Konto: die einzigen Seiten mit JavaScript ----------
	#
	# WebAuthn (Passkeys) ist ausschliesslich ueber navigator.credentials
	# erreichbar - es gibt keinen Weg ohne JavaScript, und es wird auch keinen
	# geben: der W3C-Antrag dafuer (w3c/webauthn#1255) wurde im Februar 2025
	# ohne Ersatz geschlossen.
	#
	# Deshalb hier, und NUR hier, "script-src 'self'" statt "default-src 'none'".
	# Drei Dinge halten die Lockerung klein:
	#   * Sie gilt fuer drei Pfade, nicht fuer das Panel.
	#   * KEIN 'unsafe-inline' und kein 'unsafe-eval'. Das Skript liegt als
	#     eigene Datei unter /passkey.js; inline stuende es nicht.
	#   * 'self' laesst nur Dateien dieser Herkunft zu. Zusammen mit dem
	#     nosniff-Header oben kann kein ausgeliefertes Titelbild als Skript
	#     durchgehen.
	# connect-src braucht es fuer die fetch-Aufrufe an die eigenen Endpunkte.
	#
	# *WebAuthn is reachable only through navigator.credentials; the W3C request
	#  for a JS-free path was closed in February 2025 with no replacement. Hence
	#  script-src 'self' here and nowhere else - three paths, no unsafe-inline,
	#  no unsafe-eval, the script in its own file.*
	@passkey path /login /konto /passkey.js
	handle @passkey {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src 'self'; style-src 'unsafe-inline'; img-src 'self'; manifest-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
			Cache-Control "no-store, no-cache, must-revalidate"
			-Server
		}
		reverse_proxy 127.0.0.1:8099
	}

	# --- Panel -----------------------------------------------------------
	handle {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			# manifest-src: Ohne diese Erlaubnis laedt der Browser das
			# Manifest nicht, und die Oberflaeche laesst sich nicht als App
			# installieren - ohne sichtbaren Fehler, das Symbol bleibt
			# einfach aus. default-src 'none' deckt manifest-src NICHT ab,
			# es ist eine eigene Direktive.
			# *Without it the manifest is not fetched and the page cannot be
			#  installed, with no visible error.*
			# ACHTUNG: CSP-Schluesselwoerter MUESSEN einfach gequotet sein.
			# Ohne die Anfuehrungszeichen liest der Browser 'self' und 'none'
			# als HOSTNAMEN — am 2026-09-06 blockierte form-action dadurch das
			# Login-Formular, und im Protokoll kam nicht einmal ein POST an.
			Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; manifest-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
			# Nichts zwischenspeichern: die Seite zeigt Zugangsdaten, und ein
			# gecachter Stand haelt auch alte Sicherheitskopfzeilen am Leben.
			Cache-Control "no-store, no-cache, must-revalidate"
			-Server
		}
		reverse_proxy 127.0.0.1:8099
	}
}
