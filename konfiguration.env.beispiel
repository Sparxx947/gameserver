# =====================================================================
#  gameserver — Standortdaten / site-specific values
# =====================================================================
#  Diese Datei nach "konfiguration.env" kopieren und ausfuellen. Sie ist
#  in .gitignore ausgenommen und darf NIE eingecheckt werden.
#  install/einrichten.sh liest sie und ersetzt damit alle @@PLATZHALTER@@
#  in den Dateien dieses Repositoriums.
#
#  *Copy this file to "konfiguration.env" and fill it in. It is listed in
#  .gitignore and must never be committed. install/einrichten.sh reads it
#  and substitutes every @@PLACEHOLDER@@ found in this repository.*
# =====================================================================

# --- Namen und Adressen ------------------------------------------------
# DNS-Zone, in der die Spielserver-Namen angelegt werden.
#
# WELCHER Anbieter die Zone haelt, steht NICHT hier, sondern zusammen mit dem
# Token in /etc/dns-gameserver.conf (ANBIETER=cloudflare). Beides gehoert
# zusammen: ein Token hat immer genau die Form, die ein Anbieter versteht, und
# an zwei Orten gefuehrt liefen die Angaben frueher oder spaeter auseinander.
# Umgesetzt ist derzeit: cloudflare.
#
# *Which provider holds the zone is not configured here but next to the token in
#  /etc/dns-gameserver.conf, because token and provider belong together.*
DNS_ZONE=beispiel.de

# Der EINE A-Eintrag, auf den alle Spiel-CNAMEs zeigen. Zieht der Server um,
# ist genau dieser Eintrag zu aendern — kein einziger CNAME. Er MUSS innerhalb
# von DNS_ZONE liegen, sonst kann ihn dns-pflegen nicht pflegen.
# *The single A record every game CNAME points at. One record to change on a
#  move. It must lie inside DNS_ZONE or dns-pflegen cannot maintain it.*
DNS_ZIEL=gs.beispiel.de

# Voller Hostname des Panels. Caddy holt dafuer selbst ein Zertifikat; der Name
# MUSS oeffentlich auf den Server zeigen, sonst scheitert ACME. Am einfachsten
# als CNAME auf DNS_ZIEL — dann folgt er jedem Adresswechsel von allein. Steht
# er als eigener A-Eintrag in DNS_ZONE, zieht ihn dns-pflegen bei SERVER_IPV4=dynamic
# mit nach; ausserhalb der Zone bleibt er Handarbeit.
# *Panel hostname; must resolve publicly to the server or ACME fails. Simplest
#  as a CNAME to DNS_ZIEL. As an A record inside DNS_ZONE it is carried along in
#  dynamic mode; outside the zone it stays manual.*
PANEL_DOMAIN=panel.beispiel.de

# Oeffentliche IPv4 des Servers — ODER das Wort "dynamic".
#
#   203.0.113.10   feste Adresse. Der A-Eintrag DNS_ZIEL wird von Hand gepflegt,
#                  genau wie bisher.
#   dynamic        wechselnde Adresse. Der Server misst seine oeffentliche IPv4
#                  alle fuenf Minuten (dns-ziel.timer) und traegt sie selbst als
#                  A-Eintrag DNS_ZIEL bei Cloudflare ein. Damit folgen die
#                  Spiel-CNAMEs und das Zertifikat des Panels von allein.
#
# Ein DNS-Name gehoert hier NICHT hin, auch kein DDNS-Name: aus diesem Wert
# entsteht kein Eintrag, die Adresse traegt allein DNS_ZIEL. Frueher wurde ein
# Name hier klaglos angenommen und wirkte nirgends; heute bricht die Einrichtung
# mit einer Meldung ab.
#
# *Public IPv4 — or the word "dynamic". Fixed: the DNS_ZIEL A record stays
#  hand-maintained. Dynamic: the server measures its public IPv4 every five
#  minutes and writes the A record itself, so game CNAMEs and the panel
#  certificate follow along. A hostname does not belong here — not even a DDNS
#  name: no record is derived from this value. It used to be accepted silently
#  and did nothing; setup now aborts with a message.*
SERVER_IPV4=203.0.113.10

# Erscheint als Server-/Weltname in den Spielen und im Panel.
# *Shown as the server/world name in games and in the panel.*
WELT_NAME=meinserver

# --- Zugang ------------------------------------------------------------
# Login-Benutzer der Maschine. Bekommt das Webterminal und sudo.
# *Machine login user. Owns the web terminal and has sudo.*
ADMIN_USER=admin

# Netz, aus dem SSH erlaubt ist, und das fail2ban nie sperrt. CIDR.
# Eine feste Heim-IP eintragen. Wer keine hat: 0.0.0.0/0 — dann traegt
# der Schutz allein die Schluesselanmeldung (Passwoerter sind ohnehin aus).
# *Network allowed to reach SSH and never banned by fail2ban. CIDR.*
ADMIN_NETZ=203.0.113.0/30

# Einzel-IP fuer die ufw-Regel auf Port 22 (aus ADMIN_NETZ).
# *Single IP for the ufw rule on port 22 (from ADMIN_NETZ).*
ADMIN_IP=203.0.113.1

# --- Sicherung ---------------------------------------------------------
# Borg-Repository. Empfohlen ueber ein privates Netz (hier: Tailscale),
# damit der Sicherungsserver keinen offenen Port ins Internet braucht.
#
# ODER das Wort "aus": dann wird gar nicht gesichert. Kein borg, keine
# Passphrase, keine Timer, keine Archive in der Oberflaeche — und beim Loeschen
# eines Spielservers auch keine letzte Sicherung. Sinnvoll, solange es noch
# kein Sicherungsziel gibt; die Oberflaeche sagt auf der Uebersicht deutlich,
# dass nichts gesichert wird. Einschalten ist spaeter diese eine Zeile plus
# "install/50-sicherung.sh".
#
# *Borg repository, recommended over a private network (here: Tailscale). Or the
#  word "aus" (off): no borg, no passphrase, no timers, no archives in the
#  panel, and no final backup when a game server is deleted. Useful while there
#  is no backup target yet; the panel states plainly that nothing is backed up.
#  Switching on later is this one line plus a re-run of stage 50.*
BORG_REPO=ssh://borg@100.100.100.100/backup/gameserver/gameserver.borg

# Tailscale-Adresse des Sicherungsservers (nur fuer die Dokumentation/Tests).
# Ohne Sicherung (BORG_REPO=aus) hier ebenfalls "aus" eintragen — leer darf
# keine Variable sein, sonst bricht die Einrichtung ab.
# *Tailscale address of the backup host (documentation/tests only). With
#  BORG_REPO=aus put "aus" here as well: no variable may be empty.*
BORG_TAILSCALE_IP=100.100.100.100

# --- Nur fuer Kommentare in dns-pflegen -------------------------------------
# Adresse, auf die ein etwaiger Wildcard-Eintrag der Zone zeigt. Steht dort
# ein Wildcard, beantwortet er JEDEN erfundenen Namen — Existenzpruefungen
# per dig sind dann wertlos. Ohne Wildcard: leer lassen.
# *Address a possible wildcard record points at. With a wildcard present,
#  dig-based existence checks are worthless.*
FREMD_IPV4=198.51.100.10
