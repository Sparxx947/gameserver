# =====================================================================
#  gameserver — Standortdaten / site-specific values
# =====================================================================
#  Diese Datei nach "konfiguration.env" kopieren und ausfuellen. Sie ist
#  in .gitignore ausgenommen und darf NIE eingecheckt werden.
#  install/einrichten.sh liest sie und ersetzt damit alle @@PLATZHALTER@@
#  in den Dateien dieses Repositoriums.
#
#  *Copy this file to "konfiguration.env" and fill it in. It is listed in
#  .gitignore and must never be committed. install/einrichten.sh reads it
#  and substitutes every @@PLACEHOLDER@@ found in this repository.*
# =====================================================================

# --- Namen und Adressen ------------------------------------------------
# DNS-Zone, in der die Spielserver-Namen angelegt werden.
#
# WELCHER Anbieter die Zone haelt, steht NICHT hier, sondern zusammen mit dem
# Token in /etc/dns-gameserver.conf (ANBIETER=cloudflare). Beides gehoert
# zusammen: ein Token hat immer genau die Form, die ein Anbieter versteht, und
# an zwei Orten gefuehrt liefen die Angaben frueher oder spaeter auseinander.
# Umgesetzt sind: cloudflare, hetzner (letzterer noch ungeprueft gegen eine
# echte Zone). Weitere: docs/06-netz-dns-firewall.md.
#
# *Which provider holds the zone is not configured here but next to the token in
#  /etc/dns-gameserver.conf, because token and provider belong together.*
DNS_ZONE=beispiel.de

# Der EINE A-Eintrag, auf den alle Spiel-CNAMEs zeigen. Zieht der Server um,
# ist genau dieser Eintrag zu aendern — kein einziger CNAME. Er MUSS innerhalb
# von DNS_ZONE liegen, sonst kann ihn dns-pflegen nicht pflegen.
# *The single A record every game CNAME points at. One record to change on a
#  move. It must lie inside DNS_ZONE or dns-pflegen cannot maintain it.*
DNS_ZIEL=gs.beispiel.de

# Voller Hostname des Panels. Caddy holt dafuer selbst ein Zertifikat; der Name
# MUSS oeffentlich auf den Server zeigen, sonst scheitert ACME. Am einfachsten
# als CNAME auf DNS_ZIEL — dann folgt er jedem Adresswechsel von allein. Steht
# er als eigener A-Eintrag in DNS_ZONE, zieht ihn dns-pflegen bei SERVER_IPV4=dynamic
# mit nach; ausserhalb der Zone bleibt er Handarbeit.
# *Panel hostname; must resolve publicly to the server or ACME fails. Simplest
#  as a CNAME to DNS_ZIEL. As an A record inside DNS_ZONE it is carried along in
#  dynamic mode; outside the zone it stays manual.*
PANEL_DOMAIN=panel.beispiel.de

# Oeffentliche IPv4 des Servers — ODER das Wort "dynamic".
#
#   203.0.113.10   feste Adresse. Der A-Eintrag DNS_ZIEL wird von Hand gepflegt,
#                  genau wie bisher.
#   dynamic        wechselnde Adresse. Der Server misst seine oeffentliche IPv4
#                  alle fuenf Minuten (dns-ziel.timer) und traegt sie selbst als
#                  A-Eintrag DNS_ZIEL bei Cloudflare ein. Damit folgen die
#                  Spiel-CNAMEs und das Zertifikat des Panels von allein.
#
# Ein DNS-Name gehoert hier NICHT hin, auch kein DDNS-Name: aus diesem Wert
# entsteht kein Eintrag, die Adresse traegt allein DNS_ZIEL. Frueher wurde ein
# Name hier klaglos angenommen und wirkte nirgends; heute bricht die Einrichtung
# mit einer Meldung ab.
#
# *Public IPv4 — or the word "dynamic". Fixed: the DNS_ZIEL A record stays
#  hand-maintained. Dynamic: the server measures its public IPv4 every five
#  minutes and writes the A record itself, so game CNAMEs and the panel
#  certificate follow along. A hostname does not belong here — not even a DDNS
#  name: no record is derived from this value. It used to be accepted silently
#  and did nothing; setup now aborts with a message.*
SERVER_IPV4=203.0.113.10

# Erscheint als Server-/Weltname in den Spielen und im Panel.
# *Shown as the server/world name in games and in the panel.*
WELT_NAME=meinserver

# --- Zugang ------------------------------------------------------------
# Login-Benutzer der Maschine. Bekommt das Webterminal und sudo.
# *Machine login user. Owns the web terminal and has sudo.*
# Zeitzone der Maschine. Zonenname, kein fester Versatz - "Europe/Berlin"
# schaltet Sommer- und Winterzeit selbst um. systemd rechnet OnCalendar in
# Ortszeit: Steht hier nichts und die Maschine auf UTC, feuert jeder Timer
# verschoben. Ohne Zeile gilt Europe/Berlin.
# *Zone name, never a fixed offset; systemd computes OnCalendar in local time.*
ZEITZONE=Europe/Berlin

ADMIN_USER=admin

# Netz, das fail2ban NIE sperrt (ignoreip). CIDR. Mit SSH hat dieser Wert
# nichts zu tun - welche Adressen SSH erreichen, bestimmt ADMIN_IP darunter.
# Die eigene feste Heimadresse bzw. ihr Netz eintragen. Wer keine feste hat,
# traegt hier NICHT 0.0.0.0/0 ein - das hiesse, fail2ban sperrt niemanden
# mehr -, sondern etwas Enges wie 127.0.0.1/32; der Rueckweg nach einer
# eigenen Sperre ist dann das Tailnet (#259).
# *Network fail2ban NEVER bans (ignoreip). CIDR. Unrelated to who may reach SSH -
#  that is ADMIN_IP below. Put your static home address or network here. Without
#  one, do NOT use 0.0.0.0/0 (fail2ban would ban nobody) but something narrow
#  like 127.0.0.1/32; the way back after banning yourself is the tailnet.*
ADMIN_NETZ=203.0.113.0/30

# Von wo SSH ueberhaupt ankommt: die ufw-Regel auf Port 22. Eine Adresse oder
# ein Netz (CIDR). Ohne feste Heimadresse 0.0.0.0/0 - dann traegt die
# Anmeldung selbst den Schutz, und wie stark die ist, entscheidet
# SSH_PASSWORT_AUTH darunter.
# *Where SSH is accepted from at all: the ufw rule on port 22. An address or a
#  network (CIDR). Without a static home address 0.0.0.0/0 - then the login itself
#  carries the protection, and SSH_PASSWORT_AUTH below decides how strong it is.*
ADMIN_IP=203.0.113.1

# --- SSH ---------------------------------------------------------------
# Beide Werte gehen UNVERAENDERT in /etc/ssh/sshd_config.d/99-gameserver.conf.
# Es sind deshalb die Woerter, die sshd selbst kennt, und keine eigenen.
#
# SSH_PASSWORT_AUTH: Anmeldung mit Passwort.
#
#   no    Vorgabe und Empfehlung. Nur Schluessel. Auf einer oeffentlichen IPv4
#         zeigen die Protokolle binnen Stunden die ersten Versuche.
#   yes   Passwoerter erlaubt. Davor stehen dann nur noch die ufw-Regel auf
#         ADMIN_IP und fail2ban (drei Versuche in einer Stunde, 48 h Sperre).
#         Wer das setzt, sollte ADMIN_IP eng halten - "0.0.0.0/0" und
#         "yes" zusammen ist ein Server, der offen im Netz steht.
#
# Der Wert gilt fuer PasswordAuthentication UND KbdInteractiveAuthentication.
# Getrennt gefuehrt sind sie die bekannteste Falle dieser Datei: Nur die erste
# auf "no" zu stellen schaltet die Passwortanmeldung nicht ab, sie laeuft ueber
# PAM weiter - waehrend die Konfiguration aussieht, als waere zu.
#
# *Both values go into sshd's config verbatim, so they use sshd's own
#  vocabulary. "no" is the default and the recommendation; with "yes" only the
#  ufw rule on ADMIN_IP and fail2ban remain. The value covers
#  KbdInteractiveAuthentication too: setting only PasswordAuthentication to
#  "no" leaves password login working through PAM.*
SSH_PASSWORT_AUTH=no

# SSH_ROOT_LOGIN: was PermitRootLogin bekommt.
#
#   prohibit-password      Vorgabe. root nur mit Schluessel.
#   no                     root gar nicht. Der Weg nach root geht dann
#                          ausschliesslich ueber ADMIN_USER und sudo - vorher
#                          pruefen, dass dessen Schluessel liegt und sudo geht.
#   forced-commands-only   nur Schluessel mit command="..." - fuer Sicherungen
#                          und aehnliche Automatik.
#   yes                    root auch mit Passwort. Wirkt NUR zusammen mit
#                          SSH_PASSWORT_AUTH=yes; allein gesetzt bricht die
#                          Einrichtung ab, weil "yes" dann genau dasselbe
#                          bedeutet wie prohibit-password und nur so aussaehe,
#                          als waere etwas erlaubt.
#
# *What PermitRootLogin gets. Default: key-only root. "no" routes every path to
#  root through ADMIN_USER and sudo - check that key and sudo work first. "yes"
#  only has an effect together with SSH_PASSWORT_AUTH=yes; on its own the
#  installation aborts, because it would then mean exactly prohibit-password
#  while looking as if something had been allowed.*
SSH_ROOT_LOGIN=prohibit-password

# --- Zertifikat --------------------------------------------------------
# Wie Caddy das Zertifikat fuer PANEL_DOMAIN holt. Der Wert ist der Name der
# ACME-Pruefung - dasselbe Wort, das im Caddy-Protokoll und bei Let's Encrypt
# steht.
#
#   http-01   Vorgabe. Let's Encrypt ruft die Maschine unter PANEL_DOMAIN auf
#             Port 80 auf. Setzt voraus, dass Port 80 aus dem Internet HIER
#             ankommt - eine Portweiterleitung zeigt immer auf genau EINEN
#             Rechner, und hinter CGNAT oder DS-Lite gibt es gar nichts
#             weiterzuleiten.
#
#   dns-01    Caddy legt einen TXT-Eintrag in der Zone an und raeumt ihn wieder
#             weg. Es wird KEIN eingehender Port gebraucht, auch nicht 443.
#             Voraussetzungen:
#               * /etc/dns-gameserver.conf mit ANBIETER= und TOKEN= (dieselbe
#                 Datei, die dns-pflegen benutzt - kein zweites Exemplar)
#               * ANBIETER=cloudflare; andere sind ungeprueft und werden
#                 abgelehnt statt geraten
#               * Stufe 40 baut dafuer mit xcaddy einen Caddy mit dem
#                 DNS-Modul. Das dauert beim ersten Mal einige Minuten und
#                 braucht Go auf der Maschine.
#
# Port 80 kann trotzdem offen bleiben; bei dns-01 wird er nur nicht mehr
# gebraucht, um an das Zertifikat zu kommen.
#
# *Which ACME challenge Caddy uses. http-01 (default) needs port 80 to arrive
#  HERE from the internet - a forward points at exactly one host, and behind
#  CGNAT there is nothing to forward. dns-01 writes a TXT record instead and
#  needs no inbound port at all, but requires the DNS token (the same file
#  dns-pflegen uses), a provider that has actually been tested, and a Caddy
#  built with the DNS module - which stage 40 does with xcaddy.*
ZERTIFIKAT_WEG=http-01

# --- Sicherung ---------------------------------------------------------
# Borg-Repository. Empfohlen ueber ein privates Netz (hier: Tailscale),
# damit der Sicherungsserver keinen offenen Port ins Internet braucht.
#
# ODER das Wort "aus": dann wird gar nicht gesichert. Kein borg, keine
# Passphrase, keine Timer, keine Archive in der Oberflaeche — und beim Loeschen
# eines Spielservers auch keine letzte Sicherung. Sinnvoll, solange es noch
# kein Sicherungsziel gibt; die Oberflaeche sagt auf der Uebersicht deutlich,
# dass nichts gesichert wird. Einschalten ist spaeter diese eine Zeile plus
# "install/50-sicherung.sh".
#
# *Borg repository, recommended over a private network (here: Tailscale). Or the
#  word "aus" (off): no borg, no passphrase, no timers, no archives in the
#  panel, and no final backup when a game server is deleted. Useful while there
#  is no backup target yet; the panel states plainly that nothing is backed up.
#  Switching on later is this one line plus a re-run of stage 50.*
#
# Die Adresse des Sicherungsservers steht in DIESER Zeile und nirgends sonst.
# Es gab dafuer frueher eine zweite Variable (BORG_TAILSCALE_IP); sie trug
# dieselbe Adresse ein zweites Mal, landete in keiner einzigen Datei und musste
# bei BORG_REPO=aus ebenfalls "aus" tragen - zwei Werte fuer eine Frage, die
# sich widersprechen koennen. Genau dagegen argumentiert E22.
# *The backup host's address lives in this line and nowhere else. A second
#  variable used to carry it again, reached no file at all, and had to be set to
#  "aus" alongside - two values for one question, which is what E22 argues
#  against.*
BORG_REPO=ssh://borg@100.100.100.100/backup/gameserver/gameserver.borg

# --- Nur fuer Kommentare in dns-pflegen -------------------------------------
# Adresse, auf die ein etwaiger Wildcard-Eintrag der Zone zeigt. Steht dort
# ein Wildcard, beantwortet er JEDEN erfundenen Namen — Existenzpruefungen
# per dig sind dann wertlos. Ohne Wildcard eine beliebige Adresse aus einem
# Dokumentationsnetz eintragen (198.51.100.10) - leer bricht die Einrichtung
# ab, weil jede Variable hier Pflicht ist.
# *Address a possible wildcard record points at. With a wildcard present,
#  dig-based existence checks are worthless. Without one, enter any address from
#  a documentation range - empty aborts the setup, every variable is mandatory.*
FREMD_IPV4=198.51.100.10
