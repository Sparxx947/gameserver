#!/usr/bin/env python3
"""spiel-einrichtung — setzt Beitrittspasswort, Adminpasswort und Spielerzahl.

Warum es diesen Schritt ueberhaupt gibt: Nur eine Handvoll Spielserver nimmt das
Passwort aus einer Umgebungsvariablen entgegen (Valheim, Abiotic Factor,
Soulmask). Die grosse Mehrheit legt beim ERSTEN Start eine Konfigurationsdatei
an und liest es von dort. Zum Zeitpunkt der Installation gibt es diese Datei
also noch gar nicht - man muss warten, bis der Server sie geschrieben hat.

Der Lauf ist deshalb wiederholend (Timer, alle zwei Minuten) und arbeitet alle
Stacks ab, deren panel.json "einrichtung_offen": true traegt.

Vorgehen je Spiel: im Datenverzeichnis nach Konfigurationsdateien suchen
(.ini/.json/.cfg/.xml/.properties), darin nach Feldern, deren NAME auf Passwort
oder Spielerzahl passt, und diese setzen. Bewusst ueber Namensmuster statt ueber
eine Liste fester Feldnamen: Die haette ich fuer 40 Spiele raten muessen, und
ein falsch geratener Name faellt nicht auf - der Server stuende ohne Passwort im
Netz. Dieser Weg meldet stattdessen ehrlich, was er NICHT gefunden hat.

  spiel-einrichtung            alle offenen Einrichtungen abarbeiten
  spiel-einrichtung <stack>    nur diesen, auch wenn er nicht offen ist
"""
import json, os, re, subprocess, sys, time
from pathlib import Path

STACKS = Path("/opt/stacks")
ENDLOS_NACH_H = 6          # danach aufgeben und im Panel melden
MAX_TIEFE = 6
MAX_DATEIEN = 4000

# "beta" ist Steams Beta-Zweig-Passwort, "ntfy" das eines Benachrichtigungs-
# dienstes - beide tauchen in JEDER LinuxGSM-Konfiguration auf und sind keine
# Beitrittspasswoerter. Ohne diesen Ausschluss meldete der Lauf "gesetzt in
# betapassword, ntfypassword" und hielt die Einrichtung fuer erledigt.
# *"beta" is Steam's beta-branch password and "ntfy" a notification service's;
#  both appear in every LinuxGSM config and are not join passwords.*
PW_MUSTER    = re.compile(r"^(?!.*(?:admin|rcon|steam|api|web|db|sql|mysql|token|beta|ntfy|"
                          r"discord|telegram|pushbullet|pushover|gotify|smtp|email|mail))"
                          r".*(?:password|passwort|passwd|\bpsw\b|serverpass)", re.I)
# RCON bewusst NICHT: manche Container setzen ihr RCON-Passwort selbst und
# sprechen den Server darueber an - ein fremder Wert bricht ihnen die Steuerung.
ADMIN_MUSTER = re.compile(r"^(?!.*rcon)(?:.*(?:admin|owner).*(?:password|passwort|passwd|psw)|"
                          r".*(?:password|passwd|psw).*admin)", re.I)
# Trennzeichen sind BELIEBIG: Minecraft schreibt "max-players", andere
# "max_players", "maxPlayers" oder "MaxPlayerCount". Die erste Fassung kannte nur
# Unterstrich und Zusammenschreibung - "max-players" fiel durch, die Spielerzahl
# blieb auf 20 stehen, und weil der Erfolg damals allein am Passwort haengte,
# meldete der Lauf trotzdem "fertig" (gemessen 2026-09-07).
# *Separators are arbitrary: Minecraft writes "max-players", others "max_players"
#  or "MaxPlayerCount". The first version knew only underscore and concatenation,
#  so "max-players" slipped through and the player limit silently stayed at 20 -
#  while the run still reported success, because success depended on the password
#  alone.*
SPIELER_MUSTER = re.compile(r"^(?!.*(?:reserved|min))"
                            r".*(?:max[-_. ]?player|max[-_. ]?client|max[-_. ]?connect|"
                            r"max[-_. ]?user|player[-_. ]?limit|server[-_. ]?player|"
                            r"slots|player[-_. ]?count)", re.I)
UEBERSPRINGEN = re.compile(r"(steamapps|steamcmd|/logs?/|/Content/|/Binaries/|/Engine/|"
                           r"\.wine|/Saved/Logs|node_modules|/backups?/)", re.I)


def meldung(*t):
    print(*t, flush=True)


def dateien(basis: Path):
    """Konfigurationskandidaten - VORRANGIG ueber konfig-datei, damit es nur EINE
    Wahrheit darueber gibt, welche Datei Konfiguration ist.

    Vorher hatte dieses Skript eine eigene Suche mit eigenen Filtern. Als
    konfig-datei LinuxGSMs "_default.cfg" ausschloss (die Datei traegt "DO NOT
    EDIT, ANY CHANGES WILL BE OVERWRITTEN!"), schrieb dieses hier weiterhin
    hinein und meldete Erfolg - an einer Datei, die beim naechsten Start
    zurueckgesetzt wird. Zwei Filterlisten heisst frueher oder later zwei
    verschiedene Antworten.
    *Previously this had its own search with its own filters. When konfig-datei
     started excluding LinuxGSM's "_default.cfg" - a file marked DO NOT EDIT -
     this one kept writing to it and reporting success. Two filter lists mean two
     different answers sooner or later.*
    """
    stack = basis.name
    try:
        r = subprocess.run(["/usr/local/bin/konfig-datei", "liste", stack],
                           capture_output=True, text=True, timeout=120)
        if r.returncode == 0:
            treffer = [basis / z.split("\t")[0] for z in r.stdout.splitlines() if z.strip()]
            if treffer:
                return treffer
    except Exception:
        pass
    # Rueckfallweg, falls konfig-datei fehlt: die eigene Suche von frueher.
    # Ohne ihn stuende die Einrichtung still, wenn ein Werkzeug fehlt.
    return dateien_selbst(basis)


def dateien_selbst(basis: Path):
    """Konfigurationskandidaten unter basis - flach genug, um schnell zu bleiben."""
    raus, zaehler = [], 0
    for p in basis.rglob("*"):
        zaehler += 1
        if zaehler > MAX_DATEIEN:
            break
        if p.is_symlink() or not p.is_file():
            continue
        if UEBERSPRINGEN.search(str(p)):
            continue
        if len(p.relative_to(basis).parts) > MAX_TIEFE:
            continue
        if p.suffix.lower() in (".ini", ".json", ".cfg", ".xml", ".properties", ".conf"):
            if p.stat().st_size < 2_000_000:
                raus.append(p)
    return raus


def setze_ini(text, muster, wert):
    """Schluessel=Wert (ini, cfg, properties). Nur vorhandene Felder aendern -
    ein neu erfundenes Feld liest der Server ohnehin nicht."""
    treffer = []
    def ersetze(m):
        if not muster.search(m.group(1).strip()):
            return m.group(0)
        treffer.append(m.group(1).strip())
        # Was hinter dem Wert steht, muss stehen bleiben: Necesses server.cfg ist
        # eine Liste mit Kommas, andere Dateien tragen Kommentare hinter dem Wert.
        # Wer einfach bis zum Zeilenende ersetzt, nimmt das Trennzeichen mit -
        # bei Necesse verloren "slots" und "password" so ihr Komma, waehrend alle
        # Nachbarzeilen eines hatten. Beim Test aufgefallen.
        rest = m.group(3)
        schwanz = ""
        k = re.search(r"\s*(?://|#|;).*$", rest)
        if k:
            schwanz = k.group(0)
            rest = rest[:k.start()]
        if rest.rstrip().endswith(","):
            schwanz = "," + schwanz
        return f"{m.group(1)}{m.group(2)}{wert}{schwanz}"
    # [ \t] statt \s: "\s" schliesst den Zeilenumbruch ein. Bei einem leeren Wert
    # ("ServerPassword=") verschluckte der Ausdruck sonst die FOLGENDE Zeile als
    # Wert - das Passwort landete eine Zeile tiefer und das Adminfeld wurde nie
    # gefunden, weil es schon konsumiert war. Beim Test aufgefallen.
    neu = re.sub(r"^([ \t]*[A-Za-z_][A-Za-z0-9_.\- ]*?)([ \t]*[:=][ \t]*)([^\r\n]*)$",
                 ersetze, text, flags=re.M)
    return neu, treffer


# Kommentarfelder. Factorio schreibt seine Erklaerung als "_comment_<feld>"
# NEBEN das Feld, das sie erklaert - der Name enthaelt den echten Feldnamen also
# vollstaendig und trifft jedes Muster, das auf das Feld passt. Eine Erklaerung
# mit einer Spielerzahl zu ueberschreiben zerstoert keine Funktion, aber es
# zerstoert die Datei fuer den naechsten Menschen, der sie liest.
# *A comment field carries the real field name in full, so it matches every
#  pattern that matches the field itself.*
KOMMENTARFELD = re.compile(r"(^|[-_. ])comment([-_. ]|$)", re.I)


def darf_ersetzen(alt, zahl):
    """Darf der vorhandene Wert ueberschrieben werden? Nur gleiche Art gegen
    gleiche Art.

    Ein Boolean ist keine Zahl, und ein Erklaertext ist auch keine. Genau daran
    ist Factorio gestorben (#154): "ignore_player_limit_for_returning_players"
    stand auf false, traf das Spielerzahl-Muster ueber den Namensbestandteil
    "player_limit", bekam die 4 - und der Server verweigerte mit
    "Value must be a bool" den Start, waehrend die Einrichtung Erfolg meldete.

    bool wird ZUERST ausgeschlossen: isinstance(True, int) ist in Python True.
    Ohne diese Zeile faengt die Pruefung ausgerechnet den Fall nicht, fuer den
    sie gebaut ist.

    Diese Regel braucht kein Wissen ueber ein einzelnes Spiel - das ist ihr
    Wert. Sie traegt allerdings nur, wo es Typen GIBT: .ini, .cfg und .xml
    kennen nur Text, dort schuetzt weiter allein das Muster.

    *Same kind for same kind. A boolean is not a number and neither is an
     explanatory text. bool is excluded first because isinstance(True, int) is
     True in Python - without that line the check misses exactly the case it
     was built for. The rule needs no per-game knowledge, but it only carries
     where types exist: ini, cfg and xml know only text.*
    """
    if isinstance(alt, bool):
        return False
    if zahl:
        return isinstance(alt, (int, float))
    return isinstance(alt, str)


def setze_json(text, muster, wert, zahl=False):
    treffer, uebersprungen = [], []
    try:
        daten = json.loads(text)
    except Exception:
        return text, treffer, uebersprungen
    def geh(o):
        if isinstance(o, dict):
            for k, v in list(o.items()):
                if isinstance(v, (dict, list)):
                    geh(v)
                elif muster.search(k):
                    if KOMMENTARFELD.search(k) or not darf_ersetzen(v, zahl):
                        uebersprungen.append(k)
                        continue
                    o[k] = int(wert) if zahl else str(wert)
                    treffer.append(k)
        elif isinstance(o, list):
            for x in o:
                geh(x)
    geh(daten)
    return (json.dumps(daten, indent=2) if treffer else text), treffer, uebersprungen


def setze_xml(text, muster, wert):
    """Zwei Formen, beide kommen vor:
         <serversettings password="x" MaxPlayers="16"/>       (Barotrauma)
         <property name="ServerPassword" value="x"/>          (7 Days to Die)
    Wer nur die erste kennt, aendert bei 7DtD nichts und merkt es nicht."""
    treffer = []

    def prop(m):
        if muster.search(m.group(1)):
            treffer.append(m.group(1))
            return f'name="{m.group(1)}" value="{wert}"'
        return m.group(0)
    neu = re.sub(r'name="([^"]+)"(\s+)value="([^"]*)"', prop, text)

    def attr(m):
        if muster.search(m.group(1)):
            treffer.append(m.group(1))
            return f'{m.group(1)}="{wert}"'
        return m.group(0)
    neu = re.sub(r'(?<![\w"])([A-Za-z_][A-Za-z0-9_]*)="([^"]*)"', attr, neu)
    return neu, treffer


def setze_cfg(text, muster, wert):
    """Form "schluessel wert" ohne Gleichheitszeichen, Semikolon optional.

    Das Semikolon war zunaechst Pflicht - damit fiel der komplette GoldSrc-Stil
    durch, in dem LinuxGSM und alle Half-Life-Ableger ihre Serverkonfiguration
    schreiben:

        sv_password ""
        hostname "LinuxGSM"

    Ohne diese Zeilen bliebe ein solcher Server ohne Beitrittspasswort, und der
    Einrichtungsschritt haette es nicht einmal gemerkt (gemessen 2026-09-07 an
    Ricochet).
    *The semicolon used to be mandatory, which excluded the entire GoldSrc style
     that LinuxGSM and every Half-Life derivative use. Such a server would have
     ended up without a join password, unnoticed.*

    Die Regel bleibt eng: die Zeile muss AUSSCHLIESSLICH aus Schluessel und Wert
    bestehen. Sonst zerlegt sie in einer Konfiguration mit Fliesstext die
    falschen Zeilen.
    Ein zweites Mal zu eng war die Regel beim id-Tech-Stil, den Quake, Wolfenstein
    und ET: Legacy benutzen - dort steht ein "set" davor:

        set g_password ""
        seta sv_hostname "LinuxGSM"

    Ohne das optionale Praefix blieb ET: Legacy am 08.09. ohne Beitrittspasswort,
    waehrend der Port schon veroeffentlicht war. Das Praefix wird erhalten, sonst
    liest das Spiel die Zeile nicht mehr.
    *Second time the rule was too narrow: the id-Tech style prefixes "set". ET:
     Legacy stayed without a join password while its port was already published.*
    """
    treffer = []
    def ersetze(m):
        praefix, schluessel, altwert, semi = m.group(1), m.group(2), m.group(3), m.group(4)
        if muster.search(schluessel):
            treffer.append(schluessel)
            anf = '"' if altwert.startswith('"') else ''
            kopf = f"{praefix} {schluessel}" if praefix else schluessel
            return f'{kopf} {anf}{wert}{anf}{semi}'
        return m.group(0)
    neu = re.sub(r'^(?:(seta?)[ \t]+)?([A-Za-z_][A-Za-z0-9_]*)[ \t]+("[^"\r\n]*"|[^\s;]+)[ \t]*(;?)[ \t]*$',
                 ersetze, text, flags=re.M)
    return neu, treffer


def bearbeite(pfad: Path, muster, wert, zahl=False):
    try:
        text = pfad.read_text(errors="replace")
    except Exception:
        return []
    uebersprungen = []
    if pfad.suffix.lower() == ".json":
        neu, treffer, uebersprungen = setze_json(text, muster, wert, zahl)
    elif pfad.suffix.lower() == ".xml":
        neu, treffer = setze_xml(text, muster, wert)
    else:
        neu, treffer = setze_ini(text, muster, wert)
        # .cfg kennt zusaetzlich die Form ohne Gleichheitszeichen:
        #   serverPassword "";     (The Forest)
        # Nur versuchen, wenn die uebliche Form nichts gefunden hat, und nur bei
        # .cfg - in .ini oder .conf wuerde dieses Muster Fliesstext zerlegen.
        if not treffer and pfad.suffix.lower() == ".cfg":
            neu, treffer = setze_cfg(text, muster, wert)
    if treffer and neu != text:
        pfad.write_text(neu)
    # Stilles Ueberspringen war schon einmal die Ursache: Beim Minecraft-Fall
    # passte das Feld nicht, und niemand erfuhr davon. Wer uebersprungen wird,
    # steht deshalb im Journal - mit dem Grund.
    # *Silent skipping was the cause once before; a skipped field goes to the
    #  journal, with the reason.*
    for k in uebersprungen:
        meldung(f"    uebersprungen: {pfad.name}:{k} (Kommentarfeld oder andere Art)")
    return treffer


def serverlage(stack: str):
    """(kurz, warum) - steht hinter dem Container ueberhaupt ein laufender Server?

    Die Einrichtung berichtete bisher ausschliesslich ueber Felder, die sie
    geschrieben hat, nie darueber, ob dahinter etwas laeuft. Beim ersten
    Aufbau auf einer frischen Maschine liefen drei von drei Servern nicht -
    und alle drei meldeten ein Ergebnis (#158).

    Am schlimmsten war die Aufgabe-Meldung nach sechs Stunden: "der Server
    laeuft ohne Beitrittspasswort" ist falsch, wenn er ueberhaupt nicht laeuft,
    und falsch in die ALARMIERENDE Richtung. Wer das liest, sucht einen offenen
    Port, den es gar nicht gibt, und uebersieht darueber den echten Grund.

    *Setup only ever reported on fields it wrote, never on whether a server was
     behind them. On a fresh machine three of three were not running and all
     three reported an outcome. The six-hour message was the worst of it: "the
     server runs without a join password" is false when it is not running at
     all, and false in the alarming direction.*
    """
    form = ("{{.State.Running}}\t{{.State.Restarting}}\t{{.RestartCount}}"
            "\t{{if .State.Health}}{{.State.Health.Status}}{{else}}-{{end}}")
    try:
        r = subprocess.run(["docker", "inspect", "--format", form, stack],
                           capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return "unbekannt", ""
    if r.returncode != 0 or not r.stdout.strip():
        return "fehlt", "es gibt keinen Container dieses Namens"
    f = r.stdout.strip().split("\t")
    if len(f) != 4:
        return "unbekannt", ""
    if f[1] == "true":
        return "schleife", f"der Container startet immer wieder neu ({f[2]} Neustarts)"
    if f[0] != "true":
        return "gestoppt", "der Container laeuft nicht"
    if f[3] == "unhealthy":
        return "ungesund", "der Container meldet seinen eigenen Gesundheitstest als fehlgeschlagen"
    return "laeuft", ""


def einrichten(stack: str) -> dict:
    verz = STACKS / stack
    marke = verz / "panel.json"
    if not marke.exists():
        return {"fehler": "kein panel.json"}
    p = json.loads(marke.read_text())
    basis = Path(f"/srv/games/{stack}")
    if not basis.exists():
        return {"fehler": "kein Datenverzeichnis"}

    gefunden = {"passwort": [], "admin": [], "spieler": []}
    for f in dateien(basis):
        gefunden["admin"]    += [f"{f.name}:{t}" for t in bearbeite(f, ADMIN_MUSTER, p["admin_passwort"])]
        gefunden["passwort"] += [f"{f.name}:{t}" for t in bearbeite(f, PW_MUSTER, p["passwort"])]
        gefunden["spieler"]  += [f"{f.name}:{t}" for t in bearbeite(f, SPIELER_MUSTER, p.get("spieler", 4), zahl=True)]
    return gefunden


ZAHLEN = Path("/opt/panel/daten/konfigzahlen.json")


def konfigzahlen():
    """Haelt fest, wieviele Konfigurationsdateien jeder Server derzeit hat.

    Die Uebersicht zeigt die Zahl neben dem Knopf "Konfigdateien". Ohne sie
    muesste man jeden Server einzeln aufmachen, um zu sehen, ob es schon etwas
    zu bearbeiten gibt - und direkt nach einer Installation gibt es NICHTS, weil
    der Server erst mehrere Gigabyte laedt. Gemessen 2026-09-07: das Zaehlen
    kostet 27 bis 88 ms je Server, zusammen knapp eine halbe Sekunde.

    Bewusst in einer eigenen Datei und nicht in panel.json: die von Hand
    gebauten Stacks (enshrouded, palworld, ...) haben gar keine panel.json,
    sollen die Zahl aber genauso zeigen.
    *Deliberately its own file rather than panel.json: the hand-built stacks have
     no panel.json at all but should show the count just the same.*
    """
    zahlen = {}
    for d in sorted(STACKS.glob("*/compose.yaml")):
        stack = d.parent.name
        try:
            r = subprocess.run(["/usr/local/bin/konfig-datei", "liste", stack],
                               capture_output=True, text=True, timeout=60)
            zahlen[stack] = len([z for z in r.stdout.splitlines() if z.strip()])
        except Exception:
            continue
    try:
        ZAHLEN.parent.mkdir(parents=True, exist_ok=True)
        tmp = ZAHLEN.with_suffix(".tmp")
        tmp.write_text(json.dumps(zahlen, indent=1))
        os.chmod(tmp, 0o644)
        tmp.replace(ZAHLEN)
    except Exception:
        pass          # ohne die Datei fehlt nur eine Zahl in der Anzeige


def lauf(nur=None):
    for verz in sorted(STACKS.glob("*/panel.json")):
        stack = verz.parent.name
        p = json.loads(verz.read_text())
        if nur and stack != nur:
            continue
        if not nur and not p.get("einrichtung_offen"):
            continue

        alter_h = (time.time() - p.get("angelegt", time.time())) / 3600
        erg = einrichten(stack)
        if "fehler" in erg:
            meldung(f"{stack}: {erg['fehler']}")
            continue

        # Per Umgebung gesetzte Passwoerter zaehlen als erledigt - dort gibt es
        # keine Datei zu aendern.
        per_env = p.get("passwort_art") in ("env", "params", "keins")
        fertig = per_env or bool(erg["passwort"])

        # Die Spielerzahl wird SEPARAT bewertet. Vorher haing der gemeldete
        # Erfolg allein am Passwort: Minecraft bekam "ueber die Umgebung
        # gesetzt", waehrend max-players unangetastet auf 20 stand. Eine
        # Teilaufgabe, die niemand bilanziert, faellt lautlos aus.
        # *The player limit is judged separately. Previously success depended on
        #  the password alone: Minecraft reported "set via the environment" while
        #  max-players sat untouched at 20. A subtask nobody accounts for fails
        #  silently.*
        spieler_offen = not erg["spieler"]

        p["einrichtung_gefunden"] = erg

        if fertig:
            p["einrichtung_offen"] = False
            stand = ("über die Umgebung gesetzt" if per_env else
                     "gesetzt in " + ", ".join(sorted(set(erg["passwort"]))[:4]))
            # Die Spielerzahl haengt hinten an, damit sie in derselben Zeile
            # sichtbar wird, die das Panel ohnehin anzeigt. Wortlaut mit "NICHT",
            # weil app.py genau darauf die Warnung aufhaengt.
            # *Appended to the same line the panel already displays; the wording
            #  carries "NICHT" because app.py keys its warning off it.*
            if spieler_offen and p.get("spieler"):
                stand += (f"; Spielerzahl NICHT gesetzt (Soll {p['spieler']}) - "
                          "kein passendes Feld gefunden, bitte von Hand setzen")
            p["einrichtung_stand"] = stand
            if erg["passwort"] or erg["spieler"] or erg["admin"]:
                neustart(stack)
        elif alter_h > ENDLOS_NACH_H:
            p["einrichtung_offen"] = False
            kurz, warum = serverlage(stack)
            if kurz in ("laeuft", "unbekannt"):
                # Der Server LIEF und hat trotzdem kein Passwortfeld hergegeben -
                # nur dann stimmt dieser Satz, und app.py haengt seine Warnung an
                # den Wortlaut "KEIN Passwortfeld".
                p["einrichtung_stand"] = ("KEIN Passwortfeld gefunden - der Server läuft ohne "
                                          "Beitrittspasswort. Bitte von Hand setzen.")
            else:
                p["einrichtung_stand"] = (
                    f"SERVER STARTET NICHT - {warum}. In {ENDLOS_NACH_H} Stunden ist keine "
                    "Konfigurationsdatei entstanden, weil der Server nie so weit kam. "
                    "Es ist also kein Beitrittspasswort gesetzt - erreichbar ist der "
                    "Server aber auch nicht.")
        else:
            kurz, warum = serverlage(stack)
            p["einrichtung_stand"] = ("wartet auf die Konfigurationsdatei des Servers"
                                      + ("" if kurz in ("laeuft", "unbekannt")
                                         else f" - aber {warum}"))
        verz.write_text(json.dumps(p, indent=1) + "\n")

        # Der Port ZULETZT - und nur, wenn die Einrichtung entschieden ist.
        #
        # Das Eintragen des Ports ist der Schritt, der den Server nach aussen
        # oeffnet. Solange "einrichtung_offen" noch gesetzt ist, warten wir auf
        # ein Passwortfeld - dann darf der Server nicht schon erreichbar sein.
        # Am 08.09. war genau das der Fall: ET: Legacy stand auf 27960 offen im
        # Netz, g_password war "", und der Einrichtungsschritt wartete noch.
        # Dieses Gate haelt auch dann, wenn ein kuenftiges Konfigurationsformat
        # unbekannt ist und deshalb kein Passwort gesetzt werden konnte - es
        # haengt am Ergebnis, nicht am Format.
        # *Publishing the port is what exposes the server, so it happens only once
        #  setup has settled - either the password is in place, or we have given
        #  up on finding a field and said so loudly. The gate keys off the result,
        #  not the format, so an unknown config format cannot slip past it.*
        # Zwei Anlaesse, EIN Weg: ein zu ermittelnder Port (port_regel) oder
        # beim Installieren zurueckgehaltene Katalogports (ports_ausstehend, #156).
        # Beide gehen durch port-ermitteln, und beide erst hier - nach dem Passwort.
        # *Two occasions, ONE path, both only here - after the password.*
        warten_ports = p.get("port_regel") or p.get("ports_ausstehend")
        if warten_ports and not p.get("einrichtung_offen", True):
            r = subprocess.run(["/usr/local/bin/port-ermitteln", stack, "--aus-einrichtung"],
                               capture_output=True, text=True, timeout=600)
            p = json.loads(verz.read_text())   # port-ermitteln hat sie ggf. geaendert
            if r.returncode == 0:
                meldung(f"{stack}: {(r.stdout.strip().splitlines() or ['Port eingetragen'])[-1]}")
            elif r.returncode == 2:
                meldung(f"{stack}: Port noch nicht ermittelbar - {r.stdout.strip()[:120]}")
            else:
                meldung(f"{stack}: Portermittlung fehlgeschlagen - {r.stderr.strip()[:120]}")
        elif warten_ports:
            meldung(f"{stack}: Port bleibt unveroeffentlicht, solange kein "
                    "Beitrittspasswort gesetzt ist")

        meldung(f"{stack}: {p['einrichtung_stand']}")


def neustart(stack):
    subprocess.run(["docker", "compose", "stop"], cwd=STACKS / stack, capture_output=True, timeout=180)
    subprocess.run(["docker", "compose", "up", "-d"], cwd=STACKS / stack, capture_output=True, timeout=180)


if __name__ == "__main__":
    lauf(sys.argv[1] if len(sys.argv) > 1 else None)
    konfigzahlen()
