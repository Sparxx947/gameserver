#!/bin/bash
# spiele-sicherung — sichert Spielstaende nach borgserver (Unraid, ueber Tailnet).
#
# Angelegt 2026-09-06, umgebaut am selben Tag auf:
#   * ein ARCHIV JE SPIEL  ->  einzelne Spiele lassen sich gezielt zurueckholen
#   * Grossvater-Vater-Sohn ueber borg prune
#   * alle 15 Minuten, aber NUR fuer Spiele, deren Container laeuft
#
# Ein gestopptes Spiel aendert sich nicht — es jedes Viertelstuendchen erneut zu
# sichern erzeugte nur Archive ohne neuen Inhalt und verwaesserte die
# Aufbewahrung: Die "Sohn"-Stufe waere binnen zwei Tagen mit Kopien desselben
# Standes gefuellt.
#
#   spiele-sicherung [--alle] [--nur <name>]
#     --alle       auch gestoppte Spiele sichern (fuer den taeglichen Lauf)
#     --nur <name> nur dieses eine Spiel/den Dienst
set -o pipefail
REPO="@@BORG_REPO@@"

# Abgeschaltete Sicherung (BORG_REPO=aus). Die Pruefung steht VOR dem Lesen der
# Passphrase: die Datei gibt es dann gar nicht, und ein "cat: kein Zugriff"
# waere eine irrefuehrende Fehlermeldung fuer einen gewollten Zustand.
#
# Rueckgabe 0, nicht 1: spiel-verwalten ruft dieses Skript vor dem Loeschen
# eines Servers und bricht bei einem Fehlschlag ab. Ein Rueckgabewert 1 wuerde
# also das Deinstallieren unmoeglich machen, obwohl gar nichts kaputt ist. Dass
# es hier keine letzte Sicherung gibt, sagt stattdessen die Bestaetigungsseite —
# vor dem Klick, nicht danach.
# *Checked before reading the passphrase, which does not exist in this mode.
#  Returns 0 on purpose: spiel-verwalten aborts an uninstall when this fails,
#  and nothing is broken here. The missing safety net is stated on the
#  confirmation page instead — before the click, not after.*
case " $* " in
  *" --selbsttest "*) ;;      # der Selbsttest prueft die Entscheidung, nicht das Repositorium
  *)
    if [ "$REPO" = "aus" ]; then
      echo "Sicherung ist abgeschaltet (BORG_REPO=aus) - es wird nichts gesichert." >&2
      exit 0
    fi ;;
esac

# Die Passphrase erst lesen, wenn wirklich gesichert wird: Der Selbsttest
# braucht sie nicht, und einer, der root verlangt, laeuft nur dort, wo man ihn
# am wenigsten braucht - nicht auf dem Rechner, auf dem die Aenderung entsteht.
# *Read only when actually backing up: a self-test requiring root runs only
#  where it is least needed, not on the machine where the change is written.*
case " $* " in
  *" --selbsttest "*) ;;
  *) export BORG_PASSPHRASE=$(cat /root/.borg-passphrase) ;;
esac
export BORG_RSH="ssh -o BatchMode=yes -o ConnectTimeout=15"
ZEIT=$(date +%Y%m%d-%H%M%S)

ALLE=0; NUR=""; SELBSTTEST=0
while [ $# -gt 0 ]; do
  case "$1" in
    --alle) ALLE=1; shift ;;
    --nur) NUR="$2"; shift 2 ;;
    --selbsttest) SELBSTTEST=1; shift ;;
    *) echo "Unbekannt: $1" >&2; exit 1 ;;
  esac
done

# Grossvater-Vater-Sohn:
#   Sohn      alle 15 min, aufgehoben fuer 2 Tage   (--keep-within 2d)
#   Vater     ein Stand je Tag, 14 Tage             (--keep-daily 14)
#   Grossvater ein Stand je Woche, 8 Wochen         (--keep-weekly 8)
#              ein Stand je Monat, 12 Monate        (--keep-monthly 12)
prune_regeln=(--keep-within 2d --keep-daily 14 --keep-weekly 8 --keep-monthly 12)

fehler=0

# Ab wieviel Dateien gilt ein Archiv als "nicht praktisch leer"? Und auf welchen
# Bruchteil des Vorgaengers darf es fallen, ohne dass jemand hinsieht?
# Gemessen wird die GROESSE, nicht die Dateizahl. Der erste Entwurf zaehlte
# Dateien und meldete prompt satisfactory als "praktisch leer" - dort liegen
# genau vier .sav-Dateien, und das ist der vollstaendige Spielstand. Vier
# Dateien mit 258 kB und zwei Dateien mit 13 kB sehen als Zahl aehnlich aus und
# sind es nicht.
#
# Ein Fehlalarm ist hier besonders teuer: Diese Meldung soll man ernst nehmen,
# und eine, die bei einem gesunden Spiel losgeht, nimmt man nach dem zweiten Mal
# nicht mehr ernst.
# *Size, not file count. The first draft counted files and promptly flagged
#  satisfactory, where four .sav files ARE the complete save. Four files at
#  258 kB and two at 13 kB look similar as a number and are not.*
MIN_BYTES="${SICHERUNG_MIN_BYTES:-51200}"          # 50 kB

# --- Alterspruefung (#142) --------------------------------------------------
# Die zwei Pruefungen oben messen die GROESSE. Ein Spielstand, der einmal
# geschrieben und nie wieder angefasst wurde, behaelt seine Groesse: Er kommt
# alle 15 Minuten sauber durch die Untergrenze (genug Inhalt) und durch den
# Einbruchsvergleich (nichts gefallen) - und das Archiv ist eine treue Kopie
# einer Welt, die vor Tagen aufhoerte, geschrieben zu werden. Wir erkannten also
# ein Netz, das NIE etwas gefangen hat, aber nicht eines, das AUFGEHOERT hat.
#
# Das Signal dafuer kostet nichts: "borg create --stats" nennt die deduplizierte
# Groesse, also was gegenueber dem letzten Lauf wirklich neu ist. Gemessen am
# 2026-09-10:
#
#   windrose (schreibt gerade)   181,31 kB neu
#   satisfactory (schreibt nicht)   639 B  neu
#   teamspeak (nur Konfiguration)   643 B  neu
#
# Die rund 640 Byte sind Borgs eigene Verwaltungsdaten - das ist der Boden.
# Alles darueber heisst: es hat sich etwas geaendert. Das braucht KEIN Wissen
# darueber, wie ein einzelnes Spiel seine Staende ablegt, und genau daran waere
# eine Loesung ueber Dateimuster gescheitert (bei Valheim und FOUNDRY traf mein
# erster Versuch das Falsche).
#
# *The two checks above measure size. A save written once and never touched
#  keeps its size and passes both forever. The deduplicated size from
#  --stats says what is actually new since the last run, costs nothing extra,
#  and needs no per-game knowledge of where saves live - which is exactly what a
#  file-pattern approach got wrong.*
NEU_SCHWELLE="${SICHERUNG_NEU_SCHWELLE:-2048}"     # darunter gilt: nichts Neues
STILL_STUNDEN="${SICHERUNG_STILL_STUNDEN:-24}"

# Von Natur aus ausgenommen: Was hier steht, schreibt legitim tagelang nichts.
# TeamSpeaks Daten sind Konfiguration und eine Datenbank, die sich nur aendert,
# wenn jemand Kanaele umbaut - eine Regel, die das meldet, wird stummgeschaltet
# und nimmt die echten Funde mit.
# *Exempt by nature: a rule that flags these gets muted and takes the real
#  findings with it.*
OHNE_ALTERSPRUEFUNG="${SICHERUNG_OHNE_ALTERSPRUEFUNG:-teamspeak}"
EINBRUCH_ANTEIL="${SICHERUNG_EINBRUCH_ANTEIL:-25}"   # Prozent
ZAEHLER=/var/lib/spiele-sicherung.groessen


# --- Ist das Archiv plausibel? ----------------------------------------------
# Am 2026-09-10 stellte sich heraus, dass FOUNDRY seit dem 06.09. gesichert
# wurde und jedes Archiv ZWEI Dateien enthielt: vier leere Verzeichnisse. Der
# Lauf meldete jedes Mal Erfolg, der Rueckgabewert war 0, das Archiv entstand -
# und es hielt nichts. Nicht "der Spielstand fehlt", sondern: das Netz meldet
# sich heil und faengt nichts.
#
# ZWEI Pruefungen, und die erste ist die wichtigere:
#
#  1. Eine absolute Untergrenze. FOUNDRY war von ANFANG an hohl - ein Vergleich
#     mit dem Vorgaenger haette nie angeschlagen, weil der genauso leer war.
#  2. Ein Einbruch gegenueber dem letzten Lauf. Der findet den anderen Fall:
#     etwas, das einmal Inhalt hatte und ihn verliert.
#
# *FOUNDRY had been backed up since 06.09. with two files in every archive: four
#  empty directories. Every run reported success. Two checks, and the first
#  matters more - FOUNDRY was hollow from the start, so comparing against the
#  previous archive would never have fired.*
# ACHTUNG, REIHENFOLGE: Diese beiden Funktionen MUESSEN vor der Schleife am
# Ende der Datei stehen. Bash definiert eine Funktion erst, wenn die Zeile
# ausgefuehrt wird - stehen sie dahinter, meldet der Lauf "command not found"
# und macht kommentarlos weiter.
#
# Genau das ist am 2026-09-10 passiert, und zwar zweimal hintereinander:
# Erst stand in_bytes dahinter (die Groesse blieb leer, die Pruefung stieg
# stumm aus), und beim "Aufraeumen" einer doppelten melden()-Definition habe
# ich die FRUEHE entfernt und die spaete behalten - womit ueberhaupt keine
# Meldung mehr hinausging. Der Lauf meldete beide Male Erfolg.
#
# *Order matters: bash defines a function when the line runs. Behind the loop,
#  both silently became "command not found" while the run reported success.*

# Die Groesse aus "borg create --stats" in Bytes.
#
# Eine eigene Funktion und KEIN eingebettetes awk: Der erste Entwurf hatte das
# awk-Programm mitten in der Aufrufzeile, und die verschachtelten
# Anfuehrungszeichen zerbrachen beim Einsetzen - "awk: runaway string constant".
# Der Lauf meldete daraufhin fuer fuenf Spiele Exit 2, obwohl die Sicherung
# selbst durchgelaufen war. Ein Werkzeug, dessen Auswertung den ganzen Lauf
# scheitern laesst, ist schlimmer als eines ohne Auswertung.
# *A function of its own rather than awk embedded in the call line, where the
#  nested quoting broke and made five games report exit 2 although the backup
#  itself had completed.*
in_bytes() {   # in_bytes <stats-text> [dedup]
  # Die Zeile hat drei Groessenangaben:
  #   This archive:   <original> <einheit>  <komprimiert> <einheit>  <dedup> <einheit>
  # Ohne zweites Argument die erste (wieviel ist drin), mit "dedup" die letzte
  # (wieviel ist gegenueber dem letzten Lauf neu).
  local zeile zahl einheit
  zeile=$(grep -m1 "^This archive:" <<<"$1") || return 0
  if [ "${2:-}" = "dedup" ]; then
    zahl=$(awk "{print \$(NF-1)}" <<<"$zeile")
    einheit=$(awk "{print \$NF}" <<<"$zeile")
  else
    zahl=$(awk "{print \$3}" <<<"$zeile")
    einheit=$(awk "{print \$4}" <<<"$zeile")
  fi
  case "$einheit" in
    kB) python3 -c "print(int(float('$zahl')*1000))" ;;
    MB) python3 -c "print(int(float('$zahl')*1000000))" ;;
    GB) python3 -c "print(int(float('$zahl')*1000000000))" ;;
    TB) python3 -c "print(int(float('$zahl')*1000000000000))" ;;
    B)  python3 -c "print(int(float('$zahl')))" ;;
    *)  return 0 ;;
  esac
}

melden() { /usr/local/bin/platzwart-melden "$@" 2>/dev/null || true; }

# Diese beiden Meldungen gehen mit einer Ruhezeit von einem TAG hinaus, nicht
# den ueblichen drei Stunden: Dieser Lauf kommt alle 15 Minuten, und acht
# Nachrichten taeglich ueber ein laengst bekanntes Problem liest nach dem
# zweiten Tag niemand mehr. Ein Fund, der sich selbst in die
# Bedeutungslosigkeit nagt, ist so gut wie keiner. Die Meldung ueber eine
# FEHLGESCHLAGENE Sicherung bleibt bei drei Stunden - die ist dringend.
# *A day, not the usual three hours: this runs every 15 minutes, and eight
#  messages a day about a long-known problem stop being read. The failed-
#  backup message keeps the short window - that one is urgent.*
# --- Die ENTSCHEIDUNG, ohne Nebenwirkungen ----------------------------------
# Getrennt von pruefe_plausibel(), damit sie pruefbar ist, ohne ein
# Borg-Repositorium, einen laufenden Container und eine Zustandsdatei zu
# brauchen. Vorher war die Frage "was wuerde das bei 2047 Byte entscheiden?"
# nur mit dem ganzen Apparat zu beantworten - und damit gar nicht (Issue #147,
# MajorMaxdom).
#
# Gibt genau eines aus: leer | eingebrochen | still | (nichts)
#
# *Separated so it can be checked without a borg repository, a running container
#  and a state file. "What would this decide for 2047 bytes" was previously only
#  answerable with the whole apparatus, i.e. not at all.*
entscheide() {   # entscheide <bytes> <vorher> <neu> <still_h> <laufzeit_h> <ausgenommen:0|1>
  local zahl="$1" vorher="$2" neu="$3" still_h="$4" laufzeit_h="$5" aus="$6"
  if [ "$zahl" -lt "$MIN_BYTES" ]; then
    echo leer; return
  fi
  if [ -n "$vorher" ] && [ "$vorher" -ge "$MIN_BYTES" ] \
     && [ $((zahl * 100)) -lt $((vorher * EINBRUCH_ANTEIL)) ]; then
    echo eingebrochen; return
  fi
  # Etwas Neues dazugekommen? Dann ist die Stille vorbei, egal wie alt sie war.
  [ -n "$neu" ] && [ "$neu" -ge "$NEU_SCHWELLE" ] && return
  [ "$aus" = "1" ] && return
  if [ "$still_h" -ge "$STILL_STUNDEN" ] && [ "$laufzeit_h" -ge "$STILL_STUNDEN" ]; then
    echo still
  fi
}


pruefe_plausibel() {   # pruefe_plausibel <name> <bytes> <neu_bytes>
  local name="$1" zahl="$2" neu="${3:-}" vorher="" seit="" jetzt
  [ -n "$zahl" ] || return 0
  jetzt=$(date +%s)
  [ -f "$ZAEHLER" ] && {
    vorher=$(grep -E "^$name " "$ZAEHLER" 2>/dev/null | awk '{print $2}')
    seit=$(grep -E "^$name " "$ZAEHLER" 2>/dev/null | awk '{print $3}')
  }
  [ -n "$seit" ] || seit="$jetzt"

  # Laufzeit des Containers: "Laeuft seit gestern und hat nichts geschrieben"
  # ist eine Aussage; "wurde vor zehn Minuten gestartet" ist keine, egal wie alt
  # der Spielstand ist.
  local start laufzeit_h=0 still_h ausgenommen=0
  start=$(docker inspect "$name" --format '{{.State.StartedAt}}' 2>/dev/null)
  [ -n "$start" ] && laufzeit_h=$(( (jetzt - $(date -d "$start" +%s 2>/dev/null || echo "$jetzt")) / 3600 ))
  still_h=$(( (jetzt - seit) / 3600 ))
  grep -qw "$name" <<<"$OHNE_ALTERSPRUEFUNG" && ausgenommen=1

  case "$(entscheide "$zahl" "$vorher" "$neu" "$still_h" "$laufzeit_h" "$ausgenommen")" in
    leer)
      PLATZWART_MELDEN_RUHE_MIN=1440 melden stoerung "Sicherung von $name ist praktisch leer" \
"Das Archiv enthaelt $((zahl / 1024)) kB. Eine Sicherung, die nichts einfaengt,
meldet trotzdem Erfolg - der Rueckgabewert sagt nur, dass das Archiv entstanden
ist, nicht dass etwas drin steht.

Nachsehen mit:  panel-aktion archive $name" ;;
    eingebrochen)
      PLATZWART_MELDEN_RUHE_MIN=1440 melden stoerung "Sicherung von $name eingebrochen" \
"Vorher $((vorher / 1024)) kB, jetzt $((zahl / 1024)) kB. Das ist unter $EINBRUCH_ANTEIL Prozent.

Wenn dort nicht gerade etwas geloescht wurde, faengt die Sicherung seit diesem
Lauf weniger ein, als sie soll." ;;
    still)
      PLATZWART_MELDEN_RUHE_MIN=1440 melden stoerung "$name schreibt seit $still_h Stunden nichts" \
"Der Server laeuft seit $laufzeit_h Stunden, und seit $still_h Stunden kam in der
Sicherung nichts Neues dazu. Das Archiv ist gross genug und faellt nicht - es ist
nur eine treue Kopie eines Standes, der sich nicht mehr aendert.

Zwei Bilder passen dazu: Das Spiel pausiert, wenn niemand drauf ist (FOUNDRY und
Satisfactory haben so einen Schalter), oder es kommt nicht mehr zum Schreiben." ;;
  esac

  # Die Stille beginnt neu, sobald etwas Neues dazukam.
  [ -n "$neu" ] && [ "$neu" -ge "$NEU_SCHWELLE" ] && seit="$jetzt"

  # Zahl merken - erst NACH der Pruefung, sonst vergleicht der naechste Lauf
  # gegen den eingebrochenen Wert und schweigt.
  local tmp; tmp=$(mktemp)
  grep -vE "^$name " "$ZAEHLER" 2>/dev/null > "$tmp" || true
  echo "$name $zahl $seit" >> "$tmp"
  sort -o "$ZAEHLER" "$tmp" 2>/dev/null && chmod 600 "$ZAEHLER"
  rm -f "$tmp"
}


sichere() {   # sichere <name> <pfad>
  local name="$1" pfad="$2" aus
  # --stats gibt die Dateizahl gleich mit aus - ein zweiter borg-Aufruf nur zum
  # Zaehlen waere bei einem Lauf alle 15 Minuten unnoetig teuer.
  aus=$(borg create --stats --compression zstd,6 \
        --exclude-from /etc/borg-ausschluss.txt \
        "$REPO::${name}-${ZEIT}" "$pfad" 2>&1)
  local rc=$?
  printf '%s\n' "$aus" | grep -vE "^$"
  if [ $rc -ne 0 ]; then
    echo "FEHLER: borg create fuer $name endete mit $rc" >&2; fehler=1; return
  fi
  # borg --stats nennt die Groesse mit Einheit ("13.44 kB"). Gerechnet wird in
  # Bytes, damit ein Vergleich ueberhaupt moeglich ist - "2.43 GB" und "258 kB"
  # lassen sich als Text nicht vergleichen.
  # Die deduplizierte Groesse steht in derselben Zeile, in den letzten beiden
  # Feldern - sie sagt, was gegenueber dem letzten Lauf WIRKLICH neu ist.
  pruefe_plausibel "$name" "$(in_bytes "$aus")" "$(in_bytes "$aus" dedup)"
  # prune NUR innerhalb dieses Praefixes, sonst wuerde ein Spiel die Staende
  # eines anderen wegraeumen. Borg 1.2 nennt das --glob-archives.
  borg prune --glob-archives "${name}-*" "${prune_regeln[@]}" "$REPO" >/dev/null 2>&1 \
    || { echo "FEHLER: prune fuer $name" >&2; fehler=1; }
}

laeuft() { docker ps --format "{{.Names}}" | grep -qx "$1"; }

# --- Selbsttest -------------------------------------------------------------
# Die Belege fuer diese drei Pruefungen standen als Prosa in geschlossenen Pull
# Requests (#140, #141, #145). Gute Belege - aber niemand konnte sie nachfahren,
# und die naechste Aenderung an dieser Datei liesse sich nicht dagegen messen
# (Issue #147). Das ist das Skript, das entscheidet, ob das Netz echt ist; es
# ist das letzte, das unpruefbar sein darf.
#
# *The evidence for these three checks was prose in closed pull requests. Good
#  evidence, but not re-runnable - and this is the script that decides whether
#  the safety net is real.*
if [ "$SELBSTTEST" -eq 1 ]; then
  schlecht=0
  probe() {   # probe <titel> <bytes> <vorher> <neu> <still_h> <laufzeit_h> <aus> <erwartet>
    local ist; ist=$(entscheide "$2" "$3" "$4" "$5" "$6" "$7")
    ist=${ist:-nichts}
    if [ "$ist" = "$8" ]; then printf '  ok      %s\n' "$1"
    else printf '  FEHLER  %s -> %s (erwartet %s)\n' "$1" "$ist" "$8"; schlecht=$((schlecht+1)); fi
  }
  echo "== Untergrenze (findet ein Archiv, das nie etwas fing) =="
  probe "13 kB, erster Lauf - der FOUNDRY-Fall"   13440      ""      639    0  0 0 leer
  probe "258 kB - satisfactory mit vier .sav"     258370     ""      639    0  0 0 nichts
  probe "genau an der Grenze: 51200 B"            51200      ""      99999  0  0 0 nichts
  probe "knapp darunter: 51199 B"                 51199      ""      99999  0  0 0 leer
  echo
  echo "== Einbruch (findet, was Inhalt hatte und verliert) =="
  probe "2,43 GB -> 500 MB, unter 25 Prozent"     500000000  2430000000 99999 0 0 0 eingebrochen
  probe "2,43 GB -> 2,2 GB, normales Schwanken"   2200000000 2430000000 99999 0 0 0 nichts
  probe "Vorgaenger war selbst winzig"            60000      13440      99999 0 0 0 nichts
  echo
  echo "== Alter (findet ein Netz, das AUFGEHOERT hat zu fangen) =="
  probe "26 h still, Server 26 h auf"             999999     999999  639   26 26 0 still
  probe "26 h still, gerade neu gestartet"        999999     999999  639   26  1 0 nichts
  probe "26 h alt, aber 180 kB neu"               999999     999999  181310 26 26 0 nichts
  probe "10 h still - unter der Frist"            999999     999999  639   10 26 0 nichts
  probe "genau an der Schwelle: 2048 B neu"       999999     999999  2048  26 26 0 nichts
  probe "knapp darunter: 2047 B neu"              999999     999999  2047  26 26 0 still
  probe "ausgenommen (teamspeak)"                 999999     999999  639   26 26 1 nichts
  echo
  echo "== Rangfolge: leer schlaegt alles =="
  probe "13 kB UND 26 h still"                    13440      999999  639   26 26 0 leer
  echo
  # Und die Gegenprobe zur Gegenprobe: Eine Pruefung, die fuer JEDE Eingabe
  # dasselbe meldet, prueft nichts. Hier wird gezaehlt, dass wirklich alle vier
  # Ausgaenge vorkommen.
  # *A check reporting the same for every input checks nothing: all four outcomes
  #  must actually occur.*
  if [ "$(entscheide 13440 "" 639 0 0 0)" = "leer" ] \
     && [ "$(entscheide 500000000 2430000000 99999 0 0 0)" = "eingebrochen" ] \
     && [ "$(entscheide 999999 999999 639 26 26 0)" = "still" ] \
     && [ -z "$(entscheide 258370 "" 639 0 0 0)" ]; then
    echo "  ok      alle vier Ausgaenge kommen vor (leer, eingebrochen, still, nichts)"
  else
    echo "  FEHLER  nicht alle Ausgaenge erreichbar"; schlecht=$((schlecht+1))
  fi
  echo
  [ $schlecht -eq 0 ] && echo "Selbsttest bestanden." || echo "Selbsttest: $schlecht Abweichung(en)."
  exit $((schlecht > 0))
fi

# --- Wache: sind die Funktionen hier ueberhaupt schon da? -------------------
# Bash definiert eine Funktion erst, wenn ihre Zeile AUSGEFUEHRT wird. Steht sie
# hinter dieser Schleife, gibt es ein "command not found" auf stderr, und der
# Lauf macht kommentarlos weiter - mit Rueckgabewert 0 und der Zeile "Sicherung
# abgeschlossen". Am 2026-09-10 ist das ZWEIMAL in dieser Datei passiert
# (in_bytes und melden, siehe #143), und beide Male sah der Lauf gesund aus.
#
# Der Selbsttest kann das nicht sehen - er laeuft, wenn alles definiert ist.
# Diese drei Zeilen koennen es, und zwar bei jedem Lauf.
#
# *Bash defines a function when its line runs. Behind this loop it becomes
#  "command not found" while the run reports success. That happened twice in
#  this file in one day. The self-test cannot see it - it runs when everything
#  is defined. These three lines can, on every run.*
for fn in in_bytes melden entscheide pruefe_plausibel sichere laeuft; do
  declare -F "$fn" >/dev/null \
    || { echo "ABBRUCH: $fn ist an dieser Stelle noch nicht definiert - die" >&2
         echo "  Funktion steht hinter der Schleife, die sie ruft." >&2
         exit 3; }
done

for d in /srv/games/*/ /srv/dienste/*/; do
  [ -d "$d" ] || continue
  name=$(basename "$d")
  [ -n "$NUR" ] && [ "$NUR" != "$name" ] && continue
  if [ "$ALLE" -eq 0 ] && [ -z "$NUR" ] && ! laeuft "$name"; then continue; fi
  sichere "$name" "${d%/}"
done

# Konfiguration (compose-Dateien mit Passwoertern, /etc) — nur im vollen Lauf.
if [ "$ALLE" -eq 1 ] && [ -z "$NUR" ]; then
  sichere "config" "/opt/stacks"
  borg create --compression zstd,6 "$REPO::etc-${ZEIT}" /etc >/dev/null 2>&1 \
    && borg prune --glob-archives "etc-*" "${prune_regeln[@]}" "$REPO" >/dev/null 2>&1
fi

borg compact "$REPO" >/dev/null 2>&1

# --- Melden ------------------------------------------------------------------
# Dieser Lauf kommt alle 15 Minuten, also 96-mal am Tag. Deshalb zwei Dinge:
#
#  1. Der Meldungstext traegt KEINEN Zeitstempel. platzwart-melden unterdrueckt
#     Wiederholungen ueber einen Abgleich des Textes - mit "$ZEIT" darin waere
#     jeder Lauf ein neuer Text und die Sperre wirkungslos. Aus einer Stoerung
#     wuerden 96 Nachrichten, und danach schaltet man den Kanal ab.
#  2. Die Entwarnung wird gemeldet, nicht nur die Stoerung. Ohne sie weiss
#     niemand, ob das Problem noch besteht oder sich erledigt hat - und ein
#     Alarm, dessen Ende man nicht sieht, wird zum Dauerzustand.
#
# *Runs every 15 minutes. The text carries no timestamp, or the repeat guard
#  would never match and one fault would become 96 messages a day. And recovery
#  is reported too: an alarm whose end is invisible becomes permanent.*
# EINE Definition, absichtlich. Sie stand kurzzeitig zweimal da - Bash nimmt
# dann die letzte, das Verhalten war gleich, aber zwei gleiche Zeilen laufen
# frueher oder spaeter auseinander.
# *One definition on purpose: it briefly existed twice, which Bash resolves
#  to the last one - same behaviour, but two identical lines drift apart.*
MARKE=/var/lib/spiele-sicherung.stoerung
if [ $fehler -ne 0 ]; then
  melden stoerung "Sicherung fehlgeschlagen" \
"Der Sicherungslauf endete mit Fehlern. Bis das behoben ist, entsteht kein
neuer Rueckweg - und die vorhandenen Staende fallen weiter aus der Rotation.

Nachsehen mit:  journalctl -u spiele-sicherung -n 50"
  : > "$MARKE"
elif [ -e "$MARKE" ]; then
  melden meldung "Sicherung laeuft wieder" \
"Der erste Lauf nach der Stoerung ist durchgelaufen."
  rm -f "$MARKE"
fi

[ $fehler -eq 0 ] && echo "Sicherung abgeschlossen: $ZEIT" || { echo "Sicherung MIT FEHLERN: $ZEIT" >&2; exit 1; }
