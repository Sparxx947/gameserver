#!/usr/bin/env python3
"""kanal-verwalten — ein TeamSpeak- und ein Discord-Kanal je Spielserver (#137).

  kanal-verwalten abgleich            Kanaele an die installierten Server angleichen
  kanal-verwalten vorschau <stack>    was beim Entfernen mit den Kanaelen geschieht (je Dienst eine Zeile)
  kanal-verwalten pruefen             TeamSpeak-Zugang pruefen (Benutzer, Passwort ueber stdin)
  kanal-verwalten pruefen-discord     Discord-Bot pruefen (Token, Server-ID ueber stdin)
  kanal-verwalten --selbsttest

Laeuft als root ueber kanal-abgleich.timer und wird nach jeder Installation und
Entfernung sofort angestossen - nie im Seitenaufruf: Ein langsamer oder
gestoerter TeamSpeak soll keine Panel-Seite haengen lassen.

== Die Regeln (Jens' Entscheidungen vom 2026-09-11, in #137) ==
- Aus, bis im Panel (Integrationen) eingeschaltet - je Dienst getrennt.
- Welche Server es gibt, sagt /opt/stacks - keine zweite Liste.
- LOESCHEN nur, was UNBERUEHRT ist: von Platzwart angelegt (gespeicherte
  Zuordnung Stack -> Kanal-ID, kein Namensvergleich), weder umbenannt noch
  verschoben, ohne Unterkanaele, niemand drin. Sonst bleibt der Kanal stehen
  und wird gemeldet. Die Bestaetigungsseite beim Entfernen zeigt das Urteil
  vorher (vorschau).
- Discord (E33, Nachtrag): unberuehrt heisst dort zusaetzlich: Kanalrechte
  unveraendert und NOCH NIE eine Nachricht darin - Discord bewahrt den Verlauf,
  und der geht nie mit verloren.
- Einen Kanal gleichen Namens, den jemand von Hand angelegt hat, uebernimmt
  das Werkzeug als "fremd" - angezeigt, aber nie geloescht.
- Jedes Anlegen und Loeschen steht im Panel-Protokoll; Fehler gehen nach
  #platzwart-stoerung.

*One TeamSpeak channel per game server. Off until switched on in the panel.
 Deletes only what is untouched: created by Platzwart (stored id, no name
 matching), not renamed or moved, no subchannels, nobody inside - otherwise
 it stays and is reported. Every create/delete is audited; failures are
 reported. Never runs inside a page request.*
"""
import fcntl
import json
import os
import re
import socket
import subprocess
import sys
import time
from pathlib import Path

DATEN = Path(os.environ.get("KANAL_DATEN", "/opt/panel/daten"))
EINSTELLUNG = DATEN / "kanaele.json"          # vom Panel geschrieben
ZUGANG = DATEN / "teamspeak.conf"             # vom Panel geschrieben, 0600
DISCORD_ZUGANG = DATEN / "discord.conf"       # vom Panel geschrieben, 0600
DISCORD_API = os.environ.get("KANAL_DISCORD_API", "https://discord.com/api/v10")
ZUORDNUNG = DATEN / "kanaele-zuordnung.json"  # von hier geschrieben
AUDIT = DATEN / "audit.jsonl"
STACKS = Path(os.environ.get("KANAL_STACKS", "/opt/stacks"))
KATALOG = Path(os.environ.get("KANAL_KATALOG", "/etc/spiele-katalog.json"))
SPERRE = os.environ.get("KANAL_SPERRE", "/run/kanal-verwalten.lock")
# Die Anfrage kommt beim TeamSpeak-Server ueber das Docker-Gateway an, nicht von
# 127.0.0.1 - sie steht also NICHT auf seiner Allowlist und unterliegt dem
# Flutschutz (gemessen 2026-09-11). Deshalb wenige Befehle und eine Pause davor.
# Drei Anmeldungen kurz hintereinander -> "client is flooding" (id 524), danach
# lehnt TeamSpeak neue Verbindungen OHNE Begruessung ab, und wer weiter
# anklopft, verlaengert die Sperre (nach 120 s Pollen noch zu). Der Flutschutz
# zaehlt ueber Verbindungen hinweg, je Absenderadresse. 0,35 s zwischen den
# Befehlen reichten im Test nicht - 0,6 s, eine Verbindung je Lauf.
# *Queries arrive via the Docker gateway, not 127.0.0.1, so flood protection
#  applies across connections: three quick logins got "client is flooding",
#  then connections were refused without greeting. Paced at 0.6 s.*
PAUSE = float(os.environ.get("KANAL_PAUSE", "0.6"))
NAME_MAX = 40                                 # TeamSpeak: Kanalname hoechstens 40 Zeichen
NICHT_ALS_KANAL = {"teamspeak"}               # der TeamSpeak-Stack selbst


class QueryFehler(Exception):
    pass


class DiscordFehler(Exception):
    pass


# --- ServerQuery -------------------------------------------------------------

ESC = [("\\", "\\\\"), ("/", "\\/"), (" ", "\\s"), ("|", "\\p"), ("\a", "\\a"), ("\b", "\\b"),
       ("\f", "\\f"), ("\n", "\\n"), ("\r", "\\r"), ("\t", "\\t"), ("\v", "\\v")]


def ts_esc(s: str) -> str:
    for a, b in ESC:
        s = s.replace(a, b)
    return s


def ts_unesc(s: str) -> str:
    raus, i = [], 0
    rueck = {b[1]: a for a, b in ESC}
    while i < len(s):
        if s[i] == "\\" and i + 1 < len(s) and s[i + 1] in rueck:
            raus.append(rueck[s[i + 1]])
            i += 2
        else:
            raus.append(s[i])
            i += 1
    return "".join(raus)


def zerlegen(zeile: str) -> list:
    """'a=1 b=x\\sy|a=2' -> [{'a': '1', 'b': 'x y'}, {'a': '2'}]. Rein."""
    raus = []
    for teil in zeile.split("|"):
        d = {}
        for tok in teil.split(" "):
            if not tok:
                continue
            k, _, v = tok.partition("=")
            d[k] = ts_unesc(v)
        raus.append(d)
    return raus


class Query:
    def __init__(self, host: str, port: int, timeout: float = 10):
        try:
            self.s = socket.create_connection((host, port), timeout=timeout)
        except OSError as e:
            raise QueryFehler(f"TeamSpeak-ServerQuery auf {host}:{port} nicht erreichbar ({e.__class__.__name__})")
        self.f = self.s.makefile("rwb")
        try:
            kopf = self.f.readline()
        except OSError:
            kopf = b""
        if not kopf:
            raise QueryFehler("TeamSpeak lehnt ServerQuery gerade ab - vermutlich sein Flutschutz nach "
                              "zu vielen Anfragen. Der naechste Abgleich versucht es erneut.")
        if not kopf.startswith(b"TS3"):
            raise QueryFehler(f"auf {host}:{port} antwortet kein TeamSpeak-ServerQuery ({kopf[:40]!r})")
        self.f.readline()                                  # Begruessung

    def befehl(self, text: str) -> list:
        time.sleep(PAUSE)
        self.f.write(text.encode() + b"\n")
        self.f.flush()
        daten = []
        while True:
            z = self.f.readline()
            if not z:
                raise QueryFehler("TeamSpeak hat die Verbindung beendet")
            z = z.decode("utf-8", "replace").strip("\r\n")
            if z.startswith("error "):
                e = zerlegen(z[6:])[0]
                if e.get("id") == "524":
                    raise QueryFehler("TeamSpeak drosselt ServerQuery (Flutschutz: \"client is flooding\") - "
                                      "der naechste Abgleich versucht es erneut")
                if e.get("id") != "0":
                    raise QueryFehler(f"{text.split(' ')[0]}: {e.get('msg', '?')} (id {e.get('id')})")
                return daten
            if z:
                daten.extend(zerlegen(z))

    def zu(self):
        try:
            self.f.write(b"quit\n")
            self.f.flush()
            self.s.close()
        except OSError:
            pass


def zugang() -> dict:
    """TS_USER/TS_PASS (Pflicht), TS_HOST/TS_PORT/TS_SID (Vorgabe 127.0.0.1/10011/1)."""
    d = {"TS_HOST": "127.0.0.1", "TS_PORT": "10011", "TS_SID": "1"}
    try:
        for z in ZUGANG.read_text().splitlines():
            if "=" in z and not z.lstrip().startswith("#"):
                k, v = z.split("=", 1)
                d[k.strip()] = v.strip()
    except OSError:
        pass
    return d


def verbinden(z: dict) -> Query:
    if not z.get("TS_USER") or not z.get("TS_PASS"):
        raise QueryFehler("kein TeamSpeak-Zugang hinterlegt (Panel: Integrationen)")
    q = Query(z["TS_HOST"], int(z["TS_PORT"]))
    try:
        q.befehl(f"login {ts_esc(z['TS_USER'])} {ts_esc(z['TS_PASS'])}")
        q.befehl(f"use sid={int(z.get('TS_SID', 1))}")
    except QueryFehler:
        q.zu()
        raise
    return q


# --- Regeln (rein, damit pruefbar) -----------------------------------------------

def kanalname(muster: str, name: str) -> str:
    """Namensmuster anwenden, auf TeamSpeaks 40 Zeichen kuerzen. Rein."""
    n = (muster or "{name}").replace("{name}", name).strip()
    return n[:NAME_MAX] or name[:NAME_MAX]


def urteil_entfernen(eintrag: dict, kanaele: dict) -> tuple:
    """(loeschen, grund) fuer den Kanal eines entfernten Servers. Rein.

    kanaele: {cid: {"channel_name", "pid", "total_clients"}} aus channellist.
    Geloescht wird NUR, was unberuehrt ist - jede Abweichung heisst, dass ein
    Mensch den Kanal zu seinem gemacht hat.
    """
    if eintrag.get("fremd"):
        return False, "nicht von Platzwart angelegt"
    k = kanaele.get(str(eintrag.get("cid")))
    if not k:
        return False, "gibt es auf dem TeamSpeak-Server nicht mehr"
    if k.get("channel_name") != eintrag.get("name"):
        return False, f"umbenannt in „{k.get('channel_name')}“"
    if str(k.get("pid")) != str(eintrag.get("cpid")):
        return False, "verschoben"
    if any(str(v.get("pid")) == str(eintrag.get("cid")) for v in kanaele.values()):
        return False, "hat Unterkanäle"
    if int(k.get("total_clients") or 0) > 0:
        return False, "es ist gerade jemand drin"
    return True, "unberührt und leer"


# --- Zustand ---------------------------------------------------------------------

def lies_json(p: Path, vorgabe):
    try:
        return json.loads(p.read_text())
    except (OSError, ValueError):
        return vorgabe


def schreibe_json(p: Path, d):
    """Atomar, dem Panel lesbar (panel:panel 0600) - es zeigt die Zuordnung an."""
    tmp = p.with_suffix(".tmp")
    tmp.write_text(json.dumps(d, indent=1, ensure_ascii=False) + "\n")
    os.chmod(tmp, 0o600)
    try:
        st = DATEN.stat()
        os.chown(tmp, st.st_uid, st.st_gid)
    except OSError:
        pass
    tmp.replace(p)


def einstellung() -> dict:
    e = lies_json(EINSTELLUNG, {}).get("teamspeak") or {}
    return {"an": bool(e.get("an")), "oberkanal": (e.get("oberkanal") or "Spieleserver")[:NAME_MAX],
            "muster": e.get("muster") or "{name}"}


def einstellung_discord() -> dict:
    e = lies_json(EINSTELLUNG, {}).get("discord") or {}
    return {"an": bool(e.get("an")), "kategorie": (e.get("kategorie") or "Spieleserver")[:100],
            "muster": e.get("muster") or "{name}"}


def anzeigename(stack: str, pj: dict, katalog: dict) -> str:
    """Name eines Servers fuer seinen Kanal. Rein.

    panel.json (Katalogspiele) -> Katalogname -> Stackname mit grossem
    Anfangsbuchstaben. Die von Hand gebauten Server (enshrouded, palworld ...)
    haben weder panel.json noch Katalogeintrag, und ihre Kanaele hiessen
    deshalb klein; Jens wollte "schoene Namen" (2026-09-11).
    *panel.json -> catalogue name -> stack name capitalised.*
    """
    if isinstance(pj, dict) and pj.get("name"):
        return str(pj["name"])
    if katalog.get(stack):
        return str(katalog[stack])
    return stack[:1].upper() + stack[1:]


def server() -> dict:
    """{stack: Anzeigename} - aus /opt/stacks, der einen Wahrheit."""
    kat = {e.get("schluessel"): e.get("name") for e in lies_json(KATALOG, {}).get("spiele", [])}
    raus = {}
    for d in sorted(STACKS.glob("*/compose.yaml")):
        s = d.parent.name
        if s in NICHT_ALS_KANAL:
            continue
        raus[s] = anzeigename(s, lies_json(d.parent / "panel.json", {}), kat)
    return raus


def umzubenennen(eintraege: dict, soll: dict) -> list:
    """[(stack, art, eintrag, soll_name)] - wo der Soll-Name vom gespeicherten
    abweicht, fuer Eintraege, die Platzwart selbst angelegt hat. Ob der Kanal
    seitdem von Hand umbenannt wurde, prueft der Aufrufer am echten Kanal:
    Dann gewinnt der Mensch. Rein.
    *Entries created by Platzwart whose name differs from the target; the caller
     checks the live channel - a human rename wins.*"""
    raus = []
    for s, arten in eintraege.items():
        for art, e in arten.items():
            ziel = soll.get((s, art))
            if ziel and not e.get("fremd") and e.get("name") != ziel:
                raus.append((s, art, e, ziel))
    return raus


def protokoll(aktion: str, ziel: str, ergebnis: str = "ok", **details):
    """Ins Panel-Protokoll, als Nutzer "platzwart" - dieselbe Datei, dasselbe Format."""
    eintrag = {"zeit": time.strftime("%Y-%m-%d %H:%M:%S+0000", time.gmtime()), "nutzer": "platzwart",
               "rolle": "system", "aktion": aktion, "ziel": ziel, "ergebnis": ergebnis}
    if details:
        eintrag["details"] = details
    try:
        with AUDIT.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(eintrag, ensure_ascii=False) + "\n")
    except OSError:
        pass


def melden(titel: str, text: str = ""):
    # Hoechstens eine gleiche Meldung je 12 Stunden: Der Timer laeuft alle paar
    # Minuten, und ein gedrosselter oder ausgefallener TeamSpeak soll nicht
    # dauerfeuern.
    # *At most one identical report per 12 hours.*
    subprocess.run(["/usr/local/bin/platzwart-melden", "stoerung", titel, text],
                   capture_output=True, timeout=60, env={**os.environ, "PLATZWART_MELDEN_RUHE_MIN": "720"})


# --- Befehle -----------------------------------------------------------------------

def abgleich_ts() -> int:
    e = einstellung()
    if not e["an"]:
        print("ok\tTeamSpeak-Kanaele sind aus")
        return 0
    zu = lies_json(ZUORDNUNG, {})
    ts = zu.setdefault("teamspeak", {})
    kanaele_von = {k: v for k, v in ts.items() if not k.startswith("_")}
    da = server()
    fehlend = [s for s in da if s not in kanaele_von]
    weg = [s for s in kanaele_von if s not in da]
    neu_name = umzubenennen({s: {"ts": v} for s, v in kanaele_von.items() if s in da},
                            {(s, "ts"): kanalname(e["muster"], da[s]) for s in da})
    # Nichts zu tun, nichts zu verbinden: Der Timer laeuft alle paar Minuten, und
    # jede Anmeldung steht im TeamSpeak-Log.
    # *Nothing to do, no connection: every login shows up in TeamSpeak's log.*
    if not fehlend and not weg and not neu_name:
        print("ok\tnichts zu tun")
        return 0
    try:
        q = verbinden(zugang())
    except QueryFehler as f:
        melden("TeamSpeak-Kanaele: kein Zugriff", f"{f}\n\nOffen: {len(fehlend)} anzulegen, {len(weg)} zu pruefen.")
        print(f"FEHLER: {f}", file=sys.stderr)
        return 1
    angelegt, geloescht, stehen = [], [], []
    try:
        liste = q.befehl("channellist")
        kanaele = {v["cid"]: v for v in liste}
        # Oberkanal: gespeicherte ID, sonst per Name uebernehmen, sonst anlegen.
        # Er wird nie geloescht - hier landen alle Serverkanaele.
        ober = ts.get("_oberkanal") or {}
        if str(ober.get("cid")) not in kanaele:
            treffer = [v for v in liste if v.get("channel_name") == e["oberkanal"] and v.get("pid") == "0"]
            if treffer:
                ober = {"cid": treffer[0]["cid"], "name": e["oberkanal"]}
            elif fehlend:
                r = q.befehl(f"channelcreate channel_name={ts_esc(e['oberkanal'])} channel_flag_permanent=1")
                ober = {"cid": r[0]["cid"], "name": e["oberkanal"]}
                protokoll("TeamSpeak-Oberkanal angelegt", e["oberkanal"], cid=ober["cid"])
            ts["_oberkanal"] = ober
        for s in fehlend:
            name = kanalname(e["muster"], da[s])
            gleich = [v for v in liste if v.get("channel_name") == name and v.get("pid") == str(ober.get("cid"))]
            if gleich:
                ts[s] = {"cid": gleich[0]["cid"], "name": name, "cpid": ober["cid"], "fremd": True,
                         "seit": int(time.time())}
                protokoll("TeamSpeak-Kanal vorgefunden (nicht angelegt, wird nie geloescht)", s, name=name)
                continue
            r = q.befehl(f"channelcreate channel_name={ts_esc(name)} cpid={int(ober['cid'])} "
                         f"channel_flag_permanent=1 "
                         f"channel_description={ts_esc('Angelegt von Platzwart für ' + da[s])}")
            ts[s] = {"cid": r[0]["cid"], "name": name, "cpid": ober["cid"], "seit": int(time.time())}
            angelegt.append(name)
            protokoll("TeamSpeak-Kanal angelegt", s, name=name, cid=r[0]["cid"])
        for s, _, eintrag, ziel in neu_name:
            k = kanaele.get(str(eintrag.get("cid")))
            if not k or k.get("channel_name") != eintrag.get("name"):
                continue                     # weg oder von Hand umbenannt: der Mensch gewinnt
            q.befehl(f"channeledit cid={int(eintrag['cid'])} channel_name={ts_esc(ziel)}")
            protokoll("TeamSpeak-Kanal umbenannt", s, alt=eintrag["name"], name=ziel)
            angelegt.append(f"{eintrag['name']} -> {ziel}")
            eintrag["name"] = ziel
        for s in weg:
            eintrag = ts[s]
            loeschen, grund = urteil_entfernen(eintrag, kanaele)
            if loeschen:
                q.befehl(f"channeldelete cid={int(eintrag['cid'])} force=0")
                geloescht.append(eintrag["name"])
                protokoll("TeamSpeak-Kanal geloescht", s, name=eintrag["name"], grund=grund)
            else:
                stehen.append(f"{eintrag.get('name')} ({grund})")
                protokoll("TeamSpeak-Kanal bleibt stehen", s, "nicht geloescht",
                          name=eintrag.get("name"), grund=grund)
                zu.setdefault("verwaist", {}).setdefault("teamspeak", {})[s] = {
                    **eintrag, "grund": grund, "bis": int(time.time())}
            del ts[s]
    except QueryFehler as f:
        melden("TeamSpeak-Kanaele: Abgleich gescheitert", str(f))
        print(f"FEHLER: {f}", file=sys.stderr)
        schreibe_json(ZUORDNUNG, zu)
        return 1
    finally:
        q.zu()
    schreibe_json(ZUORDNUNG, zu)
    if stehen:
        melden("TeamSpeak-Kanal nicht geloescht",
               "Der Server ist entfernt, sein Kanal bleibt stehen, weil ihn ein Mensch zu seinem "
               "gemacht hat oder er nicht leer ist:\n" + "\n".join(stehen))
    print("ok\tTeamSpeak: " + ("; ".join(x for x in [
        f"angelegt/umbenannt: {', '.join(angelegt)}" if angelegt else "",
        f"geloescht: {', '.join(geloescht)}" if geloescht else "",
        f"stehen gelassen: {', '.join(stehen)}" if stehen else ""] if x) or "erledigt"))
    return 0


# --- Discord -----------------------------------------------------------------------

def discord_zugang() -> dict:
    d = {}
    try:
        for z in DISCORD_ZUGANG.read_text().splitlines():
            if "=" in z and not z.lstrip().startswith("#"):
                k, v = z.split("=", 1)
                d[k.strip()] = v.strip()
    except OSError:
        pass
    return d


def discord(z: dict, methode: str, pfad: str, daten=None):
    """Ein Aufruf der Discord-REST-API mit Bot-Token. Beachtet 429 (retry_after)."""
    import urllib.error
    import urllib.request
    if not z.get("DISCORD_TOKEN"):
        raise DiscordFehler("kein Discord-Bot hinterlegt (Panel: Integrationen)")
    for _ in range(4):
        req = urllib.request.Request(
            DISCORD_API + pfad, method=methode,
            data=json.dumps(daten).encode() if daten is not None else None,
            headers={"Authorization": f"Bot {z['DISCORD_TOKEN']}", "Content-Type": "application/json",
                     "User-Agent": "DiscordBot (platzwart, 1)",
                     "X-Audit-Log-Reason": "Platzwart: Kanal je Spielserver"})
        try:
            with urllib.request.urlopen(req, timeout=20) as r:
                roh = r.read()
                return json.loads(roh) if roh else None
        except urllib.error.HTTPError as e:
            text = e.read().decode(errors="replace")[:200]
            if e.code == 429:
                try:
                    time.sleep(min(float(json.loads(text).get("retry_after", 2)), 30) + 0.2)
                except ValueError:
                    time.sleep(3)
                continue
            if e.code == 404:
                return {"_fehlt": True}
            raise DiscordFehler(f"Discord {methode} {pfad.split('?')[0]}: HTTP {e.code} {text}")
        except OSError as e:
            raise DiscordFehler(f"Discord nicht erreichbar ({e.__class__.__name__})")
    raise DiscordFehler("Discord drosselt (HTTP 429) - der naechste Abgleich versucht es erneut")


def d_name(n: str) -> str:
    """So legt Discord einen Textkanal an: klein, Leerzeichen zu Bindestrich. Rein."""
    return re.sub(r"\s+", "-", n.strip().lower())[:100]


def d_rechte(kanal: dict) -> list:
    """Kanalrechte in vergleichbarer Form. Rein."""
    return sorted(f"{o.get('id')}:{o.get('type')}:{o.get('allow')}:{o.get('deny')}"
                  for o in kanal.get("permission_overwrites") or [])


def urteil_discord(eintrag: dict, k, belegt=None) -> tuple:
    """(loeschen, grund) fuer einen Discord-Kanal eines entfernten Servers. Rein.

    Wie bei TeamSpeak - dazu die Kanalrechte und der Verlauf: Ein Kanal, in dem
    je eine Nachricht stand (bei Sprachkanaelen: im Text-Chat des Sprachkanals),
    wird nie geloescht; Discord bewahrt den Verlauf, und "der Container wurde
    entfernt" ist kein Grund, ihn zu verlieren.
    belegt: bei Sprachkanaelen die Menge der belegten Kanal-IDs aus dem Gateway,
    None = nicht messbar (dann wird nicht geloescht, sondern spaeter erneut
    geprueft - siehe abgleich_discord).
    """
    if eintrag.get("fremd"):
        return False, "nicht von Platzwart angelegt"
    if not k or k.get("_fehlt"):
        return False, "gibt es auf dem Discord-Server nicht mehr"
    if k.get("name") != eintrag.get("name"):
        return False, f"umbenannt in „{k.get('name')}“"
    if str(k.get("parent_id")) != str(eintrag.get("parent")):
        return False, "verschoben"
    if d_rechte(k) != eintrag.get("rechte", []):
        return False, "Kanalrechte geändert"
    if k.get("last_message_id"):
        return False, "es stehen Nachrichten darin"
    if k.get("type") == 2:
        if belegt is None:
            return False, "Belegung nicht messbar"
        if str(k.get("id")) in belegt:
            return False, "es ist gerade jemand drin"
    return True, "unberührt und ohne Nachrichten"


ARTEN = {"text": 0, "sprache": 2}          # Discord-Kanaltypen


def d_eintraege(eintrag: dict) -> dict:
    """{"text": {...}, "sprache": {...}} - auch aus der alten, flachen Form
    (nur Textkanal, bis #244). Rein."""
    if "id" in eintrag:
        return {"text": eintrag}
    return {a: v for a, v in eintrag.items() if a in ARTEN and isinstance(v, dict)}


def sprach_belegung(z: dict) -> set:
    """IDs der Sprachkanaele, in denen gerade jemand ist (#244).

    Discords REST-API kennt keine Belegung von Sprachkanaelen - die gibt es nur
    ueber das Gateway. Deshalb eine kurze Gateway-Sitzung: anmelden mit den
    Intents GUILDS und GUILD_VOICE_STATES (beide NICHT privilegiert), das
    GUILD_CREATE des eigenen Servers abwarten, dessen voice_states lesen,
    trennen. Nur die Standardbibliothek - kein websocket-Paket auf der Maschine.
    Wirft DiscordFehler, wenn es nicht klappt; dann wird nichts geloescht.
    *Voice occupancy exists only on the Gateway: identify with the non-privileged
     GUILDS + GUILD_VOICE_STATES intents, read voice_states from GUILD_CREATE,
     disconnect. Stdlib only. Raises on failure, and then nothing is deleted.*
    """
    import base64
    import ssl
    import struct
    info = discord(z, "GET", "/gateway/bot") or {}
    host = str(info.get("url") or "wss://gateway.discord.gg").replace("wss://", "").strip("/")
    try:
        s = ssl.create_default_context().wrap_socket(socket.create_connection((host, 443), timeout=15),
                                                     server_hostname=host)
        s.settimeout(15)
    except OSError as e:
        raise DiscordFehler(f"Discord-Gateway nicht erreichbar ({e.__class__.__name__})")
    puffer = b""

    def lies(n: int) -> bytes:
        nonlocal puffer
        while len(puffer) < n:
            d = s.recv(65536)
            if not d:
                raise DiscordFehler("Discord-Gateway hat die Verbindung beendet")
            puffer += d
        raus, puffer = puffer[:n], puffer[n:]
        return raus

    def sende(op: int, nutz: bytes):
        maske = os.urandom(4)
        n = len(nutz)
        kopf = bytes([0x80 | op]) + (bytes([0x80 | n]) if n < 126 else
                                     bytes([0x80 | 126]) + struct.pack(">H", n) if n < 65536 else
                                     bytes([0x80 | 127]) + struct.pack(">Q", n))
        s.sendall(kopf + maske + bytes(b ^ maske[i % 4] for i, b in enumerate(nutz)))

    def nachricht():
        teile, op_erst = b"", None
        while True:
            b1, b2 = lies(2)
            op, n = b1 & 0x0F, b2 & 0x7F
            n = struct.unpack(">H", lies(2))[0] if n == 126 else struct.unpack(">Q", lies(8))[0] if n == 127 else n
            daten = lies(n)
            if op == 9:                              # Ping -> Pong
                sende(10, daten)
                continue
            if op == 8:
                raise DiscordFehler(f"Discord-Gateway schliesst ({struct.unpack('>H', daten[:2])[0] if len(daten) >= 2 else '?'})")
            op_erst = op_erst or op
            teile += daten
            if b1 & 0x80:
                return json.loads(teile.decode("utf-8", "replace"))

    try:
        schluessel = base64.b64encode(os.urandom(16)).decode()
        s.sendall((f"GET /?v=10&encoding=json HTTP/1.1\r\nHost: {host}\r\nUpgrade: websocket\r\n"
                   f"Connection: Upgrade\r\nSec-WebSocket-Key: {schluessel}\r\nSec-WebSocket-Version: 13\r\n"
                   "User-Agent: DiscordBot (platzwart, 1)\r\n\r\n").encode())
        while b"\r\n\r\n" not in puffer:
            d = s.recv(4096)
            if not d:
                raise DiscordFehler("Discord-Gateway: kein Handshake")
            puffer += d
        kopf, puffer = puffer.split(b"\r\n\r\n", 1)
        if b" 101 " not in kopf.split(b"\r\n", 1)[0]:
            raise DiscordFehler("Discord-Gateway: Handshake abgelehnt")
        frist = time.time() + 20
        while time.time() < frist:
            m = nachricht()
            if m.get("op") == 10:
                sende(1, json.dumps({"op": 2, "d": {
                    "token": z["DISCORD_TOKEN"], "intents": (1 << 0) | (1 << 7),
                    "properties": {"os": "linux", "browser": "platzwart", "device": "platzwart"}}}).encode())
            elif m.get("op") == 9:
                raise DiscordFehler("Discord-Gateway: Sitzung abgelehnt")
            elif m.get("op") == 0 and m.get("t") == "GUILD_CREATE" and str((m.get("d") or {}).get("id")) == str(z.get("DISCORD_GUILD")):
                return {str(v["channel_id"]) for v in m["d"].get("voice_states", []) if v.get("channel_id")}
        raise DiscordFehler("Discord-Gateway: keine Serverdaten erhalten")
    except (OSError, ValueError, struct.error) as e:
        raise DiscordFehler(f"Discord-Gateway: {e.__class__.__name__}")
    finally:
        try:
            sende(8, struct.pack(">H", 1000))
            s.close()
        except OSError:
            pass


def abgleich_discord() -> int:
    e = einstellung_discord()
    if not e["an"]:
        print("ok\tDiscord-Kanaele sind aus")
        return 0
    zu = lies_json(ZUORDNUNG, {})
    dc = zu.setdefault("discord", {})
    von = {k: d_eintraege(v) for k, v in dc.items() if not k.startswith("_")}
    da = server()
    # Fehlend ist, wo ein Server keinen Text- ODER keinen Sprachkanal hat - so
    # bekommen auch Server aus der Zeit vor #244 ihren Sprachkanal nachgereicht.
    # *Missing = a server lacks its text OR voice channel; older ones get voice added.*
    fehlend = [(s, a) for s in da for a in ARTEN if a not in von.get(s, {})]
    weg = [s for s in von if s not in da]
    neu_name = umzubenennen({s: v for s, v in von.items() if s in da},
                            {(s, a): (d_name(kanalname(e["muster"], da[s])) if a == "text" else kanalname(e["muster"], da[s]))
                             for s in da for a in ARTEN})
    if not fehlend and not weg and not neu_name:
        print("ok\tDiscord: nichts zu tun")
        return 0
    z = discord_zugang()
    g = z.get("DISCORD_GUILD", "")
    angelegt, geloescht, stehen, spaeter = [], [], [], []
    try:
        if not re.fullmatch(r"[0-9]{15,22}", g):
            raise DiscordFehler("keine gueltige Discord-Server-ID hinterlegt")
        liste = discord(z, "GET", f"/guilds/{g}/channels")
        if isinstance(liste, dict):
            raise DiscordFehler("Discord-Server nicht gefunden oder Bot nicht Mitglied")
        kanaele = {c["id"]: c for c in liste}
        kat = dc.get("_kategorie") or {}
        if kat.get("id") not in kanaele:
            treffer = [c for c in liste if c.get("type") == 4 and c.get("name", "").casefold() == e["kategorie"].casefold()]
            if treffer:
                kat = {"id": treffer[0]["id"], "name": treffer[0]["name"]}
            elif fehlend:
                r = discord(z, "POST", f"/guilds/{g}/channels", {"name": e["kategorie"], "type": 4})
                kat = {"id": r["id"], "name": r["name"]}
                protokoll("Discord-Kategorie angelegt", e["kategorie"], id=r["id"])
            dc["_kategorie"] = kat
        for s, art in fehlend:
            name = kanalname(e["muster"], da[s])
            vergleich = d_name(name) if art == "text" else name
            eintrag = von.setdefault(s, {})
            gleich = [c for c in liste if c.get("type") == ARTEN[art] and c.get("parent_id") == kat.get("id")
                      and c.get("name") == vergleich]
            if gleich:
                eintrag[art] = {"id": gleich[0]["id"], "name": gleich[0]["name"], "parent": kat["id"],
                                "fremd": True, "seit": int(time.time())}
                protokoll("Discord-Kanal vorgefunden (nicht angelegt, wird nie geloescht)", s,
                          name=gleich[0]["name"], art=art)
            else:
                time.sleep(PAUSE)
                daten = {"name": name, "type": ARTEN[art], "parent_id": kat["id"]}
                if art == "text":
                    daten["topic"] = f"Angelegt von Platzwart für {da[s]}"
                r = discord(z, "POST", f"/guilds/{g}/channels", daten)
                eintrag[art] = {"id": r["id"], "name": r["name"], "parent": r.get("parent_id"),
                                "rechte": d_rechte(r), "seit": int(time.time())}
                angelegt.append(("🔊 " if art == "sprache" else "#") + r["name"])
                protokoll("Discord-Kanal angelegt", s, name=r["name"], id=r["id"], art=art)
            dc[s] = eintrag
        for s, art, eintrag, ziel in neu_name:
            k = kanaele.get(str(eintrag.get("id")))
            if not k or k.get("name") != eintrag.get("name"):
                continue                     # weg oder von Hand umbenannt: der Mensch gewinnt
            time.sleep(PAUSE)
            r = discord(z, "PATCH", f"/channels/{eintrag['id']}", {"name": ziel})
            protokoll("Discord-Kanal umbenannt", s, alt=eintrag["name"], name=r.get("name", ziel), art=art)
            angelegt.append(f"{eintrag['name']} -> {r.get('name', ziel)}")
            eintrag["name"] = r.get("name", ziel)
            dc[s] = von[s]
        # Belegung nur messen, wenn ein Sprachkanal zum Loeschen ansteht.
        belegt = None
        if any("sprache" in von[s] for s in weg):
            try:
                belegt = sprach_belegung(z)
            except DiscordFehler as f:
                print(f"Hinweis: Belegung der Sprachkanaele nicht messbar - {f}", file=sys.stderr)
        for s in weg:
            for art, eintrag in list(von[s].items()):
                loeschen, grund = urteil_discord(eintrag, kanaele.get(str(eintrag.get("id"))) or {"_fehlt": True}, belegt)
                if loeschen:
                    time.sleep(PAUSE)
                    discord(z, "DELETE", f"/channels/{eintrag['id']}")
                    geloescht.append(("🔊 " if art == "sprache" else "#") + eintrag["name"])
                    protokoll("Discord-Kanal geloescht", s, name=eintrag["name"], art=art, grund=grund)
                elif grund == "Belegung nicht messbar":
                    spaeter.append(eintrag["name"])      # bleibt zugeordnet, naechster Lauf
                    continue
                else:
                    stehen.append(f"{eintrag.get('name')} ({grund})")
                    protokoll("Discord-Kanal bleibt stehen", s, "nicht geloescht",
                              name=eintrag.get("name"), art=art, grund=grund)
                    zu.setdefault("verwaist", {}).setdefault("discord", {})[f"{s}:{art}"] = {
                        **eintrag, "grund": grund, "bis": int(time.time())}
                del von[s][art]
            if von[s]:
                dc[s] = von[s]
            else:
                del dc[s]
    except DiscordFehler as f:
        melden("Discord-Kanaele: Abgleich gescheitert", str(f))
        print(f"FEHLER: {f}", file=sys.stderr)
        schreibe_json(ZUORDNUNG, zu)
        return 1
    schreibe_json(ZUORDNUNG, zu)
    if stehen:
        melden("Discord-Kanal nicht geloescht",
               "Der Server ist entfernt, sein Kanal bleibt stehen, weil ihn ein Mensch zu seinem "
               "gemacht hat, Nachrichten darin stehen oder jemand drin ist:\n" + "\n".join(stehen))
    print("ok\tDiscord: " + ("; ".join(x for x in [
        f"angelegt/umbenannt: {', '.join(angelegt)}" if angelegt else "",
        f"geloescht: {', '.join(geloescht)}" if geloescht else "",
        f"stehen gelassen: {', '.join(stehen)}" if stehen else "",
        f"Belegung nicht messbar, spaeter: {', '.join(spaeter)}" if spaeter else ""] if x) or "erledigt"))
    return 0


def abgleich() -> int:
    """Beide Dienste, unabhaengig: Faellt einer aus, laeuft der andere trotzdem."""
    return max(abgleich_ts(), abgleich_discord())


def vorschau_discord(stack: str):
    e = einstellung_discord()
    roh = (lies_json(ZUORDNUNG, {}).get("discord") or {}).get(stack)
    if not roh:
        return
    eintraege = d_eintraege(roh)
    for art, eintrag in eintraege.items():
        zeichen = "Sprachkanal 🔊 " if art == "sprache" else "Kanal #"
        if not e["an"]:
            print(f"bleibt\tDiscord-{zeichen}{eintrag['name']} bleibt stehen - die Kanalverwaltung ist ausgeschaltet.")
            continue
        try:
            k = discord(discord_zugang(), "GET", f"/channels/{eintrag['id']}")
        except DiscordFehler as f:
            print(f"unbekannt\tDiscord-{zeichen}{eintrag['name']}: gerade nicht prüfbar ({f}).")
            continue
        # Die Belegung eines Sprachkanals kennt nur das Gateway - fuer die
        # Vorschau zu teuer. Sie sagt deshalb, dass beim Abgleich geprueft wird.
        # *Occupancy needs the Gateway - too costly for the preview.*
        loeschen, grund = urteil_discord(eintrag, k, set())
        if loeschen:
            nachsatz = " - sitzt dann jemand drin, bleibt er stehen" if art == "sprache" else ""
            print(f"weg\tDiscord-{zeichen}{eintrag['name']} wird mit gelöscht ({grund}{nachsatz}).")
        else:
            print(f"bleibt\tDiscord-{zeichen}{eintrag['name']} bleibt stehen: {grund}.")


def vorschau(stack: str) -> int:
    """Je Dienst eine Zeile fuer die Bestaetigungsseite - was geschieht mit dem Kanal?"""
    if not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?", stack):
        print("FEHLER: unzulaessiger Name", file=sys.stderr)
        return 1
    vorschau_ts(stack)
    vorschau_discord(stack)
    return 0


def vorschau_ts(stack: str):
    e = einstellung()
    eintrag = (lies_json(ZUORDNUNG, {}).get("teamspeak") or {}).get(stack)
    if not eintrag:
        return 0
    if not e["an"]:
        print(f"bleibt\tTeamSpeak-Kanal „{eintrag['name']}“ bleibt stehen - die Kanalverwaltung ist ausgeschaltet.")
        return 0
    try:
        q = verbinden(zugang())
        try:
            kanaele = {v["cid"]: v for v in q.befehl("channellist")}
        finally:
            q.zu()
    except QueryFehler as f:
        print(f"unbekannt\tTeamSpeak-Kanal „{eintrag['name']}“: gerade nicht prüfbar ({f}). "
              "Gelöscht wird er nur, wenn er beim Abgleich unberührt und leer ist.")
        return 0
    loeschen, grund = urteil_entfernen(eintrag, kanaele)
    if loeschen:
        print(f"weg\tTeamSpeak-Kanal „{eintrag['name']}“ wird mit gelöscht ({grund}).")
    else:
        print(f"bleibt\tTeamSpeak-Kanal „{eintrag['name']}“ bleibt stehen: {grund}.")
    return 0


def pruefen() -> int:
    """Zugang pruefen, ohne ihn zu speichern - Benutzer und Passwort ueber stdin."""
    zeilen = sys.stdin.read().splitlines()
    if len(zeilen) < 2:
        print("FEHLER: Benutzer und Passwort erwartet", file=sys.stderr)
        return 1
    z = zugang()
    z["TS_USER"], z["TS_PASS"] = zeilen[0].strip(), zeilen[1]
    try:
        q = verbinden(z)
        q.befehl("whoami")
        q.zu()
    except QueryFehler as f:
        print(f"FEHLER: {f}", file=sys.stderr)
        return 1
    print("ok\tAnmeldung bei TeamSpeak erfolgreich")
    return 0


def pruefen_discord() -> int:
    """Discord-Bot pruefen, ohne zu speichern - Token und Server-ID ueber stdin.
    Verlangt: Bot ist Mitglied des Servers und darf Kanaele verwalten."""
    zeilen = sys.stdin.read().splitlines()
    if len(zeilen) < 2 or not re.fullmatch(r"[0-9]{15,22}", zeilen[1].strip()):
        print("FEHLER: Token und eine Server-ID (Ziffern) erwartet", file=sys.stderr)
        return 1
    z = {"DISCORD_TOKEN": zeilen[0].strip(), "DISCORD_GUILD": zeilen[1].strip()}
    try:
        ich = discord(z, "GET", "/users/@me")
        if not isinstance(ich, dict) or not ich.get("bot"):
            raise DiscordFehler("das ist kein Bot-Token")
        g = discord(z, "GET", f"/guilds/{z['DISCORD_GUILD']}")
        if g.get("_fehlt"):
            raise DiscordFehler("der Bot ist auf diesem Discord-Server nicht Mitglied")
        mitglied = discord(z, "GET", f"/guilds/{z['DISCORD_GUILD']}/members/{ich['id']}")
        rollen = {r["id"]: int(r["permissions"]) for r in discord(z, "GET", f"/guilds/{z['DISCORD_GUILD']}/roles")}
        rechte = rollen.get(z["DISCORD_GUILD"], 0)
        for r in mitglied.get("roles", []):
            rechte |= rollen.get(r, 0)
        admin, kanaele = bool(rechte >> 3 & 1), bool(rechte >> 4 & 1)
        if not (admin or kanaele):
            raise DiscordFehler("dem Bot fehlt das Recht 'Kanaele verwalten'")
    except DiscordFehler as f:
        print(f"FEHLER: {f}", file=sys.stderr)
        return 1
    print(f"ok\tBot {ich.get('username')} auf {g.get('name')}" + (" (Administrator)" if admin else ""))
    return 0


def selbsttest() -> int:
    schlecht = 0

    def pruef(name, ok):
        nonlocal schlecht
        schlecht += not ok
        print(f"  {'ok  ' if ok else 'FEHLER'} {name}")

    roh = "Valheim / Mitte|Nord\\x"
    pruef("Maskierung hin und zurueck", ts_unesc(ts_esc(roh)) == roh)
    pruef("Maskierung Leerzeichen/Pipe/Slash", ts_esc("a b|c/d") == "a\\sb\\pc\\/d")
    pruef("zerlegen", zerlegen("cid=5 pid=0 channel_name=Spiele\\sserver|cid=6 pid=5 channel_name=A")
          == [{"cid": "5", "pid": "0", "channel_name": "Spiele server"}, {"cid": "6", "pid": "5", "channel_name": "A"}])
    pruef("Namensmuster", kanalname("🎮 {name}", "Valheim") == "🎮 Valheim")
    pruef("40 Zeichen", len(kanalname("{name}", "x" * 60)) == 40)
    e = {"cid": "7", "name": "Valheim", "cpid": "5"}
    k = {"5": {"channel_name": "Spieleserver", "pid": "0", "total_clients": "0"},
         "7": {"channel_name": "Valheim", "pid": "5", "total_clients": "0"}}
    pruef("unberuehrt -> loeschen", urteil_entfernen(e, k)[0] is True)
    pruef("umbenannt -> bleibt", urteil_entfernen(e, {**k, "7": {**k["7"], "channel_name": "Valheim-Clan"}})[0] is False)
    pruef("verschoben -> bleibt", urteil_entfernen(e, {**k, "7": {**k["7"], "pid": "1"}})[0] is False)
    pruef("besetzt -> bleibt", urteil_entfernen(e, {**k, "7": {**k["7"], "total_clients": "2"}})[0] is False)
    pruef("Unterkanal -> bleibt", urteil_entfernen(e, {**k, "9": {"channel_name": "AFK", "pid": "7", "total_clients": "0"}})[0] is False)
    pruef("fremd -> bleibt", urteil_entfernen({**e, "fremd": True}, k)[0] is False)
    pruef("weg -> nichts zu loeschen", urteil_entfernen(e, {"5": k["5"]})[0] is False)
    pruef("Discord-Name", d_name("🎮 Valheim  Nord") == "🎮-valheim-nord")
    de = {"id": "11", "name": "valheim", "parent": "10", "rechte": []}
    dk = {"id": "11", "name": "valheim", "parent_id": "10", "permission_overwrites": [], "last_message_id": None}
    pruef("Discord unberuehrt -> loeschen", urteil_discord(de, dk)[0] is True)
    pruef("Discord Nachricht -> bleibt", urteil_discord(de, {**dk, "last_message_id": "99"})[0] is False)
    pruef("Discord umbenannt -> bleibt", urteil_discord(de, {**dk, "name": "valheim-clan"})[0] is False)
    pruef("Discord verschoben -> bleibt", urteil_discord(de, {**dk, "parent_id": "12"})[0] is False)
    pruef("Discord Rechte -> bleibt", urteil_discord(de, {**dk, "permission_overwrites": [
        {"id": "5", "type": 0, "allow": "0", "deny": "1024"}]})[0] is False)
    pruef("Discord weg -> nichts", urteil_discord(de, {"_fehlt": True})[0] is False)
    pruef("Discord fremd -> bleibt", urteil_discord({**de, "fremd": True}, dk)[0] is False)
    sk = {**dk, "id": "12", "type": 2}
    se = {**de, "id": "12"}
    pruef("Sprachkanal leer -> loeschen", urteil_discord(se, sk, set())[0] is True)
    pruef("Sprachkanal besetzt -> bleibt", urteil_discord(se, sk, {"12"}) == (False, "es ist gerade jemand drin"))
    pruef("Sprachkanal Belegung unbekannt -> bleibt", urteil_discord(se, sk, None) == (False, "Belegung nicht messbar"))
    pruef("alte flache Form -> Textkanal", d_eintraege(de) == {"text": de})
    pruef("neue Form", d_eintraege({"text": de, "sprache": se}) == {"text": de, "sprache": se})
    pruef("Anzeigename panel.json", anzeigename("valheim", {"name": "Valheim"}, {}) == "Valheim")
    pruef("Anzeigename Katalog", anzeigename("x", {}, {"x": "Xonotic"}) == "Xonotic")
    pruef("Anzeigename gross", anzeigename("enshrouded", {}, {}) == "Enshrouded")
    u = umzubenennen({"a": {"sprache": {"name": "enshrouded"}}, "b": {"sprache": {"name": "Palworld"}},
                      "c": {"sprache": {"name": "x", "fremd": True}}},
                     {("a", "sprache"): "Enshrouded", ("b", "sprache"): "Palworld", ("c", "sprache"): "X"})
    pruef("umzubenennen: nur abweichende, nie fremde", [(s, z) for s, _, _, z in u] == [("a", "Enshrouded")])
    print("alles gruen." if not schlecht else f"{schlecht} FEHLER")
    return 1 if schlecht else 0


def main(a: list) -> int:
    if a[:1] == ["--selbsttest"]:
        return selbsttest()
    if a[:1] == ["vorschau"] and len(a) == 2:
        return vorschau(a[1])
    if a[:1] == ["pruefen"]:
        return pruefen()
    if a[:1] == ["pruefen-discord"]:
        return pruefen_discord()
    if a[:1] == ["abgleich"]:
        with open(SPERRE, "a") as sperre:
            fcntl.flock(sperre, fcntl.LOCK_EX)
            return abgleich()
    print(__doc__.split("==")[0].strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
