#!/usr/bin/env python3
"""katalogbilder-holen — besorgt die Titelbilder fuer die Katalogseite.

Warum es das gibt: Die Katalogseite zeigt Bilder aus /opt/panel/bilder/katalog.
Dieses Verzeichnis wurde bisher von KEINEM Skript gefuellt - die Bilder waren
einmal von Hand geladen worden. Nach einem Neuaufbau nach install/ waere die
Seite vollstaendig bildlos gewesen, ohne dass etwas darauf hinweist. Aufgefallen
am 2026-09-07, als bei Minecraft das Bild fehlte und sich beim Nachsehen
herausstellte, dass 39 von 41 Bildern nur zufaellig da waren.

*Why this exists: the catalogue page shows images from a directory no script
 ever populated - they had been fetched by hand once. After a rebuild from
 install/ the page would have been entirely image-less, with nothing indicating
 why. Found when Minecraft's artwork was missing and it turned out the other 39
 were there only by accident.*

Steam-Header sind Werke Dritter und liegen deshalb NICHT im Repositorium,
sondern werden hier zur Laufzeit geholt. Spiele ohne Steam-Eintrag ("appid": 0)
bekommen das selbst gezeichnete Bild aus /opt/panel/bilder/eigene.

  katalogbilder-holen              fehlende Bilder holen
  katalogbilder-holen --alle       auch vorhandene neu holen
  katalogbilder-holen --pruefen    nur berichten, nichts holen (Exit 1 = Luecken)
"""
import json, shutil, sys, urllib.request
from pathlib import Path

KATALOG = Path("/etc/spiele-katalog.json")
ZIEL    = Path("/opt/panel/bilder/katalog")
EIGENE  = Path("/opt/panel/bilder/eigene")
URL     = "https://cdn.cloudflare.steamstatic.com/steam/apps/{}/header.jpg"


def hole(appid: int) -> bytes | None:
    try:
        with urllib.request.urlopen(URL.format(appid), timeout=20) as r:
            d = r.read()
        # Steam antwortet auf unbekannte IDs mit einer winzigen Platzhalterdatei
        # statt mit 404 - die Groesse ist hier das verlaesslichere Kriterium.
        # *Steam answers unknown ids with a tiny placeholder rather than a 404,
        #  so size is the more reliable test.*
        return d if len(d) > 2000 else None
    except Exception:
        return None


def main():
    alle    = "--alle" in sys.argv
    pruefen = "--pruefen" in sys.argv
    spiele  = json.loads(KATALOG.read_text())["spiele"]
    ZIEL.mkdir(parents=True, exist_ok=True)

    geholt = eigen = vorhanden = fehlt = 0
    luecken = []
    for g in spiele:
        s = g["schluessel"]
        ziel = ZIEL / f"{s}.jpg"
        if ziel.is_file() and not alle:
            vorhanden += 1
            continue
        if pruefen:
            fehlt += 1; luecken.append(s); continue

        daten = hole(g["appid"]) if g.get("appid") else None
        if daten:
            ziel.write_bytes(daten); geholt += 1
        elif (EIGENE / f"{s}.jpg").is_file():
            shutil.copyfile(EIGENE / f"{s}.jpg", ziel); eigen += 1
        else:
            fehlt += 1; luecken.append(s); continue
        try:
            shutil.chown(ziel, "panel", "panel"); ziel.chmod(0o644)
        except (PermissionError, LookupError):
            pass

    if pruefen:
        print(f"{vorhanden} vorhanden, {fehlt} fehlen" + (": " + ", ".join(luecken) if luecken else ""))
        return 1 if fehlt else 0

    print(f"{geholt} von Steam geholt, {eigen} aus dem eigenen Vorrat, "
          f"{vorhanden} schon da, {fehlt} ohne Bild"
          + (" (" + ", ".join(luecken) + ")" if luecken else ""))
    # Ein fehlendes Bild ist kein Fehler - die Kachel bleibt blass, alles
    # andere funktioniert. Gemeldet wird es trotzdem.
    return 0


if __name__ == "__main__":
    sys.exit(main())
