#!/usr/bin/env python3
"""platzwart-wache — sieht nach, was gerade nicht stimmt, und meldet Aenderungen.

Der Fall, gegen den das gebaut ist: Ein Server stirbt Samstagnacht um drei. Die
Sicherung laeuft weiter, das Panel zeigt ihn grau, und niemand sieht hin. Bisher
fiel das montags auf, wenn eine Pruefung auf einem Desktop lief.

*A server dies at three on Saturday morning. Backups keep running, the panel
 shows it greyed out, and nobody looks. Until now that surfaced on Monday.*

Gemeldet werden **Aenderungen**, nicht Zustaende. Der Lauf vergleicht die Lage
mit der des letzten Laufs:

  neu dazugekommen  -> Stoerung
  weggefallen       -> Entwarnung
  unveraendert      -> nichts

Das ist der Unterschied zwischen einem Melder, dem man glaubt, und einem, den
man nach drei Tagen stummschaltet. Ein Timer alle fuenf Minuten, der jedes Mal
dieselbe Stoerung schickt, ist nach einem Tag 288-mal dasselbe.

Die Entwarnung ist dabei nicht Zierat: Ein Alarm, dessen Ende man nicht sieht,
wird zum Dauerzustand - man weiss nie, ob das Problem noch besteht.

*Changes are reported, not states: newly appeared is a fault, disappeared is an
 all-clear, unchanged is silence. The all-clear matters - an alarm whose end is
 invisible becomes permanent.*

  platzwart-wache [--trocken] [--selbsttest]

Exit: 0 = nichts Neues oder gemeldet, 1 = Fehler beim Melden.
"""
import datetime
import glob
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

ZUSTAND = Path("/var/lib/platzwart-wache.zustand")
STACKS = Path("/opt/stacks")
MELDEN = "/usr/local/bin/platzwart-melden"
PLATTE_WARN = int(os.environ.get("WACHE_PLATTE_WARN", "85"))
SPEICHER_WARN = int(os.environ.get("WACHE_SPEICHER_WARN", "85"))
NEUSTART_WARN = int(os.environ.get("WACHE_NEUSTART_WARN", "3"))
FRISCH_MIN = int(os.environ.get("WACHE_FRISCH_MIN", "10"))    # Minuten

# Beendet mit 0 = sauber angehalten, 143 = SIGTERM (also "docker stop", ein
# ausdruecklicher Befehl). Alles andere ist ein Absturz - 137 ist SIGKILL und
# damit der OOM-Killer, genau das Bild, an dem StarRupture starb.
# *0 is a clean stop, 143 is SIGTERM (an explicit "docker stop"). Everything
#  else crashed; 137 is SIGKILL, i.e. the OOM killer.*
HARMLOS = {0, 143}

# --- Spiele, deren Passwort NICHT aus der compose-Datei kommt ----------------
# Gemessen am 2026-09-12 (#286): Palworlds Abbild bekommt
# DISABLE_GENERATE_SETTINGS=true, damit es die von Nitrado uebernommenen
# Einstellungen nicht neu schreibt. Damit wendet es AUCH keine Env-Werte mehr
# an - start.sh sagt es selbst: "Env vars will not be applied". Wirksam sind
# nur PORT, QUERY_PORT und COMMUNITY (Startargumente); Name, Spielerzahl und
# beide Passwoerter stehen allein in der ini. Heute stimmen compose und ini
# ueberein, weil jemand sie von Hand gleichzog - nichts haelt sie so. Und fehlt
# die ini, legt das Abbild DefaultPalWorldSettings.ini an: ohne Passwort, bei
# offenem Spielport. Genau das verbietet E26.
# *Measured: with DISABLE_GENERATE_SETTINGS the image applies no env vars at
#  all, so name, player cap and both passwords live only in the ini. compose and
#  ini agree today because someone aligned them by hand, and nothing keeps them
#  that way. A missing ini is replaced by the password-less default while the
#  game port is open - exactly what E26 forbids.*
# Je Server: woran haengt sein Schutz, und wie laesst er sich messen? Der
# Eintrag ist Pflicht (vollstaendigkeit.sh prueft es), damit ein neuer
# handgebauter Stack eine Entscheidung erzwingt statt lautlos durchzurutschen -
# die Einrichtungspruefung unten sah nur Server mit panel.json an, also einen
# von sieben (#289).
#   "umgebung"    - das Abbild wendet die compose-Umgebung an; dort muss das
#                   Feld gesetzt und nicht leer sein.
#   "konfig"      - es gilt eine eigene Konfigurationsdatei (siehe oben).
#   "unbestimmt"  - von aussen nicht messbar. Meldet NIE, braucht aber einen
#                   Grund: Ein unbeantwortbarer Fall soll benannt sein, nicht
#                   vergessen. Eine Dauermeldung waere Laerm und keine Pruefung.
# *Per server: what its protection hangs on and how to measure it. The entry is
#  mandatory (checked by vollstaendigkeit.sh) so a new hand-built stack forces a
#  decision instead of slipping through - the setup check below only looked at
#  servers with a panel.json, one of seven (#289). "unbestimmt" never reports
#  but must carry a reason: an unanswerable case should be named, not forgotten.*
SCHUTZ = {
    "enshrouded": {"art": "umgebung", "feld": "SERVER_ROLE_1_PASSWORD",
                   "was": "Beitrittspasswort der Rolle \"Freunde\""},
    "foundry": {"art": "umgebung", "feld": "SERVER_PWD", "was": "Beitrittspasswort"},
    "palworld": {
        "art": "konfig",
        "datei": "/srv/games/palworld/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini",
        "grund": "DISABLE_GENERATE_SETTINGS=true - das Abbild wendet keine Env-Werte an",
        "paare": [("Beitrittspasswort", "ServerPassword", "SERVER_PASSWORD"),
                  ("Adminpasswort", "AdminPassword", "ADMIN_PASSWORD")],
    },
    "satisfactory": {"art": "unbestimmt",
                     "grund": "Das Passwort wird im Spiel vergeben und liegt in "
                              "saved/ServerSettings.<port>.sav - eine Binaerdatei. "
                              "Der Spielport geht hier nur nach einer Freigabe von "
                              "Hand auf (#183)."},
    "teamspeak": {"art": "unbestimmt",
                  "grund": "Sprachserver ohne Beitrittspasswort (Katalog: art keins). "
                           "Ein Serverpasswort setzt man im Client; es liegt in der "
                           "TS3-Datenbank, nicht in einer lesbaren Konfiguration."},
    "valheim": {"art": "umgebung", "feld": "SRV_PWD", "was": "Beitrittspasswort"},
    "windrose": {"art": "umgebung", "feld": "SERVER_PASSWORD", "was": "Beitrittspasswort"},
}


def wert_ini(text: str, schluessel: str) -> str:
    m = re.search(rf'{schluessel}="([^"]*)"', text)
    return m.group(1) if m else ""


def wert_compose(text: str, schluessel: str) -> str:
    """Wert aus einer compose-Datei - BEIDE Schreibweisen der Umgebung.

    compose kennt `KEY: wert` (Abbildung) und `- KEY=wert` (Liste). Ein Muster
    fuer nur eine davon findet nichts und meldet damit "Passwort fehlt", wo
    eines steht: Enshrouded benutzt die Listenform. Genau daran ist am
    2026-09-12 schon eine Maske gescheitert, die ein Passwort durchliess.
    *compose has both a mapping and a list form; a pattern for one of them finds
     nothing and would report a missing password where one exists.*
    """
    m = re.search(rf'^\s*{schluessel}:\s*"?([^"\n]*)', text, re.M) or \
        re.search(rf'^\s*-\s*{schluessel}=\s*"?([^"\n]*)', text, re.M)
    return m.group(1).strip().rstrip('"') if m else ""


# Dateien, in denen Geheimnisse stehen KOENNEN - Passwoerter, Tokens, Schluessel.
# Die Liste ist bewusst nach Muster und nicht nach Einzeldatei: Was hier
# gefaehrlich wird, sind die Kopien, die nebenher entstehen
# (compose.yaml.bak-…, zugangsdaten.json.vor-…). Am 2026-09-12 lag genau eine
# solche Kopie auf 644 - inhaltlich harmlos, aber niemand haette es gemerkt.
# *Files that can hold secrets. Deliberately by pattern, not by name: the danger
#  is the copies that appear alongside. One such copy sat at 644, harmless by
#  content, and nobody would have noticed.*
GEHEIMNISTRAEGER = [
    "/opt/stacks/*/compose.yaml*",          # Spielpasswoerter im Klartext
    "/opt/stacks/*/panel.json*",            # dieselben, plus Einrichtungsstand
    "/opt/panel/daten/zugangsdaten.json*",  # von Hand gepflegte Zugangsdaten
    "/opt/panel/daten/nutzer.json*",        # Kontohashes und TOTP-Geheimnisse
    "/opt/panel/daten/*.conf*",             # Discord-, Steam- und TeamSpeak-Zugaenge
    "/opt/module/*/.env*",                  # u.a. das Grafana-Passwort
    "/etc/platzwart-melden.conf*",          # Webhooks
]
# Ausdruecklich NICHT dabei und mit Absicht 0644: audit.jsonl, netzstand.json
# und konfigzahlen.json. Die erste Fassung dieser Liste nahm alle *.json unter
# /opt/panel/daten und meldete deshalb sofort drei harmlose Dateien - ein
# Fehlalarm am ersten Tag ist der sicherste Weg, eine Pruefung wertlos zu machen.
# *Deliberately excluded, and deliberately 0644: the audit log, the network
#  state and the config counters. The first version of this list took every
#  *.json here and cried wolf on day one.*


def offen_befund(dateien: list) -> str:
    """Welche dieser Dateien darf jeder auf der Maschine lesen?

    `dateien` ist eine Liste (Pfad, Rechte-Bits), damit der Selbsttest sie
    erfinden kann. Gemeldet wird der Pfad, nie ein Inhalt.
    *A list of (path, mode) so the self-test can invent it; the path is
     reported, never any content.*
    """
    offen = sorted(pfad for pfad, modus in dateien if modus & 0o004)
    if not offen:
        return ""
    return ("Diese Dateien koennen Passwoerter enthalten und sind fuer **jeden** "
            "Benutzer der Maschine lesbar:\n\n"
            + "\n".join(f"- `{pfad}`" for pfad in offen[:12])
            + (f"\n- … und {len(offen) - 12} weitere" if len(offen) > 12 else "")
            + "\n\nMeist eine Kopie, die von Hand entstanden ist. Richtig sind 0600 "
              "(oder 0640 mit Gruppe panel):  chmod 600 <datei>")


def umgebung_befund(stack: str, regel: dict, compose: str) -> str:
    """Steht das Passwort, von dem der Schutz dieses Servers abhaengt, wirklich da?

    Nennt nie den Wert, nur ob er fehlt. *Never names the value.*
    """
    if not wert_compose(compose, regel["feld"]):
        return (f"**{stack}**: {regel['was']} fehlt in der compose-Datei "
                f"({regel['feld']} ist leer oder gar nicht gesetzt).\n\n"
                "Dieses Abbild nimmt das Passwort aus der Umgebung - ohne den Wert "
                "steht der Server ohne Passwort am offenen Port (E26).")
    return ""


def konfig_befund(stack: str, regel: dict, compose: str, ini) -> str:
    """Gilt fuer diesen Server wirklich, was in der compose-Datei steht?

    `ini` ist der Text der Spielkonfiguration oder None, wenn es sie nicht gibt.
    Gibt den Meldetext zurueck oder "" - und nennt **nie** einen Passwortwert,
    auch nicht gekuerzt: Diese Meldung geht nach Discord.

    *Does what the compose file says actually apply? Never names a password
     value - this text goes to Discord.*
    """
    if ini is None:
        return (f"**{stack}**: die Spielkonfiguration fehlt.\n\n"
                f"{regel['datei']}\n\n"
                "Beim naechsten Start legt das Abbild die Standardkonfiguration "
                "an - **ohne Passwort**, waehrend der Spielport offen ist (E26). "
                "Die Werte in der compose-Datei greifen hier nicht: "
                f"{regel['grund']}.")
    fehlend = [name for name, ik, _ in regel["paare"] if not wert_ini(ini, ik)]
    if fehlend:
        return (f"**{stack}**: {', '.join(fehlend)} ist in der "
                f"Spielkonfiguration leer.\n\n{regel['datei']}\n\n"
                "Die compose-Datei zaehlt hier nicht mit "
                f"({regel['grund']}) - der Server steht also ohne Passwort "
                "am offenen Port (E26).")
    ungleich = [name for name, ik, ck in regel["paare"]
                if wert_compose(compose, ck) and wert_ini(ini, ik) != wert_compose(compose, ck)]
    if ungleich:
        return (f"**{stack}**: {', '.join(ungleich)} steht in der compose-Datei "
                "anders als in der Spielkonfiguration.\n\n"
                f"Es gilt {regel['datei']} ({regel['grund']}); das Panel zeigt "
                "aber die compose-Datei an. Wer das angezeigte Passwort "
                "eingibt, kommt nicht herein.")
    return ""


def sh(*a) -> str:
    try:
        return subprocess.run(a, capture_output=True, text=True, timeout=60).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def meminfo() -> tuple[int, int]:
    """(MemTotal, MemAvailable) in KiB - (0, 0), wenn /proc nicht lesbar ist.

    MemAvailable und nicht MemFree: der Seitencache steht unter MemFree nicht
    als frei, ist aber jederzeit einloesbar. Eine Pruefung gegen MemFree
    schlaegt deshalb im Normalbetrieb an, und ein Melder, der immer meldet,
    wird nach einer Woche stummgeschaltet. docs/08 liest aus demselben Grund
    Spalte 7 von `free -m`.
    """
    werte = {}
    try:
        for z in Path("/proc/meminfo").read_text().splitlines():
            name, _, rest = z.partition(":")
            if name in ("MemTotal", "MemAvailable"):
                werte[name] = int(rest.split()[0])
    except (OSError, ValueError, IndexError):
        return 0, 0
    return werte.get("MemTotal", 0), werte.get("MemAvailable", 0)


def grenzen_laufend() -> tuple[int, int]:
    """(Summe der mem_limits laufender Container in Bytes, Zahl ohne Grenze).

    Ueber `docker ps` und nicht ueber den Katalog: satisfactory, windrose und
    foundry sind von Hand gebaut, haben keine panel.json und gehen an jeder
    Katalogpruefung vorbei - sie stellen aber 24 der 47 G. Genau diese Tuer
    laesst `spiel-verwalten` offen, das den freien Speicher nur vor einer
    Katalog-Installation prueft.

    HostConfig.Memory ist 0, wenn der Container keine Grenze hat. Das als
    "nimmt nichts" zu zaehlen waere die falsche Richtung - ein Container ohne
    Grenze darf alles nehmen, was da ist -, deshalb wird er getrennt gezaehlt
    und im Meldungstext genannt.
    """
    ids = sh("docker", "ps", "-q").split()
    if not ids:
        return 0, 0
    summe = ohne = 0
    for z in sh("docker", "inspect", "--format", "{{.HostConfig.Memory}}",
                *ids).split():
        try:
            g = int(z)
        except ValueError:
            continue
        if g > 0:
            summe += g
        else:
            ohne += 1
    return summe, ohne


def speicher_befund(gesamt_kib: int, verfuegbar_kib: int, grenzen: int,
                    ohne_grenze: int,
                    schwelle: int = SPEICHER_WARN) -> str | None:
    """Wird der Arbeitsspeicher knapp? Meldungstext oder None.

    Getrennt von lage(), damit --selbsttest sie mit erfundenen Zahlen
    durchspielen kann. Ohne den Nachweis, dass sie auch anschlaegt, waere sie
    eine Vermutung.

    Gemessen wird der TATSAECHLICH belegte Speicher, nicht die Summe der
    Grenzen. Die Summe uebersteigt den RAM dauerhaft und mit Absicht (docs/08,
    "Speicher: die Grenzen sind ueberbucht"); ein Alarm darauf staende an
    jedem einzelnen Tag im Kanal. Die Summe gehoert trotzdem in den Text: sie
    beantwortet die Frage, die man sich in dem Moment stellt - wie viel
    duerften die laufenden Server noch nehmen, wenn es jetzt schon eng ist.
    """
    if gesamt_kib <= 0:
        return None
    belegt = round((gesamt_kib - verfuegbar_kib) * 100 / gesamt_kib)
    if belegt < schwelle:
        return None
    t = (f"Der Arbeitsspeicher ist zu **{belegt} %** belegt "
         f"(Schwelle {schwelle} %). Verfuegbar sind noch "
         f"{verfuegbar_kib / 1024 / 1024:.1f} GiB von "
         f"{gesamt_kib / 1024 / 1024:.1f} GiB.\n\n")
    if grenzen:
        t += (f"Die laufenden Container duerfen zusammen "
              f"{grenzen / 1024 ** 3:.0f} GiB nehmen")
        t += f", dazu {ohne_grenze} ohne jede Grenze" if ohne_grenze else ""
        t += ".\n\n"
    elif ohne_grenze:
        t += f"Kein laufender Container hat eine Grenze ({ohne_grenze} Stueck).\n\n"
    t += ("Wird es eng, greift **nicht** die saubere Container-Grenze, sondern "
          "der OOM-Killer der Maschine - und der trifft nicht unbedingt den, "
          "der gewachsen ist. So starb StarRupture.")
    return t


def container_lage() -> list:
    """(Name, laeuft, restarting, Neustarts, Minuten seit Start, Gesundheit).

    Ueber docker inspect und nicht ueber "docker ps --filter status=exited":
    Der Filter findet eine Neustartschleife NICHT. Ein Container, den
    restart=always sofort wieder hochzieht, steht nur Sekundenbruchteile auf
    "exited" und die uebrige Zeit auf "restarting" - und ein Container mit
    kaputtem Gesundheitstest steht die ganze Zeit auf "running".
    """
    ids = sh("docker", "ps", "-aq").split()
    if not ids:
        return []
    form = ("{{.Name}}\t{{.State.Running}}\t{{.State.Restarting}}\t{{.RestartCount}}"
            "\t{{.State.StartedAt}}\t{{if .State.Health}}{{.State.Health.Status}}{{else}}-{{end}}")
    raus = []
    for z in sh("docker", "inspect", "--format", form, *ids).splitlines():
        f = z.split("\t")
        if len(f) != 6:
            continue
        try:
            neustarts = int(f[3])
        except ValueError:
            continue
        seit_min = 10 ** 6
        try:
            s = f[4].split(".")[0].rstrip("Z")
            seit_min = int((time.time() - datetime.datetime.fromisoformat(s)
                            .replace(tzinfo=datetime.timezone.utc).timestamp()) / 60)
        except (ValueError, OverflowError, OSError):
            pass
        raus.append((f[0].lstrip("/"), f[1] == "true", f[2] == "true",
                     neustarts, seit_min, f[5]))
    return raus


def schleifen_befund(neustarts: int, seit_min: int, restarting: bool,
                     schwelle: int = NEUSTART_WARN,
                     frisch: int = FRISCH_MIN) -> bool:
    """Haengt der Container gerade in einer Neustartschleife?

    Getrennt von lage(), damit --selbsttest sie mit erfundenen Werten fahren
    kann - ohne den Nachweis, dass sie anschlaegt, waere sie eine Vermutung.

    ZWEI Bedingungen. RestartCount allein reicht nicht: Der Zaehler faellt nie
    wieder, ein Container, der vorletzte Woche fuenfmal abstuerzte und seither
    laeuft, stuende dauerhaft als Stoerung im Kanal - und ein Alarm, der nie
    endet, wird stummgeschaltet. Deshalb zusaetzlich: Er muss GERADE neu
    starten oder eben erst gestartet sein. Beruhigt er sich, waechst die
    Laufzeit ueber die Frist und die Entwarnung geht von selbst hinaus.

    RestartCount zaehlt nur, was die Neustartregel selbst ausgeloest hat - ein
    "docker restart" von Hand erhoeht ihn nicht. Der Zaehler beschreibt also
    Abstuerze, nicht Bedienung.

    *Two conditions. RestartCount alone never falls, so a container that
     crashed a fortnight ago would sit in the channel forever, and an alarm
     that never ends gets muted. So it must also be restarting right now or
     have started only just. RestartCount counts only policy restarts - a
     manual "docker restart" does not raise it.*
    """
    if neustarts < schwelle:
        return False
    return restarting or seit_min < frisch


# Die Dienste dieses Projekts. Sicherung, Einrichtung, Wache selbst, Panel.
EIGENE_UNITS = ["spiele-*", "platzwart-*", "spiel-*", "sicherung-*", "panel.service",
                "caddy.service", "ttyd.service", "palworld-neustart*"]


def lage() -> dict:
    """Was stimmt gerade nicht? Schluessel -> Text. Ein leeres Ergebnis heisst
    'alles in Ordnung' - und weil der Schluessel stabil ist, erkennt der
    Vergleich dieselbe Stoerung wieder, statt sie fuer neu zu halten."""
    funde = {}

    # --- Abgestuerzte Container ---------------------------------------------
    for z in sh("docker", "ps", "-a", "--filter", "status=exited",
                "--format", "{{.Names}}\t{{.Status}}").splitlines():
        if "\t" not in z:
            continue
        name, status = z.split("\t", 1)
        m = re.search(r"Exited \((\d+)\)", status)
        if not m or int(m.group(1)) in HARMLOS:
            continue
        code = int(m.group(1))
        wie = " (SIGKILL - sehr wahrscheinlich der OOM-Killer)" if code == 137 else ""
        funde[f"abgestuerzt:{name}"] = (
            f"**{name}** ist beendet mit Code {code}{wie}.\n\n"
            f"Docker sagt: {status}\n\n"
            f"Nachsehen mit:  docker logs --tail 50 {name}")

    # --- Neustartschleife und kaputter Gesundheitstest ------------------------
    # Beides ist der Wache bis zum 2026-09-10 entgangen, weil sie nur nach
    # "exited" sah. Gemessen auf einer Testmaschine: factorio lief zwanzig
    # Minuten in der Schleife und ahl2 sechsunddreissig Minuten "unhealthy" -
    # die Wache meldete keines von beiden (#158). Ein Container, der laeuft,
    # ist nicht dasselbe wie ein Server, der laeuft.
    for name, laeuft, restarting, neustarts, seit_min, gesund in container_lage():
        if schleifen_befund(neustarts, seit_min, restarting):
            funde[f"schleife:{name}"] = (
                f"**{name}** haengt in einer Neustartschleife: {neustarts} Neustarts, "
                f"zuletzt vor {seit_min} Minuten gestartet.\n\n"
                "Der Container laeuft also - der Server darin nicht. Genau das sieht "
                "weder das Panel noch die Abfrage der Spielerzahl.\n\n"
                f"Nachsehen mit:  docker logs --tail 50 {name}")
        elif laeuft and gesund == "unhealthy":
            funde[f"ungesund:{name}"] = (
                f"**{name}** meldet seinen eigenen Gesundheitstest als "
                "fehlgeschlagen.\n\n"
                "Der Container laeuft, aber das Abbild selbst sagt, dass darin "
                "etwas nicht stimmt - haeufig fehlende Spieldateien oder ein "
                "Serverprozess, der nicht startet.\n\n"
                f"Nachsehen mit:  docker logs --tail 50 {name}")

    # --- Platte --------------------------------------------------------------
    p = sh("df", "--output=pcent", "/").splitlines()
    if len(p) > 1:
        try:
            voll = int(p[1].strip().rstrip("%"))
            if voll >= PLATTE_WARN:
                funde["platte"] = (
                    f"Die Platte ist zu **{voll} %** belegt (Schwelle {PLATTE_WARN} %).\n\n"
                    "Laeuft sie voll, schlaegt als erstes die Sicherung fehl - "
                    "und damit faellt der Rueckweg weg, bevor etwas passiert.")
        except ValueError:
            pass

    # --- Arbeitsspeicher ------------------------------------------------------
    # Die Ueberbuchung der mem_limits ist Absicht, und was sie trug, war der
    # Satz "solange nicht alle Server gleichzeitig laufen". Gemessen laufen
    # alle sieben gleichzeitig - die Voraussetzung gilt nicht mehr, und
    # aufgefallen ist das niemandem, weil sie von nichts geprueft wurde. Eine
    # Annahme, die kein Melder kennt, hoert lautlos auf zu stimmen.
    gesamt, verfuegbar = meminfo()
    grenzen, ohne_grenze = grenzen_laufend()
    speicher = speicher_befund(gesamt, verfuegbar, grenzen, ohne_grenze)
    if speicher:
        funde["speicher"] = speicher

    # --- Server ohne Beitrittspasswort ---------------------------------------
    # E23: Das Veroeffentlichen des Ports ist der Schritt, der nach aussen
    # oeffnet. Ein Server, dessen Einrichtung dabei stehen blieb, steht offen -
    # das Panel warnt auf der Karte, aber nur, wenn jemand hinsieht.
    for f in sorted(STACKS.glob("*/panel.json")):
        try:
            d = json.loads(f.read_text())
        except (ValueError, OSError):
            continue
        if d.get("einrichtung_offen"):
            s = f.parent.name
            # Seit #156/E26 haelt die Installation die oeffentlichen Ports
            # zurueck, solange die Einrichtung offen ist. Hier stand "kann ohne
            # Beitrittspasswort erreichbar sein" - das alarmierte in die falsche
            # Richtung: Man suchte einen offenen Port, den es nicht gibt.
            # *Since #156 the public ports are held back while setup is open;
            #  the old wording alarmed in the wrong direction.*
            funde[f"offen:{s}"] = (
                f"**{s}**: die Einrichtung ist nicht abgeschlossen.\n\n"
                f"Stand: {str(d.get('einrichtung_stand', ''))[:200]}\n\n"
                "Solange das so steht, bleibt der Spielport zu - der Server ist "
                "fuer niemanden erreichbar (E26).")

    # --- Gilt, was in der compose-Datei steht? -------------------------------
    # Die Wache sah bisher nur Katalogserver mit panel.json an - das ist genau
    # einer von sieben. Handgebaute Stacks pruefte niemand (#286).
    # *The watchdog only looked at catalogue servers with a panel.json - one of
    #  seven. Hand-built stacks were checked by nobody.*
    for stack, regel in SCHUTZ.items():
        if regel["art"] == "unbestimmt":
            continue
        cdatei = STACKS / stack / "compose.yaml"
        if not cdatei.exists():
            continue
        try:
            compose = cdatei.read_text()
        except OSError:
            continue
        if regel["art"] == "umgebung":
            text = umgebung_befund(stack, regel, compose)
        else:
            idatei = Path(regel["datei"])
            try:
                ini = idatei.read_text() if idatei.exists() else None
            except OSError:
                continue
            text = konfig_befund(stack, regel, compose, ini)
        if text:
            funde[f"konfig:{stack}"] = text

    # --- Weltlesbare Geheimnistraeger ----------------------------------------
    gefunden = []
    for muster in GEHEIMNISTRAEGER:
        for name in glob.glob(muster):
            pfad = Path(name)
            try:
                if pfad.is_file() and not pfad.is_symlink():
                    gefunden.append((name, pfad.stat().st_mode & 0o777))
            except OSError:
                continue
    text = offen_befund(gefunden)
    if text:
        funde["weltlesbar"] = text

    # --- Fehlgeschlagene eigene Dienste ---------------------------------------
    # Am 2026-09-11 scheiterte die taegliche Vollsicherung an der Borg-Sperre,
    # und niemand erfuhr es: spiele-sicherung gibt nur "MIT FEHLERN" aus, und
    # diese Wache sah Container, Platte und Speicher - aber keine Dienste. Ein
    # fehlgeschlagener Dienst bleibt "failed", bis er wieder gelingt; der
    # Zustandsvergleich meldet also das Scheitern einmal und das Gelingen als
    # "erledigt". Nur die eigenen Muster, nicht das ganze System.
    # *The daily full backup failed on the lock on 2026-09-11 and nobody heard.
    #  A failed unit stays failed until it succeeds again, so the state
    #  comparison reports the failure once and the recovery as resolved.*
    r = subprocess.run(["systemctl", "list-units", "--failed", "--plain", "--no-legend",
                        *EIGENE_UNITS], capture_output=True, text=True)
    for z in r.stdout.splitlines():
        unit = z.split()[0] if z.split() else ""
        if not unit:
            continue
        log = subprocess.run(["journalctl", "-u", unit, "-n", "4", "--no-pager", "-o", "cat"],
                             capture_output=True, text=True).stdout.strip()
        funde[f"dienst:{unit}"] = (
            f"**{unit}** ist fehlgeschlagen.\n\n```\n{log[-600:]}\n```\n"
            f"Nachsehen:  journalctl -u {unit} -n 50")
    return funde


def melden(stufe: str, titel: str, text: str, trocken: bool) -> bool:
    if trocken:
        print(f"  [{stufe}] {titel}")
        return True
    r = subprocess.run([MELDEN, stufe, titel, text], capture_output=True, text=True)
    return r.returncode == 0


def main() -> int:
    trocken = "--trocken" in sys.argv

    if "--selbsttest" in sys.argv:
        # Der OK-Fall beweist nichts. Hier wird der Vergleich mit erfundenen
        # Lagen durchgespielt - ohne Docker, ohne Discord.
        print("== Selbsttest: erkennt der Vergleich Wechsel? ==")
        proben = [
            ({}, {"a": "x"}, ["neu: a"]),
            ({"a": "x"}, {"a": "x"}, []),
            ({"a": "x"}, {}, ["weg: a"]),
            ({"a": "x"}, {"a": "x", "b": "y"}, ["neu: b"]),
            ({"a": "x", "b": "y"}, {"b": "y"}, ["weg: a"]),
        ]
        schlecht = 0
        for alt, neu, erwartet in proben:
            ist = [f"neu: {k}" for k in neu if k not in alt] + \
                  [f"weg: {k}" for k in alt if k not in neu]
            ok = sorted(ist) == sorted(erwartet)
            print(f"  {'ok ' if ok else 'FEHLER'}  {list(alt)} -> {list(neu)}  = {ist}")
            schlecht += 0 if ok else 1
        # Und die Gegenprobe: eine Pruefung, die IMMER etwas meldet, prueft nichts.
        print("  ok  unveraendert meldet nichts" if not [
            k for k in {"a"} if k not in {"a"}] else "  FEHLER")

        # Und die Konfigurationspruefung (#286): Zu jedem stillen Fall der
        # laute daneben - eine Pruefung, die immer schweigt, prueft nichts.
        print("== Selbsttest: merkt die Wache, wenn die compose-Datei luegt? ==")
        regel = {"datei": "/erfunden/PalWorldSettings.ini", "grund": "Probe",
                 "paare": [("Beitrittspasswort", "ServerPassword", "SERVER_PASSWORD")]}
        # Werte, die in keinem Meldungstext als Wort vorkommen koennen - sonst
        # schlaegt die Leckprobe unten auf die eigene Prosa an.
        cja = '      SERVER_PASSWORD: "Xq7geheimXq7"\n'
        konfigproben = [
            (cja, 'ServerPassword="Xq7geheimXq7"', False, "gleich"),
            (cja, 'ServerPassword="Zr9fremdZr9"', True, "verschieden"),
            (cja, 'ServerPassword=""', True, "ini leer"),
            (cja, None, True, "ini fehlt"),
            ('      PORT: 8211\n', 'ServerPassword="Xq7geheimXq7"', False, "compose sagt nichts"),
            ('      PORT: 8211\n', 'ServerPassword=""', True, "beide ohne Passwort"),
        ]
        for compose, ini, soll, was in konfigproben:
            text = konfig_befund("probe", regel, compose, ini)
            ok = bool(text) == soll
            print(f"  {'ok ' if ok else 'FEHLER'}  {was:<20} -> "
                  f"{'meldet' if text else 'still '}   "
                  f"(erwartet: {'meldet' if soll else 'still'})")
            schlecht += 0 if ok else 1
        # Die zweite Regelart: Passwort in der Umgebung.
        ureg = {"art": "umgebung", "feld": "SERVER_PWD", "was": "Beitrittspasswort"}
        umgebungsproben = [
            ('      SERVER_PWD: "Xq7geheimXq7"\n', False, "gesetzt"),
            ('      SERVER_PWD: ""\n', True, "leer"),
            ('      SERVER_PWD:\n', True, "ohne Wert"),
            ('      PORT: 3724\n', True, "gar nicht da"),
            ('      - SERVER_PWD=Xq7geheimXq7\n', False, "Listenschreibweise"),
        ]
        for compose, soll, was in umgebungsproben:
            text = umgebung_befund("probe", ureg, compose)
            ok = bool(text) == soll
            print(f"  {'ok ' if ok else 'FEHLER'}  {was:<20} -> "
                  f"{'meldet' if text else 'still '}   "
                  f"(erwartet: {'meldet' if soll else 'still'})")
            schlecht += 0 if ok else 1
        # Jeder Stack aus stacks/ braucht eine Regel - sonst sieht die Wache ihn
        # nicht an, und das faellt niemandem auf (#289). Geprueft wird das im
        # Repositorium (vollstaendigkeit.sh); hier nur, dass jede Regel vollstaendig ist.
        for stack, rg in SCHUTZ.items():
            fehlt = ("grund" not in rg if rg["art"] == "unbestimmt"
                     else "feld" not in rg if rg["art"] == "umgebung"
                     else "paare" not in rg or "datei" not in rg)
            print(f"  {'FEHLER' if fehlt else 'ok '}  Regel {stack:<14} ({rg['art']})")
            schlecht += 1 if fehlt else 0

        # Weltlesbare Geheimnistraeger - auch hier beide Seiten.
        print("== Selbsttest: faellt eine weltlesbare Passwortdatei auf? ==")
        offenproben = [
            ([("/opt/stacks/a/compose.yaml", 0o600)], False, "0600"),
            ([("/opt/stacks/a/compose.yaml", 0o640)], False, "0640 (Gruppe panel)"),
            ([("/opt/stacks/a/compose.yaml.bak", 0o644)], True, "0644 Kopie"),
            ([("/opt/panel/daten/zugangsdaten.json", 0o666)], True, "0666"),
            ([], False, "keine Datei"),
            ([("/x", 0o600), ("/y", 0o604)], True, "eine von zwei offen"),
        ]
        for dateien, soll, was in offenproben:
            text = offen_befund(dateien)
            ok = bool(text) == soll
            print(f"  {'ok ' if ok else 'FEHLER'}  {was:<20} -> "
                  f"{'meldet' if text else 'still '}   "
                  f"(erwartet: {'meldet' if soll else 'still'})")
            schlecht += 0 if ok else 1

        # Und: in keiner Meldung darf ein Passwort stehen.
        laut = konfig_befund("probe", regel, cja, 'ServerPassword="Zr9fremdZr9"')
        ok = "Xq7geheimXq7" not in laut and "Zr9fremdZr9" not in laut
        print(f"  {'ok ' if ok else 'FEHLER'}  {'Meldung nennt kein Passwort':<20}")
        schlecht += 0 if ok else 1

        # Dasselbe fuer die Speicherpruefung. Der OK-Fall beweist nichts,
        # deshalb steht neben jedem stillen Fall einer, der melden MUSS - und
        # die beiden Faelle dicht an der Schwelle zeigen, dass sie dort liegt,
        # wo sie zu liegen behauptet.
        print("== Selbsttest: schlaegt die Speicherpruefung an? ==")
        GIB = 1024 * 1024                     # KiB je GiB
        speicherproben = [
            # gesamt, verfuegbar, Grenzen (Bytes), ohne Grenze, soll melden
            (23 * GIB, 11 * GIB, 47 * 1024 ** 3, 0, False),  # 52 % - der Alltag
            (23 * GIB,  4 * GIB, 47 * 1024 ** 3, 0, False),  # 83 % - knapp drunter
            (23 * GIB,  3 * GIB, 47 * 1024 ** 3, 0, True),   # 87 % - knapp drueber
            (23 * GIB,  2 * GIB, 47 * 1024 ** 3, 0, True),   # 91 % - es wird eng
            (23 * GIB,  2 * GIB,             0, 3, True),    # ohne Grenzen ebenso
            (0, 0, 0, 0, False),                             # /proc unlesbar: still
        ]
        for gesamt, verf, grenzen, ohne, soll in speicherproben:
            text = speicher_befund(gesamt, verf, grenzen, ohne, schwelle=85)
            ok = bool(text) == soll
            belegt = (f"{round((gesamt - verf) * 100 / gesamt)} %"
                      if gesamt else "unlesbar")
            print(f"  {'ok ' if ok else 'FEHLER'}  {belegt:>8} belegt  ->  "
                  f"{'meldet' if text else 'still '}   "
                  f"(erwartet: {'meldet' if soll else 'still'})")
            schlecht += 0 if ok else 1

        # Und die Neustartschleife. Zwei Bedingungen, also stehen zu jeder
        # beide Seiten da - der Zaehler allein darf nicht reichen, sonst
        # meldete ein laengst beruhigter Container fuer immer.
        print("== Selbsttest: erkennt sie eine Neustartschleife? ==")
        schleifenproben = [
            # Neustarts, Minuten seit Start, restarting, soll melden
            (7, 0, True,  True,  "startet gerade neu, 7 Neustarts - die Schleife"),
            (7, 2, False, True,  "eben erst hochgekommen, faellt gleich wieder"),
            (3, 1, False, True,  "genau auf der Schwelle"),
            (2, 1, True,  False, "zwei Neustarts - noch kein Muster"),
            (7, 240, False, False, "stuerzte frueher ab, laeuft seit vier Stunden"),
            (0, 100000, False, False, "laeuft seit Wochen, nie abgestuerzt"),
        ]
        for neustarts, seit, restarting, soll, text in schleifenproben:
            ist = schleifen_befund(neustarts, seit, restarting, schwelle=3, frisch=10)
            ok = ist == soll
            print(f"  {'ok ' if ok else 'FEHLER'}  {neustarts} Neustarts, seit {seit:>6} min"
                  f", {'startet neu' if restarting else 'laeuft     '}  ->  "
                  f"{'meldet' if ist else 'still '}   {text}")
            schlecht += 0 if ok else 1

        return 1 if schlecht else 0

    jetzt = lage()
    vorher = {}
    if ZUSTAND.exists():
        try:
            vorher = json.loads(ZUSTAND.read_text())
        except (ValueError, OSError):
            vorher = {}

    neu = {k: v for k, v in jetzt.items() if k not in vorher}
    weg = [k for k in vorher if k not in jetzt]

    fehler = 0
    for k, text in neu.items():
        art = k.split(":")[0]
        titel = {"abgestuerzt": "Server abgestuerzt",
                 "platte": "Platte wird knapp",
                 "speicher": "Arbeitsspeicher wird knapp",
                 "schleife": "Server in der Neustartschleife",
                 "ungesund": "Server meldet sich als ungesund",
                 "offen": "Einrichtung nicht abgeschlossen - Port bleibt zu",
                 "dienst": "Dienst fehlgeschlagen"}.get(art, art)
        if not melden("stoerung", titel, text, trocken):
            fehler = 1
    for k in weg:
        art, _, wer = k.partition(":")
        titel = {"abgestuerzt": f"{wer} laeuft wieder",
                 "platte": "Platte wieder in Ordnung",
                 "speicher": "Arbeitsspeicher wieder in Ordnung",
                 "schleife": f"{wer} startet wieder durch",
                 "ungesund": f"{wer} meldet sich wieder gesund",
                 "offen": f"{wer}: Einrichtung abgeschlossen",
                 "dienst": f"{wer} laeuft wieder durch"}.get(art, f"{k} erledigt")
        if not melden("meldung", titel, "Die Stoerung besteht nicht mehr.", trocken):
            fehler = 1

    if not trocken:
        try:
            ZUSTAND.parent.mkdir(parents=True, exist_ok=True)
            ZUSTAND.write_text(json.dumps(jetzt, indent=1))
            ZUSTAND.chmod(0o600)
        except OSError as e:
            print(f"wache: Zustand nicht schreibbar ({e}) - beim naechsten Lauf "
                  "wird alles noch einmal gemeldet", file=sys.stderr)
            fehler = 1

    print(f"{len(jetzt)} Befund(e), {len(neu)} neu, {len(weg)} erledigt")
    for k in jetzt:
        print(f"  {k}")
    return fehler


if __name__ == "__main__":
    sys.exit(main())
