#!/bin/bash
# panel-aktion — die EINZIGE Bruecke zwischen der Weboberflaeche und dem System.
#
# Die Web-App laeuft als unprivilegierter Nutzer "panel" und darf per sudo
# ausschliesslich dieses Skript aufrufen. Sie bekommt bewusst KEINEN Zugriff auf
# /var/run/docker.sock: wer den hat, ist faktisch root auf der Maschine.
#
# Jede Aktion ist hier fest verdrahtet, jeder Parameter wird gegen eine
# Positivliste geprueft. Es gibt kein eval, keine Shell-Expansion von Eingaben
# und keinen Pfad, ueber den die App eigene Befehle einschleusen koennte.
#
#   panel-aktion status
#   panel-aktion start|stop <stack>
#   panel-aktion archive <stack>
#   panel-aktion restore <stack> <archivname>
#   panel-aktion passwoerter
#   panel-aktion katalog
#   panel-aktion installieren <schluessel>
#   panel-aktion deinstallieren <stack>
#   panel-aktion compose-lesen <stack>
#   panel-aktion compose-setzen <stack> <name>              (Wert ueber stdin)
#   panel-aktion konfig-dateien <stack>
#   panel-aktion konfig-datei-lesen <stack> <relpfad>
#   panel-aktion konfig-datei-schreiben <stack> <relpfad>   (Inhalt ueber stdin)
#   panel-aktion dns <setzen|entfernen> <name>
set -uo pipefail
umask 077

REPO="@@BORG_REPO@@"
DIENSTE="teamspeak"
# Nur diese Felder darf die Oberflaeche aendern. Die compose.yaml als Ganzes
# freizugeben waere eine Rechteausweitung: wer dort ein Volume "/:/host"
# eintragen kann, ist root auf der Maschine.
ERLAUBTE_FELDER="SERVER_NAME SERVER_PASSWORD ADMIN_PASSWORD SERVER_PWD SERVER_SLOT_COUNT PLAYERS MAXPLAYERS SERVER_MAX_PLAYERS SERVER_MAX_PLAYER_COUNT SERVER_ROLE_0_PASSWORD SERVER_ROLE_1_PASSWORD"

fehler() { echo "FEHLER: $*" >&2; exit 1; }

# --- Positivliste: welche Stacks gibt es? ------------------------------------
stacks() { for d in /opt/stacks/*/; do basename "$d"; done; }
pruefe_stack() {
    [[ "$1" =~ ^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$ ]] || fehler "unzulaessiger Name"
    # KEINE Pipeline mit "grep -q": grep beendet sich beim ersten Treffer, die
    # schreibende Seite bekommt SIGPIPE (141), und wegen "set -o pipefail" gilt
    # die Pipeline dann als fehlgeschlagen — jeder gueltige Stack waere
    # abgewiesen worden. Here-String statt Pipe.
    local liste; liste=$(stacks)
    grep -qx "$1" <<<"$liste" || fehler "unbekannter Stack"
}
# Ist die Sicherung ueberhaupt eingeschaltet? Die Oberflaeche blendet die
# Archivwege bei BORG_REPO=aus aus, aber sie ist nicht der Waechter: geprueft
# wird hier, weil hier die Rechte liegen. Ohne diese Pruefung liefe der Aufruf
# in ein "cat: /root/.borg-passphrase" und meldete einen Fehler, wo eine
# Einstellung gemeint war.
# *The panel hides these paths when backups are off, but the panel is not the
#  guard: the check belongs where the privileges are. Without it the call would
#  fail on a missing passphrase and report a fault where a setting was meant.*
sicherung_an() {
    [ "$REPO" != "aus" ] || fehler "Die Sicherung ist abgeschaltet (BORG_REPO=aus)."
}
# Archivnamen erzeugt ausschliesslich spiele-sicherung: <stack>-JJJJMMTT-HHMMSS
pruefe_archiv() {
    [[ "$2" =~ ^[a-z0-9-]{1,40}-[0-9]{8}-[0-9]{6}$ ]] || fehler "unzulaessiger Archivname"
    [[ "$2" == "$1-"* ]] || fehler "Archiv gehoert nicht zu diesem Stack"
}

case "${1:-}" in
  status)
    # EIN docker-stats-Aufruf fuer alle Container, nicht einer je Container:
    # ein Aufruf kostet ~1,9 s, egal wie viele Container er abfragt. Einzeln
    # gerufen brauchte diese Aktion 13,2 s, gesammelt 2,0 s (gemessen 2026-09-06).
    # Systemzeile zuerst: Gesamtbild der Maschine, damit die Oberflaeche nicht
    # nur Einzelwerte zeigt, sondern auch, wieviel davon noch frei ist.
    read -r _ mges mben _ < <(free -m | grep -i "^Mem")
    load=$(awk "{print \$1}" /proc/loadavg)
    kerne=$(nproc)
    read -r pges pben pproz < <(df -m / | tail -1 | awk "{print \$2, \$3, \$5}")
    swap=$(free -m | awk "/^Swap/ {print \$3 \"/\" \$2}")
    printf "SYSTEM\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" "$mben" "$mges" "$load" "$kerne" "$pben" "$pges" "$swap"
    laufende=$(docker ps --format "{{.Names}}")
      # NetIO kommt aus DEMSELBEN Aufruf - ein Feld mehr kostet nichts, ein
      # zweiter Aufruf haette 1,9 s gekostet. Der Wert ist kumulativ seit dem
      # Start des Containers; die Rate bildet die Oberflaeche aus der Differenz
      # zweier Abrufe. Hier wird gemessen, nicht gerechnet.
      # *NetIO comes from the same call - one more field costs nothing, a second
      #  call would cost 1.9 s. Cumulative since container start; the panel
      #  derives the rate from the difference between two polls.*
    werte=$(docker stats --no-stream --format "{{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.NetIO}}" 2>/dev/null)
    for s in $(stacks); do
      if grep -qx "$s" <<<"$laufende"; then
        z=$(grep -P "^$s\t" <<<"$werte" | head -1)
        printf "%s\tlaeuft\t%s\t%s\t%s\n" "$s" "$(cut -f2 <<<"$z")" "$(cut -f3 <<<"$z")" "$(cut -f4 <<<"$z")"
      else
        printf "%s\tgestoppt\t-\t-\t-\n" "$s"
      fi
    done
    ;;
  start|stop|restart)
    s="${2:-}"; pruefe_stack "$s"
    cd "/opt/stacks/$s" || fehler "Stack-Verzeichnis fehlt"
    case "$1" in
      start) docker compose up -d >/dev/null 2>&1 || fehler "Start fehlgeschlagen" ;;
      stop)  docker compose stop  >/dev/null 2>&1 || fehler "Stopp fehlgeschlagen" ;;
      # Neustart ueber compose, nicht "docker restart": so wird eine geaenderte
      # compose.yaml mit uebernommen. "up -d" erzeugt den Container neu, wenn
      # sich etwas geaendert hat, und startet ihn sonst einfach wieder.
      restart) docker compose stop >/dev/null 2>&1
               docker compose up -d >/dev/null 2>&1 || fehler "Neustart fehlgeschlagen" ;;
    esac
    echo "ok"
    ;;
  archive)
    s="${2:-}"; pruefe_stack "$s"
    sicherung_an
    export BORG_PASSPHRASE=$(cat /root/.borg-passphrase)
    export BORG_RSH="ssh -o BatchMode=yes -o ConnectTimeout=15"
    timeout 120 borg list --glob-archives "$s-*" --format "{archive}{TAB}{time}{NL}" "$REPO" 2>/dev/null \
      || fehler "Repository nicht erreichbar"
    ;;
  archiv-groesse)
    # Wie gross waere der Download? Gehoert VOR den Klick: ein Verweis, der sich
    # als 2 GB herausstellt, ist auf einer getakteten Verbindung eine boese
    # Ueberraschung.
    s="${2:-}"; a="${3:-}"; pruefe_stack "$s"; pruefe_archiv "$s" "$a"
    sicherung_an
    export BORG_PASSPHRASE=$(cat /root/.borg-passphrase)
    export BORG_RSH="ssh -o BatchMode=yes -o ConnectTimeout=15"
    timeout 120 borg info --json "$REPO::$a" 2>/dev/null \
      | python3 -c "
import json,sys
try:
    d = json.load(sys.stdin)['archives'][0]['stats']
    print(d['original_size'])
except Exception:
    print(0)
" || echo 0
    ;;
  archiv-strom)
    # Das Archiv als tar auf stdout - ohne Zwischendatei.
    #
    # "borg extract" nach /tmp und dann packen braeuchte den Platz doppelt und
    # scheiterte an den grossen Staenden (Valheim allein 2,16 GB). "export-tar -"
    # schreibt direkt einen Strom, den die Oberflaeche durchreicht.
    #
    # KEIN timeout: Ein 2-GB-Download dauert ueber eine Hausleitung Minuten, und
    # ein Abbruch mittendrin liefert ein abgeschnittenes tar - eine Datei, die
    # aussieht wie eine Sicherung und keine ist. Begrenzt wird ueber die Groesse,
    # die vorher angezeigt wird, nicht ueber die Zeit.
    # *No timeout: cutting a 2 GB transfer mid-file yields a truncated tar that
    #  looks like a backup and is not.*
    s="${2:-}"; a="${3:-}"; pruefe_stack "$s"; pruefe_archiv "$s" "$a"
    sicherung_an
    export BORG_PASSPHRASE=$(cat /root/.borg-passphrase)
    export BORG_RSH="ssh -o BatchMode=yes -o ConnectTimeout=15"
    exec borg export-tar "$REPO::$a" - 2>/dev/null
    ;;
  restore)
    s="${2:-}"; a="${3:-}"; pruefe_stack "$s"; pruefe_archiv "$s" "$a"
    sicherung_an
    export BORG_PASSPHRASE=$(cat /root/.borg-passphrase)
    export BORG_RSH="ssh -o BatchMode=yes -o ConnectTimeout=15"
    # Basisverzeichnis bestimmen (Spiel oder Dienst)
    if   [ -d "/srv/games/$s" ];   then basis="/srv/games/$s"
    elif [ -d "/srv/dienste/$s" ]; then basis="/srv/dienste/$s"
    else fehler "kein Datenverzeichnis fuer $s"; fi
    lief=0
    docker ps --format "{{.Names}}" | grep -qx "$s" && lief=1
    # 1. Container stoppen — ein laufender Server schreibt beim Beenden zurueck
    #    und wuerde das Zurueckgespielte sofort ueberschreiben.
    [ $lief -eq 1 ] && { cd "/opt/stacks/$s" && docker compose stop >/dev/null 2>&1; }
    # 2. Ist-Stand sichern, bevor irgendetwas ueberschrieben wird
    sich="${basis}.vor-restore-$(date +%Y%m%d-%H%M%S)"
    cp -a "$basis" "$sich" || fehler "Ist-Stand liess sich nicht sichern - abgebrochen"
    # 3. Zurueckspielen (borg legt den Pfad relativ ab)
    tmp=$(mktemp -d); trap "rm -rf $tmp" EXIT
    ( cd "$tmp" && timeout 900 borg extract "$REPO::$a" ) || fehler "Extrahieren fehlgeschlagen"
    quelle="$tmp${basis}"
    [ -d "$quelle" ] || fehler "Archiv enthaelt $basis nicht"
    # Ausgeschlossene Pfade UEBERLEBEN das Zurueckspielen.
    #
    # Die Spieldateien stehen bewusst in /etc/borg-ausschluss.txt - sie sind
    # gross und jederzeit neu ladbar. Ein "rm -rf $basis/*" loescht sie
    # trotzdem, und das Archiv kann sie nicht ersetzen, weil es sie gar nicht
    # enthaelt. Genau so verlor FOUNDRY am 06.09. sein server-Verzeichnis: nach
    # der Wiederherstellung war der Mountpunkt weg, und Docker haette ihn beim
    # naechsten Start als root neu angelegt.
    # *Excluded paths survive the restore: they are deliberately not in the
    #  archive, so deleting them means they are simply gone. That is how FOUNDRY
    #  lost its server directory.*
    while IFS= read -r muster; do
      p=${muster#sh:}
      case "$p" in "$basis"/*) mv "$p" "$tmp/verschont-$(basename "$p")" 2>/dev/null ;; esac
    done < <(grep -v '^[[:space:]]*#' /etc/borg-ausschluss.txt 2>/dev/null)

    rm -rf "${basis:?}"/* && cp -a "$quelle/." "$basis/" || fehler "Kopieren fehlgeschlagen"

    for v in "$tmp"/verschont-*; do
      [ -e "$v" ] || continue
      mv "$v" "$basis/$(basename "${v#"$tmp"/verschont-}")" 2>/dev/null
    done

    # Eigentuemer vom Ist-Stand uebernehmen statt hart 4711 zu setzen. Die
    # Katalogspiele laufen als 4711, von Hand gebaute Stacks nicht zwingend:
    # FOUNDRYs Fremdimage laeuft fest als uid 1000 und konnte nach einem
    # pauschalen chown sein eigenes Datenverzeichnis nicht mehr beschreiben.
    # *Take ownership from the pre-restore state instead of forcing 4711:
    #  hand-built stacks need not run as 4711, and FOUNDRY's image is fixed to
    #  uid 1000, so a blanket chown locked it out of its own data.*
    besitzer=$(stat -c "%u:%g" "$sich" 2>/dev/null)
    chown -R "${besitzer:-4711:4711}" "$basis" 2>/dev/null
    # 4. Nur wieder starten, wenn er vorher lief
    [ $lief -eq 1 ] && { cd "/opt/stacks/$s" && docker compose up -d >/dev/null 2>&1; }
    echo "ok\tIst-Stand gesichert unter $sich"
    ;;
  konfig-lesen)
    # Gibt NUR die Felder aus, die ueber die Oberflaeche geaendert werden duerfen.
    s="${2:-}"; pruefe_stack "$s"
    f="/opt/stacks/$s/compose.yaml"
    [ -f "$f" ] || fehler "keine compose.yaml"
    # compose kennt ZWEI Schreibweisen fuer environment, und beide kommen hier
    # vor: "- KEY=wert" (Liste, z.B. Enshrouded) und "KEY: wert" (Map, z.B.
    # Palworld). Wer nur eine sucht, findet bei der Haelfte der Spiele nichts.
    for k in $ERLAUBTE_FELDER; do
      w=$(grep -oE "^[[:space:]]*-[[:space:]]*$k=.*$" "$f" | head -1 | sed -E "s/^[^=]*=//; s/^\"//; s/\"$//")
      [ -z "$w" ] && w=$(grep -oE "^[[:space:]]*$k: ?\"?[^\"]*\"?" "$f" | head -1 | sed -E "s/^[[:space:]]*$k: ?//; s/^\"//; s/\"$//")
      [ -n "$w" ] && printf "%s\t%s\n" "$k" "$w"
    done
    w=$(grep -oE "^[[:space:]]*mem_limit: ?[0-9]+g" "$f" | head -1 | grep -oE "[0-9]+g")
    [ -n "$w" ] && printf "mem_limit\t%s\n" "$w"
    # Palworld fuehrt die WIRKSAMEN Werte in seiner eigenen Datei, weil der
    # Container die Einstellungen nicht mehr selbst erzeugt. Ohne diesen Zweig
    # wuerde die Oberflaeche Werte anzeigen und aendern, die nichts bewirken.
    p=/srv/games/palworld/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini
    if [ "$s" = "palworld" ] && [ -f "$p" ]; then
      for k in ServerName ServerPassword AdminPassword; do
        printf "ini:%s\t%s\n" "$k" "$(grep -oE "$k=\"[^\"]*\"" "$p" | head -1 | sed -E "s/^$k=\"//; s/\"$//")"
      done
      printf "ini:ServerPlayerMaxNum\t%s\n" "$(grep -oE "ServerPlayerMaxNum=[0-9]+" "$p" | head -1 | grep -oE "[0-9]+")"
    fi
    ;;
  konfig-setzen)
    s="${2:-}"; k="${3:-}"; w="${4:-}"
    pruefe_stack "$s"
    # Wert streng begrenzen: keine Anfuehrungszeichen, keine Zeilenumbrueche,
    # keine Steuerzeichen — sonst liesse sich die YAML-Struktur aufbrechen.
    [[ "$w" =~ ^[A-Za-z0-9ÄÖÜäöüß._!?+-]{1,40}$ ]] || fehler "unzulaessiger Wert"
    if [[ "$k" == ini:* ]]; then
      [ "$s" = "palworld" ] || fehler "ini-Felder gibt es nur bei palworld"
      feld="${k#ini:}"
      case "$feld" in ServerName|ServerPassword|AdminPassword|ServerPlayerMaxNum) ;; *) fehler "Feld nicht erlaubt" ;; esac
      p=/srv/games/palworld/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini
      [ -f "$p" ] || fehler "PalWorldSettings.ini fehlt"
      cp "$p" "$p.vor-panel-$(date +%Y%m%d-%H%M%S)"
      if [ "$feld" = "ServerPlayerMaxNum" ]; then
        [[ "$w" =~ ^[0-9]{1,2}$ ]] || fehler "Spielerzahl muss eine Zahl sein"
        sed -i "s/ServerPlayerMaxNum=[0-9]*/ServerPlayerMaxNum=$w/" "$p"
      else
        sed -i "s/$feld=\"[^\"]*\"/$feld=\"$w\"/" "$p"
      fi
      chown 4711:4711 "$p"
      grep -c "\\\"" "$p" | grep -qx 0 || fehler "Backslashes in der Datei - zurueckgesetzt"
      echo "ok"; exit 0
    fi
    grep -qx "$k" <<<"$(printf "%s\n" $ERLAUBTE_FELDER mem_limit)" || fehler "Feld nicht erlaubt"
    f="/opt/stacks/$s/compose.yaml"
    cp "$f" "$f.vor-panel-$(date +%Y%m%d-%H%M%S)"
    if [ "$k" = "mem_limit" ]; then
      [[ "$w" =~ ^[0-9]{1,2}g$ ]] || fehler "Speichergrenze muss wie 8g aussehen"
      sed -i -E "s/^([[:space:]]*)mem_limit: ?[0-9]+g/\1mem_limit: $w/; s/^([[:space:]]*)memswap_limit: ?[0-9]+g/\1memswap_limit: $w/" "$f"
    else
      if grep -qE "^[[:space:]]*-[[:space:]]*$k=" "$f"; then
        sed -i -E "s|^([[:space:]]*-[[:space:]]*)$k=.*$|\1$k=$w|" "$f"
      else
        sed -i -E "s|^([[:space:]]*)$k: ?\"?[^\"]*\"?$|\1$k: \"$w\"|" "$f"
      fi
    fi
    echo "ok"
    ;;
  neustart)
    # Neustart der ganzen Maschine. Vorher pruefen, ob gerade eine Sicherung
    # laeuft — ein abgebrochener borg-Lauf hinterlaesst einen Lock, den man von
    # Hand loesen muss.
    if pgrep -f "[b]org (create|prune|compact)" >/dev/null 2>&1; then
      fehler "Es laeuft gerade eine Sicherung. Neustart abgebrochen."
    fi
    # Erst MERKEN, was laeuft, dann anhalten.
    #
    # Das Anhalten ist richtig - die Spiele sollen ihre Staende schreiben. Es hat
    # aber einen Nebeneffekt, der zweimal am 2026-09-09 dazu fuehrte, dass nach
    # dem Neustart KEIN Server zurueckkam: "docker compose stop" ist ein
    # AUSDRUECKLICHES Anhalten, und genau das schaltet "restart: unless-stopped"
    # ab. Die Regel heisst "starte wieder, ausser es wurde ausdruecklich
    # angehalten", und Docker merkt sich das ueber den Neustart hinweg.
    #
    # Die Liste geht nach /var/lib, nicht nach /tmp: /tmp ist nach dem Neustart
    # leer - also genau dann, wenn die Liste gebraucht wird. spiele-wiederanlauf
    # liest sie beim naechsten Hochfahren und raeumt sie danach weg.
    #
    # *Stopping is right - the games must write their saves. But an explicit stop
    #  is exactly what disables unless-stopped, and Docker remembers that across
    #  the reboot, so nothing came back. The list goes to /var/lib because /tmp is
    #  empty after a reboot, which is precisely when it is needed.*
    docker ps --format "{{.Names}}" | sort > /var/lib/spiele-wiederanlauf
    chmod 600 /var/lib/spiele-wiederanlauf
    for d in /opt/stacks/*/; do
      n=$(basename "$d")
      docker ps --format "{{.Names}}" | grep -qx "$n" && ( cd "$d" && docker compose stop >/dev/null 2>&1 )
    done
    logger -t panel "Neustart ueber die Weboberflaeche ausgeloest"
    systemctl reboot
    echo "ok"
    ;;
  logs)
    # Die letzten Zeilen aus "docker logs". Eigene Aktion mit eigener Pruefung -
    # keine gelockerte bestehende, wie in CLAUDE.md verlangt.
    #
    # Die Zeilenzahl wird HIER begrenzt, nicht in der Oberflaeche: ein
    # unbegrenztes --tail auf einen Container, der seit Tagen laeuft, waere ein
    # Selbstangriff auf das Panel. Zahl oder nichts, hoechstens 2000.
    # *The line count is bounded here, not in the UI: an unbounded --tail on a
    #  long-running container would be a denial of service against the panel.*
    s="${2:-}"; n="${3:-200}"; pruefe_stack "$s"
    # Die Meldung nennt genau das, was gepruefte wurde: "99999" IST eine Zahl,
    # nur eine zu grosse. Eine Meldung, die etwas anderes behauptet, schickt den
    # Suchenden in die falsche Richtung.
    # *The message says what was actually checked: 99999 is a number, just too
    #  large a one.*
    [[ "$n" =~ ^[0-9]+$ ]] || fehler "Zeilenzahl muss eine Zahl sein, war: ${n:0:20}"
    [ "$n" -ge 1 ]    2>/dev/null || n=200
    [ "$n" -le 2000 ] 2>/dev/null || n=2000
    # Laeuft der Container nicht mehr, gibt es trotzdem Logs - gerade dann sind
    # sie interessant. 2>&1, weil die meisten Spieleserver auf stderr schreiben.
    docker logs --timestamps --tail "$n" "$s" 2>&1 || fehler "keine Logs fuer $s"
    ;;
  aktualisieren)
    # Neue Fassung des Images holen und den Server damit neu starten.
    #
    # Die Sicherung ist BEDINGUNG, nicht Schritt: Ein Update kann einen
    # Spielstand unbrauchbar machen - ein neuer Serverstand, der einen alten
    # Spielstand liest, ist genau der Fall, in dem "dann spiele ich eben zurueck"
    # auch wirklich funktionieren muss. Scheitert die Sicherung, unterbleibt das
    # Update. Umgekehrt waere es ein Update ohne Rueckweg.
    # *The backup is a precondition, not a step: if it fails, the update does not
    #  happen. The other way round is an update with no way back.*
    s="${2:-}"; pruefe_stack "$s"
    # Dieselbe Pruefung wie bei den Archivwegen: der Wert selbst ist der Schalter
    # (siehe E22). Ist die Sicherung abgeschaltet, gibt es keinen Rueckweg - dann
    # wird auch nicht aktualisiert.
    if [ "$REPO" != "aus" ]; then
      /usr/local/bin/spiele-sicherung --nur "$s" >/dev/null 2>&1 \
        || fehler "Sicherung fehlgeschlagen - Update unterblieben. Ohne Rueckweg wird nicht aktualisiert."
    else
      fehler "Die Sicherung ist abgeschaltet (BORG_REPO=aus). Ohne Rueckweg wird nicht aktualisiert."
    fi
    cd "/opt/stacks/$s" || fehler "kein Stackverzeichnis"
    # "pull" sagt selbst, ob es etwas geholt hat. Diese Unterscheidung gehoert in
    # die Antwort: ein Knopf, der immer "fertig" meldet, wird nicht mehr gelesen.
    # *"Already current" and "updated" are different answers; a button that always
    #  says "done" stops being read.*
    # Verglichen wird die IMAGE-ID, nicht die JSON-Ausgabe: die enthaelt
    # "LastTagTime", und der Zeitstempel aendert sich bei JEDEM pull - auch wenn
    # dasselbe Image erneut geholt wurde. Damit meldete der erste Anlauf immer
    # "aktualisiert", und ein Knopf, der immer dasselbe sagt, wird nicht mehr
    # gelesen. Die sha256-ID aendert sich nur bei einem echten Wechsel;
    # nachgemessen ueber einen erneuten pull hinweg.
    # *The image ID, not the JSON: that carries LastTagTime, which changes on
    #  every pull even when nothing new arrived.*
    vorher=$(docker compose images -q 2>/dev/null | sort | tr -d "\n")
    aus=$(docker compose pull 2>&1) || fehler "Abholen fehlgeschlagen: $(printf %s "$aus" | tail -2 | tr "\n" " ")"
    nachher=$(docker compose images -q 2>/dev/null | sort | tr -d "\n")
    if [ "$vorher" = "$nachher" ]; then
      echo "ok	schon aktuell	$s war bereits auf der neuesten Fassung"
      exit 0
    fi
    # Ein Server, der vorher AUS war, wird nicht angefasst: das Image ist geholt,
    # beim naechsten Start greift es von selbst. Der erste Anlauf startete ihn
    # kurz und hielt ihn wieder an - der Container kam mit Exit 137 zurueck, also
    # hart gekillt, weil er auf SIGTERM noch nicht ansprechbar war. Ein
    # Spieleserver, der drei Sekunden laeuft und dann abgeschossen wird, ist
    # genau die Art Nebenwirkung, die man einem Update nicht zumuten will.
    # *A server that was off is left alone: the image is pulled and takes effect
    #  on the next start. The first attempt started it briefly and stopped it
    #  again, which returned exit 137 - killed before it could handle SIGTERM.*
    if docker ps --format "{{.Names}}" | grep -qx "$s"; then
      docker compose up -d >/dev/null 2>&1 || fehler "Neustart nach dem Update fehlgeschlagen"
      echo "ok	aktualisiert	$s laeuft jetzt auf der neuen Fassung"
    else
      echo "ok	aktualisiert	Neue Fassung fuer $s geholt - sie greift beim naechsten Start"
    fi
    ;;
  auto-update)
    # Der Schalter liegt in EINER EIGENEN Liste, nicht in der panel.json.
    #
    # Erster Anlauf schrieb ihn in die panel.json - und erreichte damit genau
    # einen von acht Servern, weil nur ueber den Katalog installierte Stacks
    # eine haben. Ausgerechnet Palworld und Enshrouded, die laufend Patches
    # bekommen, waren aussen vor. Die panel.json beschreibt, WAS der Katalog
    # installiert hat; ob ein Server sich nachts selbst aktualisieren soll, hat
    # damit nichts zu tun.
    # *The first attempt stored this in panel.json and reached one server out of
    #  eight, since only catalogue-installed stacks have that file. panel.json
    #  describes what the catalogue installed; whether a server updates itself at
    #  night has nothing to do with where it came from.*
    s="${2:-}"; wert="${3:-}"; pruefe_stack "$s"
    case "$wert" in an|aus) ;; *) fehler "nur 'an' oder 'aus'" ;; esac
    liste=/var/lib/spiele-autoupdate.liste
    touch "$liste"; chmod 600 "$liste"
    # Erst herausnehmen, dann ggf. wieder hinein: so steht jeder Stack hoechstens
    # einmal drin, egal wie oft geschaltet wurde.
    tmp=$(mktemp); grep -vFx "$s" "$liste" > "$tmp" 2>/dev/null || true
    [ "$wert" = "an" ] && echo "$s" >> "$tmp"
    sort -u "$tmp" > "$liste"; rm -f "$tmp"
    chmod 600 "$liste"
    echo "ok	auto-update fuer $s: $wert"
    ;;
  fremd-entfernen)
    # Fuer Stacks OHNE panel.json - die von Hand gebauten. Eigene Aktion mit
    # eigener Pruefung; die Katalogdeinstallation bleibt unangetastet.
    #
    # Nur fuer Administratoren, anders als "deinstallieren", das "verwalten"
    # benutzen darf: Diese Stacks hat niemand ueber den Katalog angelegt, es gibt
    # keinen Katalogeintrag, aus dem man sie wiederherstellen koennte, und
    # StarRupture allein sind 22 GB.
    # *Admin only, unlike the catalogue removal: nobody created these through the
    #  catalogue, there is no entry to restore them from.*
    s="${2:-}"; pruefe_stack "$s"
    [ -f "/opt/stacks/$s/panel.json" ] && fehler "Dieser Server kam aus dem Katalog - dafuer ist 'deinstallieren' zustaendig."
    /usr/local/bin/spiel-verwalten fremd-entfernen "$s"
    ;;
  groesse)
    # Wieviel wuerde geloescht? Gehoert VOR die Rueckfrage.
    s="${2:-}"; pruefe_stack "$s"
    /usr/local/bin/spiel-verwalten groesse "$s"
    ;;
  auto-update-liste)
    # Welche Stacks sind freigeschaltet? Fuer die Oberflaeche, damit sie den
    # Schalter richtig herum zeichnet.
    [ -f /var/lib/spiele-autoupdate.liste ] && cat /var/lib/spiele-autoupdate.liste || true
    ;;
  alle-anhalten)
    # Alles anhalten, was laeuft - und sich merken, WAS lief. Ohne diese Liste
    # waere "alle wieder starten" ein Raten.
    docker ps --format "{{.Names}}" | sort > /var/lib/spiele-wiederanlauf
    chmod 600 /var/lib/spiele-wiederanlauf
    n=0
    while read -r s; do
      [ -n "$s" ] || continue
      [ -d "/opt/stacks/$s" ] || continue
      ( cd "/opt/stacks/$s" && docker compose stop >/dev/null 2>&1 ) && n=$((n+1))
    done < /var/lib/spiele-wiederanlauf
    echo "ok	$n Server angehalten"
    ;;
  alle-starten)
    # Genau die wieder starten, die zuletzt liefen - dieselbe Liste, die auch der
    # Neustart benutzt. Kein zweiter Zustand, der auseinanderlaufen kann.
    [ -s /var/lib/spiele-wiederanlauf ] || fehler "Keine Liste vorhanden - es wurde nichts gemeinsam angehalten."
    n=0
    while read -r s; do
      [ -n "$s" ] || continue
      [ -d "/opt/stacks/$s" ] || continue
      ( cd "/opt/stacks/$s" && docker compose up -d >/dev/null 2>&1 ) && n=$((n+1))
    done < /var/lib/spiele-wiederanlauf
    rm -f /var/lib/spiele-wiederanlauf
    echo "ok	$n Server gestartet"
    ;;
  laufende-vorher)
    # Welche Server laufen gerade? Fuer die Rueckfrage vor dem Neustart.
    docker ps --format "{{.Names}}" | sort | tr "\n" " "
    ;;
  passwoerter)
    # Liest die Zugangsdaten aus den compose-Dateien. Bewusst eine eigene
    # Aktion: So taucht nichts davon in der Uebersicht auf, sondern nur, wenn
    # es ausdruecklich angefordert wird.
    for s in $(stacks); do
      f="/opt/stacks/$s/compose.yaml"
      [ -f "$f" ] || continue
      grep -hoE "(SERVER_PASSWORD|ADMIN_PASSWORD|SERVER_PWD|SERVER_ROLE_[0-9]+_PASSWORD)[:=] ?\"?[^\"]+\"?" "$f" \
        | sed -E "s/^/$s\t/; s/[:=] ?\"?/\t/; s/\"$//"
    done
    # Palworld/Enshrouded fuehren die wirksamen Werte teils in ihrer eigenen
    # Konfiguration — diese hier zusaetzlich, damit die Anzeige nicht luegt.
    p=/srv/games/palworld/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini
    [ -f "$p" ] && grep -oE "(Server|Admin)Password=\"[^\"]*\"" "$p" | sed -E "s/^/palworld (wirksam)\t/; s/=\"/\t/; s/\"$//"
    # Ueber den Katalog installierte Server fuehren ihre Passwoerter in
    # panel.json - dort stehen sie auch dann, wenn das Spiel sie in einer
    # Konfigurationsdatei fuehrt, deren Format wir nicht lesen.
    for d in /opt/stacks/*/panel.json; do
      [ -f "$d" ] || continue
      python3 - "$d" <<"PY"
import json, sys, os
p = json.load(open(sys.argv[1]))
n = os.path.basename(os.path.dirname(sys.argv[1]))
if p.get("passwort_art") != "keins":
    for feld, schl in (("Beitrittspasswort", "passwort"), ("Adminpasswort", "admin_passwort")):
        if p.get(schl):
            print(f"{n}\t{feld}\t{p[schl]}")
PY
    done
    ;;
  katalog)
    # Welche Spiele lassen sich installieren, was ist schon da?
    /usr/local/bin/spiel-verwalten katalog
    ;;
  installieren)
    s="${2:-}"
    # Schluessel wird von spiel-verwalten gegen den Katalog geprueft; hier nur
    # die Form, damit gar nichts Unerwartetes weitergereicht wird.
    [[ "$s" =~ ^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$ ]] || fehler "unzulaessiger Name"
    /usr/local/bin/spiel-verwalten installieren "$s" || exit 1
    # DNS-Namen anlegen, wenn der Cloudflare-Zugang eingerichtet ist. Ein
    # fehlender Zugang ist kein Grund, die Installation als gescheitert zu
    # melden - das Spiel laeuft auch ueber die IP-Adresse.
    if [ -f /etc/dns-gameserver.conf ]; then
      /usr/local/bin/dns-pflegen setzen "$s" >/dev/null 2>&1 || true
    fi
    ;;
  deinstallieren)
    s="${2:-}"; pruefe_stack "$s"
    [ -f "/opt/stacks/$s/panel.json" ] || fehler "Dieser Server wurde nicht ueber den Katalog installiert und laesst sich hier nicht entfernen."
    if [ -f /etc/dns-gameserver.conf ]; then
      /usr/local/bin/dns-pflegen entfernen "$s" >/dev/null 2>&1 || true
    fi
    /usr/local/bin/spiel-verwalten deinstallieren "$s"
    ;;
  einrichtung)
    # Stand der Passwort-Einrichtung je Stack (fuer die Anzeige).
    for d in /opt/stacks/*/panel.json; do
      [ -f "$d" ] || continue
      n=$(basename "$(dirname "$d")")
      printf "%s\t%s\t%s\n" "$n" \
        "$(python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('einrichtung_offen',False))" "$d")" \
        "$(python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('einrichtung_stand',''))" "$d")"
    done
    ;;
  port-ermitteln)
    # Portermittlung nach dem ersten Start. Die Pruefungen sitzen vollstaendig
    # in port-ermitteln: Regel aus dem Katalog, Kollisionspruefung gegen die
    # TATSAECHLICH belegten Ports und ein Vergleich der erzeugten Konfiguration
    # vor und nach dem Eintragen - weicht mehr als der Portblock ab, wird
    # zurueckgerollt.
    # *All checks live in port-ermitteln, including a before/after comparison of
    #  the rendered config: anything beyond the ports block is rolled back.*
    s="${2:-}"; pruefe_stack "$s"
    exec /usr/local/bin/port-ermitteln "$s"
    ;;
  compose-lesen|compose-setzen)
    # Alle Umgebungsvariablen des Stacks. Die Absicherung sitzt vollstaendig in
    # compose-feld: Namensmuster, Sperrliste, keine Zeilenumbrueche im Wert und -
    # als eigentlicher Schutz - ein Vergleich der von docker erzeugten Endfassung
    # vor und nach der Aenderung. Weichen Volumes, Ports, Image, user, privileged
    # oder cap_add ab, wird zurueckgerollt. Diese Pruefung sieht das ERGEBNIS an
    # und haengt nicht davon ab, dass die Eingabepruefungen lueckenlos sind.
    # *Protection lives entirely in compose-feld, whose real safeguard is a
    #  before/after comparison of docker's rendered config: it inspects the
    #  result rather than trusting the input checks.*
    s="${2:-}"; pruefe_stack "$s"
    case "$1" in
      compose-lesen)  exec /usr/local/bin/compose-feld lesen "$s" ;;
      compose-setzen) exec /usr/local/bin/compose-feld setzen "$s" "${3:-}" ;;
    esac
    ;;
  konfig-dateien|konfig-datei-lesen|konfig-datei-schreiben)
    # Konfigurationsdateien der SPIELE (nicht die compose.yaml). Die
    # Pfadpruefung sitzt vollstaendig in konfig-datei: sie loest jeden Pfad auf
    # und prueft DANACH die Zugehoerigkeit — das ist die einzige Reihenfolge,
    # die den Symlink "z: -> /" im Wine-Praefix von StarRupture abfaengt.
    # Hier wird deshalb nur der Stack geprueft und durchgereicht; die Datei
    # selbst NICHT vorab gefiltert, sonst gaebe es zwei Wahrheiten darueber,
    # was erlaubt ist.
    # *Path validation lives entirely in konfig-datei, which resolves first and
    #  checks afterwards - the only order that catches the "z: -> /" symlink in
    #  StarRupture's Wine prefix. Only the stack is checked here; validating the
    #  file in two places would create two competing truths about what is
    #  allowed.*
    s="${2:-}"; pruefe_stack "$s"
    case "$1" in
      konfig-dateien)         exec /usr/local/bin/konfig-datei liste "$s" ;;
      konfig-datei-lesen)     exec /usr/local/bin/konfig-datei lesen "$s" "${3:-}" ;;
      konfig-datei-schreiben) exec /usr/local/bin/konfig-datei schreiben "$s" "${3:-}" ;;
    esac
    ;;
  dns)
    was="${2:-}"; n="${3:-}"
    case "$was" in setzen|entfernen|liste|pruefen) ;; *) fehler "unbekannte DNS-Aktion" ;; esac
    if [ "$was" = "liste" ] || [ "$was" = "pruefen" ]; then
      /usr/local/bin/dns-pflegen "$was"
    else
      pruefe_stack "$n"
      /usr/local/bin/dns-pflegen "$was" "$n"
    fi
    ;;
  *) fehler "unbekannte Aktion" ;;
esac
