#!/usr/bin/env python3
"""workshop — Steam-Workshop-Mods fuer Spielserver: pruefen, suchen, eintragen (#130).

Die Server dieser Spiele laden Workshop-Inhalte SELBST, wenn ihre Konfiguration
die IDs nennt. Dieses Werkzeug pflegt die Liste an der Stelle, an der das Spiel
sie erwartet - wo das ist und in welcher Form, steht je Spiel in
/etc/spiele-workshop.json; geraten wird nichts. Vorab geladen wird nur, wo das
Spiel es verlangt (Project Zomboid braucht die Mod-ID aus dem Inhalt), und dann
mit dem steamcmd des Images genau dorthin, wo der Server selbst laedt.

  workshop kann    <stack>            unterstuetzt? und ist die Suche verfuegbar?
  workshop liste   <stack>            eingetragene Mods
  workshop pruefen <stack> <eingabe>  Link, ID oder Sammlung -> geprueft
  workshop suche   <stack> <text> [seite]
  workshop hinzu   <stack> <id>
  workshop weg     <stack> <id>
  workshop --selbsttest

Ausgabe tabgetrennt, Zeile fuer Zeile; das Panel liest sie.

== Wogegen hier gebaut wird ==
Eine eingefuegte ID ist nur eine Zahl - und genau deshalb gefaehrlich: Die
Zahl eines Mods fuer ein ANDERES Spiel wuerde der Server herunterladen und
laden wollen. Jede ID wird vor dem Eintragen bei Steam nachgeschlagen und muss
zu GENAU dem Spiel dieses Servers gehoeren (consumer_app_id == appid aus dem
Katalog). Gesperrte und nicht gefundene Eintraege werden abgewiesen.

*Every pasted id is looked up at Steam and must belong to exactly this server's
 game (consumer_app_id == the catalogue appid); banned and missing items are
 refused. The game servers fetch Workshop items themselves from the list this
 tool maintains; it pre-fetches only where a game needs it (Project Zomboid needs
 the mod id from the content), with the image's own steamcmd.*
"""
import json
import os
import re
import sys
import urllib.parse
import urllib.request
from pathlib import Path

KATALOG = Path(os.environ.get("WORKSHOP_KATALOG", "/etc/spiele-katalog.json"))
KONF = Path(os.environ.get("WORKSHOP_KONF", "/etc/spiele-workshop.json"))
# Vom Panel geschrieben (Seite "Integrationen", nur admin) - Jens: "der Steam-API-
# Key muss irgendwo im Panel hinterlegbar sein". Deshalb nicht /etc: dort darf das
# Panel nicht schreiben (ProtectSystem=full), und ein zweiter Ablageort waere eine
# zweite Wahrheit. /opt/panel/daten ist seit #218 in der Sicherung.
# *Written by the panel's integrations page; /etc is read-only for the panel.*
STEAM_KONF = Path(os.environ.get("WORKSHOP_STEAM_KONF", "/opt/panel/daten/steam-api.conf"))
STACKS = Path(os.environ.get("WORKSHOP_STACKS", "/opt/stacks"))
GAMES = Path(os.environ.get("WORKSHOP_GAMES", "/srv/games"))
API = "https://api.steampowered.com"
ID_MUSTER = re.compile(r"^[0-9]{3,12}$")
# Groesser als das nimmt das Panel nichts an. Mods landen in der Sicherung
# (Jens' Entscheidung in #130) - ein einzelner ARK-Mod war 319 MB.
MAX_BYTES = int(os.environ.get("WORKSHOP_MAX_BYTES", str(2 * 1024 ** 3)))


def fehler(*t, code=1):
    print("FEHLER:", *t, file=sys.stderr)
    sys.exit(code)


# --- Steam ------------------------------------------------------------------

def _post(pfad: str, felder: dict) -> dict:
    daten = urllib.parse.urlencode(felder).encode()
    req = urllib.request.Request(f"{API}/{pfad}", data=daten,
                                 headers={"User-Agent": "platzwart-workshop"})
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.loads(r.read())


def details(ids: list) -> dict:
    """{id: details} ueber GetPublishedFileDetails - braucht KEINEN Schluessel."""
    if not ids:
        return {}
    felder = {"itemcount": len(ids)}
    for i, x in enumerate(ids):
        felder[f"publishedfileids[{i}]"] = x
    antwort = _post("ISteamRemoteStorage/GetPublishedFileDetails/v1/", felder)
    return {d["publishedfileid"]: d for d in antwort["response"].get("publishedfiledetails", [])}


def sammlung(cid: str) -> list:
    """IDs einer Sammlung, [] wenn cid keine Sammlung ist - ohne Schluessel."""
    antwort = _post("ISteamRemoteStorage/GetCollectionDetails/v1/",
                    {"collectioncount": 1, "publishedfileids[0]": cid})
    d = (antwort["response"].get("collectiondetails") or [{}])[0]
    if d.get("result") != 1:
        return []
    return [k["publishedfileid"] for k in d.get("children", []) if k.get("filetype") == 0]


def schluessel() -> str:
    """Steam-Web-API-Schluessel aus dem Panel (0600 panel), sonst ''."""
    try:
        for z in STEAM_KONF.read_text().splitlines():
            if z.startswith("STEAM_API_KEY="):
                return z.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return ""


def suchen(appid: int, text: str, seite: int = 1) -> list:
    """Workshop-Suche - braucht den Schluessel (ohne: HTTP 403, gemessen)."""
    k = schluessel()
    if not k:
        fehler("keine Suche ohne Steam-Web-API-Schluessel - im Panel unter Integrationen hinterlegen", code=3)
    q = urllib.parse.urlencode({
        "key": k, "appid": appid, "search_text": text, "numperpage": 20,
        "page": seite, "query_type": 12, "filetype": 0, "return_details": "true",
        "return_short_description": "true"})
    req = urllib.request.Request(f"{API}/IPublishedFileService/QueryFiles/v1/?{q}",
                                 headers={"User-Agent": "platzwart-workshop"})
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.loads(r.read())["response"].get("publishedfiledetails", [])


def ids_aus(eingabe: str) -> list:
    """Link oder ID -> [id]. Ein Link traegt die ID als ?id=... ."""
    m = re.search(r"[?&]id=([0-9]{3,12})\b", eingabe) or re.fullmatch(r"\s*([0-9]{3,12})\s*", eingabe)
    return [m.group(1)] if m else []


def urteil(d: dict, appid: int) -> str:
    """'' = in Ordnung, sonst der Grund - rein, damit sich jede Antwort pruefen laesst."""
    if not d or d.get("result") != 1:
        return "bei Steam nicht gefunden"
    # Zwei Schnittstellen, zwei Namen fuer dasselbe Feld (gemessen 2026-09-11):
    # GetPublishedFileDetails sagt consumer_app_id, die Suche (QueryFiles)
    # consumer_appid. Nur den ersten zu kennen, wies JEDEN Suchtreffer als
    # "anderes Spiel" ab - aufgefallen erst mit echtem Schluessel.
    # *Two APIs name the same field differently; knowing only one refused every
    #  search hit as "another game".*
    app = d.get("consumer_app_id", d.get("consumer_appid"))
    if int(app or 0) != int(appid):
        return f"gehoert zu einem anderen Spiel (App {app})"
    if d.get("banned"):
        return "von Steam gesperrt"
    if int(d.get("file_size") or 0) > MAX_BYTES:
        return f"groesser als {MAX_BYTES // 1024 ** 2} MB"
    return ""


# --- Stack und Spiel ----------------------------------------------------------

def spiel_von(stack: str) -> tuple:
    """(katalogeintrag, workshop-angabe) - bricht ab, wenn der Stack nicht passt."""
    if not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?", stack):
        fehler("unzulaessiger Name")
    try:
        p = json.loads((STACKS / stack / "panel.json").read_text())
    except (OSError, ValueError):
        fehler(f"{stack}: kein Katalogspiel (keine panel.json)", code=2)
    sch = p.get("schluessel", stack)
    g = next((e for e in json.loads(KATALOG.read_text())["spiele"] if e["schluessel"] == sch), None)
    w = json.loads(KONF.read_text()).get("spiele", {}).get(sch)
    if not g or not w:
        fehler(f"{stack}: fuer dieses Spiel gibt es keine Workshop-Anbindung", code=2)
    return g, w


# --- Anpassungen je Spiel -------------------------------------------------------
# Jede Art weiss nur zwei Dinge: welche IDs eingetragen sind, und wie man eine
# eintraegt oder austraegt. Was der Server daraus macht, ist seine Sache.

class Anpassung:
    def __init__(self, stack: str, w: dict):
        self.stack, self.w = stack, w
        self.basis = GAMES / stack

    def datei(self) -> Path:
        """Die Konfigurationsdatei - aufgeloest und INNERHALB des Datenverzeichnisses."""
        p = (self.basis / self.w["datei"]).resolve()
        if not str(p).startswith(str(self.basis.resolve()) + "/"):
            fehler("Konfigurationspfad liegt ausserhalb des Datenverzeichnisses")
        if not p.is_file():
            fehler(f"{self.w['datei']} gibt es noch nicht - der Server legt sie beim "
                   "ersten Start an. Danach erneut versuchen.", code=4)
        return p

    def inhalt(self, wid: str, ordner: str = "") -> Path:
        """Heruntergeladener Inhalt einer ID - INNERHALB des Datenverzeichnisses."""
        p = (self.basis / (ordner or self.inhaltsordner()[0]) / wid).resolve()
        if not str(p).startswith(str(self.basis.resolve()) + "/"):
            fehler("Inhaltspfad liegt ausserhalb des Datenverzeichnisses")
        return p

    def inhaltsordner(self) -> list:
        """"inhalt" ist ein Pfad oder eine Liste - DST laedt je Shard getrennt."""
        i = self.w["inhalt"]
        return [i] if isinstance(i, str) else list(i)

    def aufraeumen(self, ids: list):
        """Inhalt JEDER nicht eingetragenen ID loeschen - nicht nur der gerade
        ausgetragenen. Mods werden mitgesichert, und die Sicherung soll nicht mit
        Dingen wachsen, die niemand mehr laedt.

        Warum alle: Steam stellte am Unturned-Testserver einen geloeschten Ordner
        beim naechsten Start wieder her - einmal von drei Versuchen, in dem Lauf,
        in dem ein anderer Download scheiterte (2026-09-11). Geladen wird so ein
        Ordner nicht (die ID steht nicht in der Liste), er laege aber in jeder
        Sicherung. So raeumt ihn das naechste Speichern weg.
        *Delete the content of every id not listed, not just the one removed:
         Steam once restored a deleted folder on the next start (1 of 3 tries).*"""
        import shutil
        for o in self.inhaltsordner():
            ordner = self.inhalt("0", o).parent
            if not ordner.is_dir():
                continue
            for d in ordner.iterdir():
                if d.is_dir() and not d.is_symlink() and ID_MUSTER.fullmatch(d.name) and d.name not in ids:
                    shutil.rmtree(d)

    def liste(self) -> list:
        raise NotImplementedError

    def setzen(self, ids: list):
        raise NotImplementedError


ARTEN = {}


def art(name):
    def reg(cls):
        ARTEN[name] = cls
        return cls
    return reg


def anpassung(stack: str, w: dict) -> Anpassung:
    cls = ARTEN.get(w.get("art"))
    if not cls:
        fehler(f"unbekannte Anbindungsart {w.get('art')!r} in {KONF}")
    return cls(stack, w)


def lese_ini(text: str, feld: str) -> str:
    import re as _re
    m = _re.search(rf"^{feld}=([^\r\n]*)$", text, _re.M)
    return m.group(1).strip() if m else ""


def setze_ini(text: str, feld: str, wert: str) -> str:
    """Genau EINE vorhandene Zeile "<feld>=..." ersetzen - fehlt sie, Abbruch.

    Kein Anhaengen: Ein Feld, das es nicht gibt, liest der Server nicht, und ein
    stilles Anhaengen saehe erledigt aus.
    *Replace exactly one existing line; a missing field aborts rather than being
     appended, which would look done while the server never reads it.*
    """
    import re as _re
    muster = _re.compile(rf"^{feld}=[^\r\n]*$", _re.M)
    if len(muster.findall(text)) != 1:
        fehler(f"Feld {feld}= nicht genau einmal in der Konfiguration")
    return muster.sub(lambda m: f"{feld}={wert}", text)


@art("zomboid")
class Zomboid(Anpassung):
    """Project Zomboid: WorkshopItems= (Workshop-IDs) UND Mods= (Mod-IDs).

    Der Server laedt nur, was in BEIDEN Zeilen steht: WorkshopItems sagt, was er
    herunterlaedt, Mods, was er davon laedt. Die Mod-ID steht erst in der
    mod.info im heruntergeladenen Inhalt - bei Build 42 unter mods/<Name>/42/
    oder mods/<Name>/common/ (gemessen an zwei Mods am 2026-09-11). Damit nicht
    zwei Neustarts noetig sind (erst laden, dann aktivieren), laedt dieses
    Werkzeug den Inhalt beim Eintragen selbst vorab - mit dem steamcmd im
    Container, als dessen Benutzer, genau dorthin, wo der Server sucht. Gemessen:
    11 s fuer einen 280-KB-Mod, anonym. Das Format "Mods=A;B" laedt Build 42
    (Log: "loading GlassmakingPlus").
    *The server loads only what is in BOTH lines. The mod id lives in mod.info
     inside the downloaded content, so the content is pre-fetched with the
     container's steamcmd, as its user, right where the server looks.*
    """

    def liste(self) -> list:
        wert = lese_ini(self.datei().read_text(errors="replace"), "WorkshopItems")
        return [x for x in wert.split(";") if ID_MUSTER.fullmatch(x)]

    def mod_ids(self, wid: str) -> list:
        ids = []
        for mi in sorted(self.inhalt(wid).glob("mods/*/**/mod.info")):
            for z in mi.read_text(errors="replace").splitlines():
                if z.startswith("id="):
                    mid = z[3:].strip()
                    if re.fullmatch(r"[A-Za-z0-9_.\- ]{1,80}", mid) and mid not in ids:
                        ids.append(mid)
        return ids

    def vorab_laden(self, wid: str):
        """Inhalt mit dem steamcmd des Images laden - als Eigentuemer der Daten."""
        import subprocess
        besitzer = f"{self.basis.stat().st_uid}:{self.basis.stat().st_gid}"
        befehl = [self.w["steamcmd"], "+force_install_dir", self.w["install_dir"],
                  "+login", "anonymous", "+workshop_download_item",
                  str(self.w["appid_workshop"]), wid, "+quit"]
        laeuft = subprocess.run(["docker", "inspect", "-f", "{{.State.Running}}", self.stack],
                                capture_output=True, text=True).stdout.strip() == "true"
        if laeuft:
            aufruf = ["docker", "exec", "-u", besitzer, self.stack] + befehl
        else:
            # Gestoppt: ein Wegwerfcontainer aus demselben Image, mit demselben
            # Datenverzeichnis - der Server startet dabei NICHT.
            bild = subprocess.run(["docker", "inspect", "-f", "{{.Config.Image}}", self.stack],
                                  capture_output=True, text=True).stdout.strip()
            if not bild:
                fehler("kein Container fuer diesen Server")
            aufruf = ["docker", "run", "--rm", "-u", besitzer, "--entrypoint", befehl[0],
                      "-v", f"{self.basis}:/serverdata", bild] + befehl[1:]
        r = subprocess.run(aufruf, capture_output=True, text=True, timeout=1800)
        if "Success. Downloaded item" not in r.stdout:
            letzte = (r.stdout.strip().splitlines() or ["keine Ausgabe"])[-1]
            fehler(f"{wid}: Download gescheitert - {letzte[:160]}")

    def setzen(self, ids: list):
        p = self.datei()
        text = p.read_text(errors="replace")
        alt_ids = self.liste()
        # Mod-IDs der Eintraege, die gehen: aus ihrem Inhalt, solange er noch da ist.
        weg_mods = {m for x in alt_ids if x not in ids for m in self.mod_ids(x)}
        neu_mods = []
        for x in ids:
            if not self.mod_ids(x):
                self.vorab_laden(x)
            gefunden = self.mod_ids(x)
            if not gefunden:
                fehler(f"{x}: kein mod.info im Inhalt - ist das ein Mod fuer Build 42?")
            neu_mods += [m for m in gefunden if m not in neu_mods]
        # Von Hand eingetragene Mods (keinem Workshop-Eintrag zugeordnet) bleiben.
        verwaltet = weg_mods | set(neu_mods)
        vorhanden = [m for m in lese_ini(text, "Mods").split(";") if m]
        hand = [m for m in vorhanden if m not in verwaltet]
        text = setze_ini(text, "WorkshopItems", ";".join(ids))
        text = setze_ini(text, "Mods", ";".join(hand + neu_mods))
        vorher = p.stat()
        p.write_text(text)
        os.chown(p, vorher.st_uid, vorher.st_gid)
        self.aufraeumen(ids)


def unturned_ids(text: str) -> list:
    """File_IDs aus WorkshopDownloadConfig.json als Zeichenketten. Rein."""
    try:
        d = json.loads(text.lstrip("\ufeff"))
    except ValueError:
        fehler("WorkshopDownloadConfig.json ist kein gueltiges JSON")
    ids = d.get("File_IDs") if isinstance(d, dict) else None
    if not isinstance(ids, list):
        fehler("WorkshopDownloadConfig.json hat kein Feld File_IDs")
    return [str(x) for x in ids]


def unturned_setzen(text: str, ids: list) -> str:
    """File_IDs auf ids setzen; alle anderen Felder bleiben, wie sie sind. Rein.

    Was in File_IDs nicht nach Workshop-ID aussieht, hat jemand von Hand
    eingetragen - es bleibt im Originalwert stehen, statt beim Speichern still
    zu verschwinden.
    *Entries that do not look like a Workshop id stay untouched.*"""
    unturned_ids(text)                     # bricht bei kaputter Datei ab
    d = json.loads(text.lstrip("\ufeff"))
    hand = [x for x in d["File_IDs"] if not ID_MUSTER.fullmatch(str(x))]
    d["File_IDs"] = hand + [int(x) for x in ids]
    return json.dumps(d, indent=2, ensure_ascii=False) + "\n"


@art("unturned")
class Unturned(Anpassung):
    """Unturned: Feld File_IDs in Servers/<Name>/WorkshopDownloadConfig.json.

    Der Server laedt beim Start jede eingetragene ID selbst herunter und
    installiert sie (Log: "1 workshop item(s) requested ... Successfully
    downloaded workshop item ... Installed workshop item"), nach
    Servers/<Name>/Workshop/Steam/content/304930/<id>. Kein Vorabladen noetig:
    Anders als bei Project Zomboid gibt es keine zweite Liste, die den Inhalt
    kennen muesste. Der Name ist "Default", weil das ich777-Startskript keinen
    uebergibt (gemessen am 2026-09-11). Karten aus dem Workshop laedt der Server
    so auch - SPIELEN muss man sie ueber "Map" in Config.txt, das bleibt Handarbeit.
    *The server downloads and installs every listed id itself at start; no
    pre-fetch, no second list. Workshop maps load too but must be selected in
    Config.txt by hand.*
    """

    def liste(self) -> list:
        return [x for x in unturned_ids(self.datei().read_text(errors="replace"))
                if ID_MUSTER.fullmatch(x)]

    def setzen(self, ids: list):
        p = self.datei()
        text = p.read_text(errors="replace")
        vorher = p.stat()
        p.write_text(unturned_setzen(text, ids))
        os.chown(p, vorher.st_uid, vorher.st_gid)
        self.aufraeumen(ids)


# Don't Starve Together: zwei Lua-Dateien.
SETUP_ZEILE = re.compile(r'^[ \t]*ServerModSetup\(\s*"([0-9]{3,12})"\s*\)[ \t]*\r?\n?', re.M)


def dst_setup_ids(text: str) -> list:
    """IDs aus ServerModSetup("...")-Zeilen - auskommentierte (--) nicht. Rein."""
    return [m.group(1) for m in SETUP_ZEILE.finditer(text)]


def dst_setup_setzen(text: str, ids: list) -> str:
    """ServerModSetup-Zeilen auf ids setzen; Kommentare, ServerModCollectionSetup
    und alles andere bleiben. Rein."""
    text = SETUP_ZEILE.sub("", text)
    if text and not text.endswith("\n"):
        text += "\n"
    return text + "".join(f'ServerModSetup("{x}")\n' for x in ids)


def lua_blockende(text: str, auf: int) -> int:
    """Index hinter der "}", die die "{" bei auf schliesst - Zeichenketten und
    Kommentare werden uebersprungen. -1, wenn sie nicht schliesst. Rein.
    *Index past the brace closing the one at auf, skipping strings and comments.*"""
    tiefe, i, n = 0, auf, len(text)
    while i < n:
        c = text[i]
        if text.startswith("--[[", i):
            j = text.find("]]", i + 4); i = n if j < 0 else j + 2; continue
        if text.startswith("--", i):
            j = text.find("\n", i); i = n if j < 0 else j + 1; continue
        if text.startswith("[[", i):
            j = text.find("]]", i + 2); i = n if j < 0 else j + 2; continue
        if c in "\"'":
            i += 1
            while i < n and text[i] != c:
                i += 2 if text[i] == "\\" else 1
            i += 1; continue
        if c == "{":
            tiefe += 1
        elif c == "}":
            tiefe -= 1
            if tiefe == 0:
                return i + 1
        i += 1
    return -1


def dst_eintrag(text: str, wid: str):
    """(anfang, ende) des Eintrags ["workshop-<id>"]={...} samt Komma, sonst None."""
    m = re.search(rf'\[\s*["\']workshop-{wid}["\']\s*\]\s*=\s*\{{', text)
    if not m:
        return None
    ende = lua_blockende(text, m.end() - 1)
    if ende < 0:
        fehler(f"modoverrides.lua: Eintrag workshop-{wid} schliesst nicht")
    k = re.match(r"[ \t]*,?[ \t]*\r?\n?", text[ende:])
    anfang = text.rfind("\n", 0, m.start()) + 1
    if text[anfang:m.start()].strip():
        anfang = m.start()                 # steht nicht allein auf der Zeile
    return anfang, ende + k.end()


def dst_overrides_setzen(text: str, ids: list, weg: list) -> str:
    """modoverrides.lua: fehlende ids als aktiviert eintragen, ids aus weg
    entfernen - nur diese. Vorhandene Eintraege behalten ihre Einstellungen
    (configuration_options), werden aber aktiviert. Rein.
    *Add missing ids enabled, remove only the ids in weg; existing entries keep
     their configuration_options but are enabled.*"""
    if not text.strip():
        text = "return {\n}\n"
    for x in weg:
        spanne = dst_eintrag(text, x)
        if spanne:
            text = text[:spanne[0]] + text[spanne[1]:]
    kopf = re.search(r"^\s*return\s*\{", text, re.M)
    if not kopf:
        fehler("modoverrides.lua beginnt nicht mit \"return {\" - bitte von Hand pruefen")
    for x in ids:
        spanne = dst_eintrag(text, x)
        if spanne:
            block = text[spanne[0]:spanne[1]]
            text = text[:spanne[0]] + re.sub(r"enabled\s*=\s*false", "enabled=true", block) + text[spanne[1]:]
        else:
            neu = f'\n  ["workshop-{x}"]={{ configuration_options={{ }}, enabled=true }},'
            text = text[:kopf.end()] + neu + text[kopf.end():]
    return text


@art("dst")
class Dst(Anpassung):
    """Don't Starve Together: ZWEI Dateien, wie bei Project Zomboid.

    serverfiles/mods/dedicated_server_mods_setup.lua sagt mit ServerModSetup("<id>"),
    was der Server beim Start herunterlaedt; modoverrides.lua in jedem Shard
    (Cluster_1/Master, Cluster_1/Caves) sagt mit ["workshop-<id>"]={ enabled=true },
    was er davon laedt. Anders als bei Zomboid steht der Name im Eintrag schon in
    der ID - kein Vorabladen noetig. Gemessen am 2026-09-11: Der Server laedt und
    aktiviert die Mod schon VOR der Anmeldung bei Klei ("Loading mod:
    workshop-378160973 (Global Positions)"), nach
    serverfiles/ugc_mods/Cluster_1/<Shard>/content/322330/<id>.
    *Two files like Zomboid: the setup file says what to download, each shard's
     modoverrides.lua what to enable. The id is the name, so no pre-fetch.*
    """

    def shards(self) -> list:
        """modoverrides.lua der Shards, die es gibt - mindestens Master."""
        raus = []
        for rel in self.w["overrides"]:
            p = (self.basis / rel).resolve()
            if not str(p).startswith(str(self.basis.resolve()) + "/"):
                fehler("Konfigurationspfad liegt ausserhalb des Datenverzeichnisses")
            if p.parent.is_dir():
                raus.append(p)
        if not raus:
            fehler("Der Cluster (Cluster_1/Master) ist noch nicht angelegt - der Server legt ihn "
                   "beim ersten Start an. Danach erneut versuchen.", code=4)
        return raus

    def liste(self) -> list:
        return dst_setup_ids(self.datei().read_text(errors="replace"))

    def setzen(self, ids: list):
        p = self.datei()
        shards = self.shards()
        alt_ids = self.liste()
        weg = [x for x in alt_ids if x not in ids]
        besitzer = p.stat()
        for o in shards:
            text = o.read_text(errors="replace") if o.is_file() else ""
            o.write_text(dst_overrides_setzen(text, ids, weg))
            os.chown(o, besitzer.st_uid, besitzer.st_gid)
        p.write_text(dst_setup_setzen(p.read_text(errors="replace"), ids))
        os.chown(p, besitzer.st_uid, besitzer.st_gid)
        self.aufraeumen(ids)


# --- Befehle --------------------------------------------------------------------

def zeile(d: dict) -> str:
    return "\t".join([d.get("publishedfileid", ""), (d.get("title") or "").replace("\t", " ")[:120],
                      str(d.get("file_size") or 0), str(d.get("time_updated") or 0)])


def main(a: list) -> int:
    if not a:
        print(__doc__.split("==")[0].strip())
        return 1
    befehl = a[0]
    if befehl == "--selbsttest":
        return selbsttest()
    if len(a) < 2:
        fehler("Stack fehlt")
    stack = a[1]
    g, w = spiel_von(stack)
    appid = int(g["appid"])
    if befehl == "kann":
        print(f"ok\t{g['name']}\tsuche={'ja' if schluessel() else 'nein'}")
        return 0
    anp = anpassung(stack, w)
    if befehl == "liste":
        ids = anp.liste()
        info = details(ids) if ids else {}
        for x in ids:
            print(zeile(info.get(x) or {"publishedfileid": x, "title": "(bei Steam nicht gefunden)"}))
        return 0
    if befehl == "pruefen" and len(a) == 3:
        ids = ids_aus(a[2])
        if not ids:
            fehler("keine Workshop-ID oder kein Link erkannt")
        kinder = sammlung(ids[0])
        ids = kinder or ids
        info = details(ids)
        for x in ids:
            grund = urteil(info.get(x), appid)
            print(zeile(info.get(x) or {"publishedfileid": x}) + "\t" + (grund or "ok"))
        return 0
    if befehl == "suche" and len(a) in (3, 4):
        text = a[2]
        if not re.fullmatch(r"[\w .'-]{1,60}", text):
            fehler("unzulaessiger Suchtext")
        seite = int(a[3]) if len(a) == 4 and a[3].isdigit() else 1
        for d in suchen(appid, text, seite):
            print(zeile(d) + "\t" + (urteil(d, appid) or "ok"))
        return 0
    if befehl in ("hinzu", "weg") and len(a) == 3:
        x = a[2]
        if not ID_MUSTER.fullmatch(x):
            fehler("unzulaessige ID")
        ids = anp.liste()
        if befehl == "hinzu":
            grund = urteil(details([x]).get(x), appid)
            if grund:
                fehler(f"{x}: {grund}")
            if x in ids:
                print(f"ok\t{x} ist schon eingetragen")
                return 0
            anp.setzen(ids + [x])
            print(f"ok\t{x} eingetragen - wirkt beim naechsten Start des Servers")
        else:
            if x not in ids:
                print(f"ok\t{x} war nicht eingetragen")
                return 0
            anp.setzen([i for i in ids if i != x])
            print(f"ok\t{x} ausgetragen - wirkt beim naechsten Start des Servers")
        return 0
    fehler("Aufruf: workshop kann|liste <stack> | pruefen <stack> <eingabe> | "
           "suche <stack> <text> [seite] | hinzu|weg <stack> <id>")


def selbsttest() -> int:
    schlecht = 0
    faelle = [
        ("https://steamcommunity.com/sharedfiles/filedetails/?id=2392709985", ["2392709985"]),
        ("https://steamcommunity.com/workshop/filedetails/?id=123456&searchtext=", ["123456"]),
        ("2392709985", ["2392709985"]),
        ("  2392709985 ", ["2392709985"]),
        ("2392709985; rm -rf /", []),
        ("abc", []),
    ]
    for eingabe, soll in faelle:
        ist = ids_aus(eingabe)
        ok = ist == soll
        schlecht += not ok
        print(f"  {'ok  ' if ok else 'FEHLER'} ids_aus({eingabe!r}) = {ist}")
    for d, soll in [({"result": 1, "consumer_app_id": 108600, "file_size": 10}, ""),
                    ({"result": 1, "consumer_app_id": 4000, "file_size": 10}, "anderen Spiel"),
                    ({"result": 9}, "nicht gefunden"),
                    ({"result": 1, "consumer_app_id": 108600, "banned": True}, "gesperrt"),
                    ({"result": 1, "consumer_app_id": 108600, "file_size": MAX_BYTES + 1}, "groesser"),
                    # So antwortet die Suche (QueryFiles) - anderer Feldname:
                    ({"result": 1, "consumer_appid": 108600, "file_size": "10"}, ""),
                    ({"result": 1, "consumer_appid": 4000, "file_size": "10"}, "anderen Spiel")]:
        ist = urteil(d, 108600)
        ok = (soll == "" and ist == "") or (soll and soll in ist)
        schlecht += not ok
        print(f"  {'ok  ' if ok else 'FEHLER'} urteil({d}) = {ist or 'ok'}")
    vorlage = ('\ufeff{\n  "File_IDs": [],\n  "Ignore_Children_File_IDs": [],\n'
               '  "Should_Monitor_Updates": true\n}')
    neu = unturned_setzen(vorlage, ["3485061773", "3692068824"])
    for name, ok in [
        ("unturned_ids(leer)", unturned_ids(vorlage) == []),
        ("unturned_setzen -> Zahlen", '"File_IDs": [\n    3485061773,\n    3692068824\n  ]' in neu),
        ("unturned_setzen laesst Felder stehen", json.loads(neu)["Should_Monitor_Updates"] is True
         and json.loads(neu)["Ignore_Children_File_IDs"] == []),
        ("unturned_ids(gesetzt)", unturned_ids(neu) == ["3485061773", "3692068824"]),
        ("Handeintrag bleibt", json.loads(unturned_setzen('{"File_IDs": ["notiz", 3485061773]}',
                                                          []))["File_IDs"] == ["notiz"]),
    ]:
        schlecht += not ok
        print(f"  {'ok  ' if ok else 'FEHLER'} {name}")
    setup = ('--ServerModSetup("350811795")\nServerModCollectionSetup("379114180")\n'
             'ServerModSetup("378160973")\n')
    ov = ('return {\n  ["workshop-378160973"]={ configuration_options={ SHOWPLAYERS="}", x={1,2} },'
          ' enabled=true },\n  -- ["workshop-999"]={ enabled=true },\n'
          '  ["workshop-111111"]={ enabled=false },\n}\n')
    neu_ov = dst_overrides_setzen(ov, ["111111", "376333686"], ["378160973"])
    for name, ok in [
        ("dst_setup_ids ohne Kommentar", dst_setup_ids(setup) == ["378160973"]),
        ("dst_setup_setzen laesst Kommentar und Sammlung",
         dst_setup_setzen(setup, ["1", "376333686"]) == '--ServerModSetup("350811795")\n'
         'ServerModCollectionSetup("379114180")\nServerModSetup("1")\nServerModSetup("376333686")\n'),
        ("lua_blockende ueberspringt } in Zeichenkette", lua_blockende('{ a="}", b={1} } x', 0) == 16),
        ("lua_blockende: Kommentar, Langstring, Maskierung, offen",
         [lua_blockende(s, 0) for s in ('{ -- }\n }', '{ [[ } ]] }', '{ "a\\"}" }', '{ {')] == [9, 11, 10, -1]),
        ("modoverrides: ausgetragen samt Optionen", "378160973" not in neu_ov and "SHOWPLAYERS" not in neu_ov),
        ("modoverrides: Kommentar bleibt", '-- ["workshop-999"]' in neu_ov),
        ("modoverrides: vorhandener aktiviert", '["workshop-111111"]={ enabled=true }' in neu_ov),
        ("modoverrides: neuer eingetragen", '["workshop-376333686"]={ configuration_options={ }, enabled=true }' in neu_ov),
        ("modoverrides: leer -> angelegt", dst_overrides_setzen("", ["5"], []) ==
         'return {\n  ["workshop-5"]={ configuration_options={ }, enabled=true },\n}\n'),
    ]:
        schlecht += not ok
        print(f"  {'ok  ' if ok else 'FEHLER'} {name}")
    print("alles gruen." if not schlecht else f"{schlecht} FEHLER")
    return 1 if schlecht else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
